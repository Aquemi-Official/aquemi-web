/* ---------- HmiTrend: alarm lines shown as the operator panel's own screen (look "hmi-trend") ---------- */
/* The screen carries data-theme="dark", so inside it every token is the dark theme's in both page themes: a deep
   instrument panel where status colours read at full strength. Bezel (surface-sunken) > panes (surface) with line
   hairlines. One shape per line, always with its name: limit diamond (fail), action triangle (fail), alert square
   (caution), trend arrow (flow). Plot geometry is an svg stretched to its box (non-scaling strokes); labels, flag
   and the live dot are HTML at the percentages the renderer wrote. */
.aq-hmi-trend { background: var(--surface-sunken); color: var(--ink); border: 1px solid var(--line); padding: var(--space-2); font: 400 15px/22px var(--font-sans); }
.aq-hmi-trend__screen { background: var(--surface); border: 1px solid var(--line); }
.aq-hmi-trend__pri { display: inline-block; flex: none; width: 10px; height: 10px; vertical-align: middle; }
.aq-hmi-trend__pri--limit { background: var(--fail); clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
.aq-hmi-trend__pri--action { background: var(--fail); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
.aq-hmi-trend__pri--alert { background: var(--caution); }
.aq-hmi-trend__pri--trend { background: var(--flow); clip-path: polygon(0 100%, 0 70%, 55% 30%, 40% 15%, 100% 0, 85% 60%, 70% 45%, 15% 100%); }

/* chrome: tabs, the newest alarm, the lamp cluster */
.aq-hmi-trend__bar { display: flex; align-items: stretch; gap: var(--space-4); border-bottom: 1px solid var(--line); background: var(--surface-raised); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-hmi-trend__tabs { display: flex; }
.aq-hmi-trend__tab { padding: var(--space-3) var(--space-4); color: var(--ink-subtle); border-right: 1px solid var(--line); }
.aq-hmi-trend__tab.is-on { color: var(--ink); background: var(--surface); box-shadow: inset 0 2px 0 var(--flow); }
.aq-hmi-trend__banner { display: flex; align-items: center; gap: var(--space-3); min-width: 0; flex: 1; padding: 0 var(--space-3); color: var(--ink); }
.aq-hmi-trend__bt { color: var(--ink-muted); text-transform: none; letter-spacing: 0; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aq-hmi-trend__lamps { display: flex; align-items: center; gap: var(--space-2); padding: 0 var(--space-4); border-left: 1px solid var(--line); }

/* the plot */
.aq-hmi-trend__plot { position: relative; height: calc(var(--space-32) * 2.4); margin: var(--space-6) calc(var(--space-32) * 1.4) var(--space-12) var(--space-6); border-left: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
.aq-hmi-trend__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.aq-hmi-trend__svg * { vector-effect: non-scaling-stroke; }
.aq-hmi-trend__grid { fill: none; stroke: var(--line); stroke-width: 1; }
.aq-hmi-trend__zone { fill: color-mix(in srgb, var(--fail) 10%, transparent); }
.aq-hmi-trend__lim { fill: none; stroke-width: 1.5; }
.aq-hmi-trend__lim--limit { stroke: var(--fail); }
.aq-hmi-trend__lim--action { stroke: var(--fail); stroke-dasharray: 10 5; }
.aq-hmi-trend__lim--alert { stroke: var(--caution); stroke-dasharray: 4 4; }
.aq-hmi-trend__win { fill: color-mix(in srgb, var(--flow) 9%, transparent); }
.aq-hmi-trend__fit { fill: none; stroke: var(--flow); stroke-width: 1; stroke-dasharray: 2 4; }
.aq-hmi-trend__mark { fill: none; stroke: var(--flow); stroke-width: 1; }
.aq-hmi-trend__trace { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
.aq-hmi-trend__now { fill: none; stroke: var(--ink-subtle); stroke-width: 1; stroke-dasharray: 2 3; }
.aq-hmi-trend__dot { position: absolute; width: 10px; height: 10px; transform: translate(-50%, -50%); border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ink) 18%, transparent); }
.aq-hmi-trend__ll { position: absolute; left: 100%; display: flex; align-items: center; gap: var(--space-2); padding-left: var(--space-3); transform: translateY(-50%); white-space: nowrap; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-hmi-trend__flag { position: absolute; top: 0; display: flex; align-items: center; gap: var(--space-2); transform: translate(-50%, calc(-100% - var(--space-1))); padding: var(--space-1) var(--space-2); background: var(--surface-raised); border: 1px solid var(--flow); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); white-space: nowrap; }
.aq-hmi-trend__ax { position: absolute; left: 0; right: 0; top: 100%; display: flex; justify-content: space-between; }
.aq-hmi-trend__ax span { width: 1px; height: var(--space-2); background: var(--line-strong); }
.aq-hmi-trend__lim, .aq-hmi-trend__ll { transition: opacity 200ms ease, color 200ms ease; }
.aq-hmi-trend.has-hot .aq-hmi-trend__lim:not(.is-hot), .aq-hmi-trend.has-hot .aq-hmi-trend__ll:not(.is-hot), .aq-hmi-trend.has-hot .aq-hmi-trend__rule:not(.is-hot) { opacity: 0.3; }
.aq-hmi-trend__ll.is-hot { color: var(--ink); }

/* the alarm summary: the real table */
.aq-hmi-trend__table { width: 100%; border-collapse: collapse; border-top: 1px solid var(--line); }
.aq-hmi-trend__table thead th { padding: var(--space-3) var(--space-4); text-align: left; background: var(--surface-raised); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); border-bottom: 1px solid var(--line); }
.aq-hmi-trend__table tbody th, .aq-hmi-trend__table td { padding: var(--space-4); text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
.aq-hmi-trend__table tbody tr:last-child > * { border-bottom: 0; }
.aq-hmi-trend__table tbody th { width: 22%; font-weight: 500; color: var(--ink); white-space: nowrap; }
.aq-hmi-trend__table tbody th > span { margin-left: var(--space-3); }
.aq-hmi-trend__table td:last-child { color: var(--ink); width: 34%; }
.aq-hmi-trend__table a { color: var(--flow); }
.aq-hmi-trend__row { transition: background-color 200ms ease; box-shadow: inset 3px 0 0 transparent; }
.aq-hmi-trend__row.is-hot { background: var(--surface-raised); }
.aq-hmi-trend__row--limit.is-hot, .aq-hmi-trend__row--action.is-hot { box-shadow: inset 3px 0 0 var(--fail); }
.aq-hmi-trend__row--alert.is-hot { box-shadow: inset 3px 0 0 var(--caution); }
.aq-hmi-trend__row--trend.is-hot, .aq-hmi-trend__row.is-flag { box-shadow: inset 3px 0 0 var(--flow); background: color-mix(in srgb, var(--flow) 12%, var(--surface)); }
.aq-hmi-trend__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

@container (max-width: 860px) {
  .aq-hmi-trend { padding: var(--space-1); }
  .aq-hmi-trend__tab:not(.is-on), .aq-hmi-trend__lamps, .aq-hmi-trend__bt { display: none; }
  .aq-hmi-trend__plot { height: calc(var(--space-32) * 1.5); margin: var(--space-12) var(--space-4) var(--space-8); }
  .aq-hmi-trend__ll { left: auto; right: 0; transform: translateY(calc(-100% - var(--space-1))); padding: 0; background: var(--surface); }
  .aq-hmi-trend__flag { transform: translate(-60%, calc(-100% - var(--space-1))); }
  .aq-hmi-trend__table thead { display: none; }
  .aq-hmi-trend__table, .aq-hmi-trend__table tbody, .aq-hmi-trend__table tr, .aq-hmi-trend__table th, .aq-hmi-trend__table td { display: block; width: auto; }
  .aq-hmi-trend__row { padding: var(--space-4); border-bottom: 1px solid var(--line); }
  .aq-hmi-trend__table tbody th, .aq-hmi-trend__table td { padding: 0; border: 0; white-space: normal; width: auto; }
  .aq-hmi-trend__table td { margin-top: var(--space-2); font-size: 14px; }
  .aq-hmi-trend__k { position: static; width: auto; height: auto; clip-path: none; display: block; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); }
}
@container (max-width: 860px) {
  .aq-hmi-trend__table td:last-child, .aq-hmi-trend__table tbody th { width: auto; }
}
.aq-hmi-trend-sec { position: relative; }
.aq-hmi-trend__run { pointer-events: none; }

/* Phosphor (pass 9b): FxPhosphor glows under the reading inside the plot (its own stacking context, so the canvas sits
   under the grid and lines; no overflow clip, the line labels hang outside the plot). Flow at about a third at the
   trace, fading within a few pixels; the vignette darkens the plot's corners slightly. */
.aq-hmi-trend__plot { isolation: isolate; }
.aq-hmi-trend__plot > .aq-fx-shader { --fx-amt: 0.85; }
