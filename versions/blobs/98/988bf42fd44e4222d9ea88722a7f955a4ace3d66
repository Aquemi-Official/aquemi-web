/* ---------- Footer ---------- */
.aq-footer { background: var(--navy); color: var(--on-navy-muted); padding-block: var(--space-16) var(--space-8); }
.aq-footer__cols { display: grid; grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(0, 1fr)); gap: var(--space-8); }
.aq-footer h5 { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--limestone); margin: 0 0 var(--space-3); }
.aq-footer a { display: block; color: var(--on-navy-muted); text-decoration: none; font-size: 14px; line-height: 20px; padding-block: var(--space-1); }
.aq-footer a:hover { color: var(--on-navy); text-decoration: underline; }
.aq-footer .aq-small { color: var(--on-navy-muted); }
.aq-footer__logo { width: 160px; height: auto; display: block; }
.aq-footer__legal { margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--line-strong); font: 400 13px/20px var(--font-sans); display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }

@container (max-width: 860px) {
  .aq-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
