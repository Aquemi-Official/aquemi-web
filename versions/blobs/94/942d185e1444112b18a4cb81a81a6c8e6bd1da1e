/* ---------- OptionTaps: options as dashed parts on dashed tees off the standard train, one limestone drawing sheet ---------- */
/* The sheet: a navy hairline frame, the heading at display scale over the drawing, the notes in a narrow column right of
   a vertical rule, the title block at its foot. */
.aq-option-taps { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); border: 1px solid var(--on-limestone); outline: 1px solid var(--on-limestone); outline-offset: var(--space-2); margin: var(--space-2); }
.aq-option-taps__main { display: flex; flex-direction: column; gap: var(--space-6); padding: var(--space-12) var(--space-8) var(--space-8); min-width: 0; }
.aq-option-taps__main .aq-sec-head .aq-eyebrow { color: var(--on-limestone-muted); }
.aq-option-taps__main .aq-sec-head .aq-h1 { font: 300 120px/112px var(--font-sans); letter-spacing: -0.045em; color: var(--on-limestone); max-width: none; }
.aq-option-taps__side { display: flex; flex-direction: column; border-left: 1px solid var(--on-limestone); min-width: 0; }

/* the drawing: a camera that frames one part when a note is chosen */
.aq-option-taps__fig { position: relative; overflow: hidden; margin-top: auto; }
.aq-option-taps__cam { position: relative; transform-origin: 0 0; transition: transform 600ms cubic-bezier(0.2, 0, 0, 1); }
.aq-option-taps__svg { display: block; width: 100%; height: auto; }
/* optional: every line of the part and its tee dashed; lit (note hovered or chosen) in flow */
.aq-option-taps__svg .aq-option-taps__ghost .aq-iso__eq, .aq-option-taps__svg .aq-option-taps__ghost .aq-iso__ln, .aq-option-taps__svg .aq-option-taps__ghost .aq-iso__thin,
.aq-option-taps__svg .aq-option-taps__tee .aq-iso__pipe-wall { stroke-dasharray: 4 3; }
.aq-option-taps__svg .aq-option-taps__ghost .aq-iso__acc, .aq-option-taps__svg .aq-option-taps__ghost .aq-iso__trace { stroke-dasharray: 2 3; }
.aq-option-taps__svg [data-iso-id] { transition: opacity 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-option-taps.is-focus .aq-option-taps__svg [data-iso-id]:not(.is-lit) { opacity: 0.35; }
.aq-option-taps__label, .aq-option-taps__mark { position: absolute; transform: translate(-50%, -100%); white-space: nowrap; pointer-events: none; }
.aq-option-taps__label { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-option-taps__mark { display: grid; place-items: center; min-width: var(--space-8); height: var(--space-8); padding: 0 var(--space-1);
  border: 1px solid var(--on-limestone); background: var(--limestone); font: 500 13px/1 var(--font-mono); color: var(--on-limestone); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-option-taps__mark.is-on { background: var(--navy); color: var(--on-navy); border-color: var(--navy); }

/* Notes: numbered like the pins, hairlines between */
.aq-option-taps__side .aq-fold { flex: 1; }
.aq-option-taps__cards { list-style: none; margin: 0; padding: var(--space-8) 0 0; display: flex; flex-direction: column; }
.aq-option-taps__card { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4) var(--space-6); border-bottom: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); color: var(--on-limestone); }
.aq-option-taps__no { margin: 0; }
.aq-option-taps__pin { display: inline-grid; place-items: center; min-width: var(--space-12); min-height: var(--space-12); margin: calc(-1 * var(--space-2)) 0 0 calc(-1 * var(--space-2)); padding: 0;
  border: 0; background: transparent; color: var(--on-limestone); font: 400 15px/1 var(--font-mono); cursor: pointer; }
.aq-option-taps__pin::before { content: ""; position: absolute; width: var(--space-8); height: var(--space-8); border: 1px solid var(--on-limestone); box-sizing: border-box; transition: background-color 150ms cubic-bezier(0.2, 0, 0, 1); z-index: -1; }
.aq-option-taps__pin { position: relative; z-index: 0; }
.aq-option-taps__pin:hover::before { background: color-mix(in srgb, var(--on-limestone) 10%, transparent); }
.aq-option-taps__pin[aria-pressed="true"] { color: var(--on-navy); }
.aq-option-taps__pin[aria-pressed="true"]::before { background: var(--navy); border-color: var(--navy); }
.aq-option-taps__pin:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-option-taps__t { margin: 0; font: 400 17px/23px var(--font-sans); }
.aq-option-taps__d { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--on-limestone-muted); }
.aq-option-taps__card.is-on .aq-option-taps__t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
.aq-option-taps__mini { display: none; }
.aq-fold:not(.is-open) .aq-option-taps__card.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-option-taps__cards) > .aq-fold__btn { display: none; }

/* title block */
.aq-option-taps__block { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: auto; border-top: 1px solid var(--on-limestone); }
.aq-option-taps__block span { padding: var(--space-2) var(--space-4); border-top: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-option-taps__block span:first-child { border-top: 0; color: var(--on-limestone); }

@container (max-width: 1100px) {
  .aq-option-taps__main .aq-sec-head .aq-h1 { font-size: 88px; line-height: 88px; }
  .aq-option-taps__label { display: none; }
  .aq-option-taps__card { padding: var(--space-3) var(--space-4); }
}
@container (max-width: 860px) {
  .aq-option-taps { grid-template-columns: minmax(0, 1fr); margin: var(--space-1); outline-offset: var(--space-1); }
  .aq-option-taps__main { padding: var(--space-8) var(--space-4) var(--space-4); }
  .aq-option-taps__main .aq-sec-head .aq-h1 { font-size: 56px; line-height: 56px; }
  .aq-option-taps__side { border-left: 0; border-top: 1px solid var(--on-limestone); }
  .aq-option-taps__label { display: none; }
  /* the pins stay on the small drawing (they pair each dashed part with its note), at a phone size */
  .aq-option-taps__mark { min-width: var(--space-6); height: var(--space-6); font-size: 12px; }
  .aq-option-taps__fig { padding-top: var(--space-6); }
  .aq-option-taps__cards { padding-top: var(--space-2); }
  .aq-option-taps__card { display: grid; grid-template-columns: 72px minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-1); align-items: start; padding: var(--space-4); }
  .aq-option-taps__no { grid-column: 1 / -1; }
  .aq-option-taps__mini { display: block; grid-row: 2 / 4; width: 72px; height: auto; background: transparent; }
  .aq-fold:not(.is-open) .aq-option-taps__card.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-option-taps__cards) > .aq-fold__btn { display: flex; }
}
@media (prefers-reduced-motion: reduce) {
  .aq-option-taps__cam, .aq-option-taps__svg [data-iso-id] { transition: none; }
}
