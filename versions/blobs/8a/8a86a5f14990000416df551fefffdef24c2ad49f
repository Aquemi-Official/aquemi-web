.aq-menu__list a:focus-visible { outline-offset: -2px; }
.aq-menu__jump { display: grid; }
.aq-menu__label {
  padding: var(--space-4) var(--space-2) var(--space-2); border-top: 1px solid var(--line-strong);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-menu__cta { display: flex; }
.aq-menu__cta .aq-btn { flex: 1; justify-content: center; }

@media (prefers-reduced-motion: reduce) {
  .aq-nav__links a, .aq-nav__frame { transition: none; }
}

/* Mid widths: tighten the cells before the phone layout takes over */
@container (max-width: 1080px) {
  .aq-nav { gap: var(--space-4); padding: 0 var(--space-6); }
  .aq-nav__home { padding-right: var(--space-4); }
  .aq-nav .aq-nav__logo--lockup { width: 140px; }
  .aq-nav__links a { padding: 0 var(--space-3); }
  .aq-nav__frame .aq-btn { padding: 0 var(--space-4); }
}

@container (max-width: 860px) {
  .aq-nav { padding: 0 var(--space-4); gap: var(--space-4); }
  .aq-nav__home { padding-right: 0; border-right: 0; }
  .aq-nav__links, .aq-nav > .aq-nav__frame { display: none; }
  .aq-nav__spacer { flex: 1; }
  .aq-nav__toggle { display: inline-flex; }
  .aq-nav .aq-nav__logo--lockup { width: 112px; }
  .aq-menu {
    display: grid; gap: var(--space-4); padding: var(--space-2) var(--space-4) var(--space-6);
    background: var(--surface); border-bottom: 1px solid var(--line);
  }
}

/* ---------- SectionNav ---------- */
/* Like the revision bar of a drawing set: label cell, numbered jump links (the one being read is boxed), page progress cell. */
.aq-section-nav { position: sticky; top: 0; z-index: 5; background: var(--surface); border-bottom: 1px solid var(--line); }
.aq-section-nav .aq-in { display: flex; align-items: stretch; min-height: 56px; }
.aq-section-nav__label {
  display: flex; align-items: center; gap: var(--space-1); flex: none;
  padding-right: var(--space-4); border-right: 1px solid var(--line);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); white-space: nowrap;
}
.aq-section-nav__links {
  display: flex; align-items: center; gap: var(--space-1); flex: 1; min-width: 0;
  margin: 0; padding: 0 var(--space-3); list-style: none;
  overflow-x: auto; scrollbar-width: none; white-space: nowrap;
}
.aq-section-nav__links::-webkit-scrollbar { display: none; }
.aq-section-nav__links li { flex: none; }
.aq-section-nav__links a {
  display: inline-flex; align-items: baseline; gap: var(--space-2);
  padding: var(--space-1) var(--space-3); border: 1px solid transparent;
  font: 500 14px/20px var(--font-sans); color: var(--ink-muted); text-decoration: none;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-section-nav__num { font: 500 11px/12px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-subtle); font-variant-numeric: tabular-nums; }
.aq-section-nav__links a:hover { color: var(--ink); border-color: var(--line); }
.aq-section-nav__links a[aria-current="true"] { color: var(--ink); background: var(--surface-sunken); border-color: var(--flow); }
.aq-section-nav__links a[aria-current="true"] .aq-section-nav__num { color: var(--flow); }
.aq-section-nav__links a:focus-visible { outline-offset: 0; }

/* Page progress: ten segments and a percentage, updated on scroll */
.aq-section-nav__progress {
  display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: var(--space-1); flex: none;
  padding-left: var(--space-4); border-left: 1px solid var(--line);
  font: 500 11px/12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-section-nav__readout { display: flex; align-items: center; gap: var(--space-2); }
.aq-section-nav__meter { display: inline-flex; gap: calc(var(--space-1) / 2); padding: calc(var(--space-1) / 2); border: 1px solid var(--line-strong); }
.aq-section-nav__seg { display: block; width: calc(var(--space-1) + var(--space-1) / 2); height: var(--space-2); background: var(--line); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-section-nav__seg.is-on { background: var(--flow); }
.aq-section-nav__pct { min-width: 4ch; text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; }

/* Jumped-to sections clear the sticky bar (56 px desktop, 52 px phones) with room above the heading */
.aq-page:has(.aq-section-nav) section[id] { scroll-margin-top: var(--space-16); }

@media (prefers-reduced-motion: reduce) {
  .aq-section-nav__links a, .aq-section-nav__seg { transition: none; }
}

@container (max-width: 860px) {
  .aq-section-nav .aq-in { min-height: 52px; padding-inline: 0; }
  .aq-section-nav__label, .aq-section-nav__progress-label, .aq-section-nav__meter { display: none; }
  .aq-section-nav__links { padding: 0 var(--space-2); }
  /* Tap targets at least 44 px tall */
  .aq-section-nav__links a { align-items: center; min-height: 44px; padding-inline: var(--space-3); }
  .aq-section-nav__progress { padding-inline: var(--space-3) var(--space-4); }
}

/* ---------- Band ---------- */
/* Ground modifiers: change the section ground for one section. Used on their own by StandardsGrid and DocList (sunken)
   and Closing (navy), and together with .aq-band for the statement band. */
.aq-band--sunken { background: var(--surface-sunken); }
.aq-band--limestone { background: var(--limestone); color: var(--on-limestone); }
.aq-band--limestone .aq-lead, .aq-band--limestone .aq-small { color: var(--on-limestone-muted); }
.aq-band--navy { background: var(--navy); color: var(--on-navy); position: relative; overflow: hidden; }
.aq-band--navy .aq-lead, .aq-band--navy .aq-small { color: var(--on-navy-muted); }
.aq-band--navy .aq-btn--primary { background: var(--limestone); color: var(--navy); }
.aq-band--navy .aq-btn--primary:hover { background: var(--on-navy); }
.aq-band--navy .aq-arc__outer { stroke: var(--on-navy-muted); opacity: 0.5; }
.aq-band--navy .aq-arc__inner { stroke: var(--limestone); }

/* ---------- Statement band: one sentence set very large in a framed panel ---------- */
/* The frame has a plain strip along its top and bottom edge (a hairline with a short run of ruler ticks), the
   statement in Geist Light, a supporting line, and a decorative pipework drawing at the right that fades out towards
   the text. All lines are drawn in currentColor, so the same rules work on every band ground and in both themes. */
.aq-band__frame {
  position: relative; isolation: isolate;
  padding: calc(var(--space-8) + var(--space-12)) var(--space-12);
  border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  border-radius: var(--radius-0);
}
/* Frame strips: top and bottom, each a hairline space-8 in from the edge with ruler ticks at the start */
.aq-band__frame::before, .aq-band__frame::after {
  content: ""; position: absolute; left: 0; right: 0; height: var(--space-8); pointer-events: none;
  background-image: repeating-linear-gradient(90deg, color-mix(in srgb, currentColor 45%, transparent) 0 1px, transparent 1px var(--space-2));
  background-repeat: no-repeat;
  background-size: var(--space-24) var(--space-2);
}
.aq-band__frame::before {
  top: 0; border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  background-position: var(--space-4) bottom;
}
.aq-band__frame::after {
  bottom: 0; border-top: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  background-position: right var(--space-4) top;
}

.aq-band__text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-6); max-width: 75%; }
.aq-band__h {
  margin: 0; max-width: 20ch;
  font: 300 clamp(44px, 6.4cqi, 80px)/1.08 var(--font-sans); letter-spacing: -0.035em;
  color: inherit; text-wrap: balance; overflow-wrap: break-word;
}
.aq-band__lead { margin: 0; }

/* Mark: corner brackets around one word or phrase named by the content (optional `mark` field) */
.aq-band__mark {
  padding: 0 0.12em; margin: 0 -0.04em;
  -webkit-box-decoration-break: clone; box-decoration-break: clone;
  background-image:
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor),
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor),
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor),
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-size: 0.22em 2px, 2px 0.22em, 0.22em 2px, 2px 0.22em, 0.22em 2px, 2px 0.22em, 0.22em 2px, 2px 0.22em;
  background-position: left top, left top, right top, right top, left bottom, left bottom, right bottom, right bottom;
}

/* Pipework drawing: decoration only (aria-hidden), fades out towards the text */
.aq-band__motif {
  position: absolute; z-index: 0; right: var(--space-12);
  top: calc(var(--space-8) + 1px);
  width: 34%; height: calc(100% - 2 * var(--space-8) - 2px);
  fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke;
  opacity: 0.4; pointer-events: none;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 60%);
  mask-image: linear-gradient(90deg, transparent, black 60%);
}
.aq-band__motif * { vector-effect: non-scaling-stroke; }
.aq-band__motif path, .aq-band__motif rect { stroke: currentColor; }
.aq-band__motif-fine { opacity: 0.6; }

@container (max-width: 860px) {
  .aq-band__frame { padding: calc(var(--space-6) + var(--space-8)) var(--space-4); }
  .aq-band__frame::before, .aq-band__frame::after { height: var(--space-6); background-size: var(--space-16) var(--space-2); }
  .aq-band__frame::before { background-position: var(--space-3) bottom; }
  .aq-band__frame::after { background-position: right var(--space-3) top; }
  .aq-band__text { max-width: none; gap: var(--space-4); }
  .aq-band__h { font-size: clamp(30px, 9.5cqi, 44px); line-height: 1.1; letter-spacing: -0.025em; }
  .aq-band__lead { font-size: 16px; line-height: 24px; }
  /* The drawing drops to the lower right corner, lighter, so it never sits under the statement at full strength */
  .aq-band__motif {
    top: auto; bottom: calc(var(--space-6) + 1px); right: var(--space-3);
    width: 45%; height: 55%; opacity: 0.22;
    -webkit-mask-image: linear-gradient(180deg, transparent, black 70%);
    mask-image: linear-gradient(180deg, transparent, black 70%);
  }
}

/* ---------- CaseStudy: fact boxes beside one large measured-outcome figure ---------- */
/* One framed case per project, stacked. Desktop: Client, Problem and System delivered as boxes in the left column,
   the outcome box spanning their height on the right with the figure set large in mono. */
.aq-cases { counter-reset: aq-case; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
.aq-case {
  counter-increment: aq-case;
  display: flex; flex-direction: column; gap: var(--space-4);
  min-width: 0; padding: var(--space-6);
  border: 1px solid var(--line-strong);
  background: var(--surface);
}

/* Header: "Case 01 /" in mono, then the title, above a hairline */
.aq-case__title { margin: 0; padding-bottom: var(--space-4); border-bottom: 1px solid var(--line); text-wrap: pretty; overflow-wrap: break-word; }
.aq-case__title::before {
  content: "Case " counter(aq-case, decimal-leading-zero) " /";
  display: block; margin-bottom: var(--space-2);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--ink-muted);
}

/* The dl is the grid; each dt/dd pair sits in its own box (a div, which dl allows) */
.aq-case__facts {
  margin: 0;
  display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  grid-auto-rows: auto; gap: var(--space-3);
}
.aq-case__fact, .aq-case__outcome {
  min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  padding: var(--space-4);
  background: var(--surface-raised);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-0);
}
.aq-case__fact { grid-column: 1; }
.aq-case dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case dd { margin: 0; overflow-wrap: break-word; }
.aq-case__fact dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcome: spans the fact rows; the flow top edge is the case's one accent */
.aq-case__outcome {
  grid-column: 2; grid-row: 1 / span 3;
  padding: var(--space-6);
  border-color: var(--flow);
  box-shadow: inset 0 2px 0 var(--flow);
}
.aq-case__facts:not(:has(> .aq-case__fact)) > .aq-case__outcome { grid-column: 1 / -1; grid-row: auto; }
.aq-case__outcome dd { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-6); }
.aq-case__figure { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-2); min-width: 0; padding-top: var(--space-4); }
.aq-case__num {
  min-width: 0; overflow-wrap: anywhere;
  font: 300 clamp(72px, 11cqi, 168px)/0.9 var(--font-mono);
  letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-case__unit { font: 400 28px/32px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
/* A bracketed value inside the figure keeps the placeholder look, scaled to the slot */
.aq-case__num .aq-ph, .aq-case__unit .aq-ph { font-size: 0.4em; vertical-align: middle; }
.aq-case__result { max-width: var(--text-max); font: 400 18px/28px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* No figure supplied yet: a dashed placeholder slot the size of the figure, so the gap is obvious */
.aq-case__figure.is-empty {
  align-items: center; justify-content: center;
  min-height: clamp(96px, 11cqi, 168px);
  margin-top: var(--space-4); padding: var(--space-4);
  border: 1px dashed var(--caution);
  background: var(--caution-tint);
}
.aq-case__figure.is-empty .aq-ph { font-size: 18px; line-height: 24px; text-align: center; }
.is-clean .aq-case__figure.is-empty { border-color: var(--line-strong); background: none; color: var(--ink-subtle); }

/* Outcome spans however many fact boxes there are (three by default; Standard met makes four). Two-column widths only. */
@container (min-width: 861px) {
  .aq-case__facts:has(> .aq-case__fact:nth-child(4)) > .aq-case__outcome { grid-row: 1 / span 4; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(3))) > .aq-case__outcome { grid-row: 1 / span 2; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(2))) > .aq-case__outcome { grid-row: 1; }
}

/* How it was measured: a full-width box under the facts and outcome, quieter than the facts */
.aq-case__method {
  grid-column: 1 / -1; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  padding: var(--space-4);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-0);
}
.aq-case__method dd { font: 400 15px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Status label: says the case is a template or awaiting client approval; sits above the "Case 01 /" header */
.aq-case__status {
  align-self: flex-start;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--caution); background: var(--caution-tint);
  padding: var(--space-1) var(--space-2); border-radius: var(--radius-0);
}

/* Project profile: the KeyFacts strip of headline KPIs, set inside the case frame under the title */
.aq-case__profile { background-color: var(--surface-raised); }

@container (max-width: 860px) {
  /* Phones: one column, outcome box after the facts, figure scaled to the screen */
  .aq-cases { gap: var(--space-6); }
  .aq-case { padding: var(--space-4); }
  .aq-case__facts { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
  .aq-case__fact, .aq-case__outcome { grid-column: 1; grid-row: auto; padding: var(--space-4); }
  .aq-case__method { grid-column: 1; }
  .aq-case__fact dd { font-size: 15px; line-height: 24px; }
  .aq-case__outcome dd { gap: var(--space-4); }
  .aq-case__figure { padding-top: var(--space-2); }
  .aq-case__num { font-size: clamp(56px, 20cqi, 96px); }
  .aq-case__unit { font-size: 20px; line-height: 24px; }
  .aq-case__result { font-size: 16px; line-height: 26px; }
  .aq-case__figure.is-empty { min-height: var(--space-24); margin-top: var(--space-2); }
  .aq-case__figure.is-empty .aq-ph { font-size: 15px; }
}

/* ---------- Closing: the call to action at the end of every page, on the navy band ---------- */
/* A framed panel with corner registration marks: a very large headline, then the lead sentence and one proof readout
   on the left and the primary button bottom right. Sits on .aq-band--navy, which sets the ground, text colours and the
   Limestone primary button; this file only lays it out. Frame lines are on-navy-muted at reduced strength. */
.aq-closing { text-align: start; border-bottom: 1px solid var(--line-strong); }
.aq-closing__frame {
  position: relative;
  display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  column-gap: var(--space-12); row-gap: var(--space-8);
  padding: var(--space-12);
  border: 1px solid color-mix(in srgb, var(--on-navy-muted) 35%, transparent);
}
/* Registration marks at the top-left and bottom-right corners */
.aq-closing__frame::before, .aq-closing__frame::after {
  content: ""; position: absolute; width: var(--space-4); height: var(--space-4); pointer-events: none;
  border: 0 solid var(--on-navy-muted);
}
.aq-closing__frame::before { top: calc(-1 * var(--space-2)); left: calc(-1 * var(--space-2)); border-top-width: 1px; border-left-width: 1px; }
.aq-closing__frame::after { bottom: calc(-1 * var(--space-2)); right: calc(-1 * var(--space-2)); border-bottom-width: 1px; border-right-width: 1px; }

.aq-closing__h {
  grid-column: 1 / -1; max-width: 18ch;
  font: 300 88px/92px var(--font-sans); letter-spacing: -0.035em; color: var(--on-navy);
  overflow-wrap: break-word;
}
.aq-closing__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); min-width: 0; }
.aq-closing .aq-closing__body .aq-lead { color: var(--on-navy-muted); }
.aq-closing__action { display: flex; align-items: flex-end; justify-content: flex-end; min-width: 0; }

/* Proof readout: one confirmed figure from the page, in mono */
.aq-closing__proof {
  display: flex; flex-direction: column; gap: var(--space-1);
  min-width: 0; max-width: 100%;
  padding: var(--space-3) var(--space-4) var(--space-4);
  border: 1px solid color-mix(in srgb, var(--on-navy-muted) 60%, transparent);
  border-radius: var(--radius-0);
}
.aq-closing__tag { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-closing__value {
  font: 300 48px/52px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  color: var(--limestone); overflow-wrap: anywhere;
}
.aq-closing__label { font: 400 14px/22px var(--font-mono); color: var(--on-navy-muted); }

/* Checklist (cta.include): what to send us, as compact numbered rows on faint hairlines */
.aq-closing__include { display: flex; flex-direction: column; gap: var(--space-2); width: 100%; max-width: var(--text-max); }
.aq-closing__include ol { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: var(--space-8); }
.aq-closing__include li {
  break-inside: avoid; display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); align-items: baseline;
  padding-block: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent);
  font: 400 15px/22px var(--font-sans); color: var(--on-navy);
}
.aq-closing__include .aq-index { color: var(--on-navy-muted); line-height: 22px; }

@container (max-width: 860px) {
  .aq-closing__frame { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); padding: var(--space-6) var(--space-4); }
  .aq-closing__frame::before { top: calc(-1 * var(--space-1)); left: calc(-1 * var(--space-1)); }
  .aq-closing__frame::after { bottom: calc(-1 * var(--space-1)); right: calc(-1 * var(--space-1)); }
  .aq-closing__h { font-size: 40px; line-height: 44px; letter-spacing: -0.025em; }
  .aq-closing__value { font-size: 36px; line-height: 40px; }
  .aq-closing__action { justify-content: flex-start; }
  .aq-closing__include ol { columns: 1; }
  .aq-closing__include li { font-size: 14px; line-height: 20px; }
  .aq-closing__action .aq-btn { max-width: 100%; white-space: normal; height: auto; min-height: 44px; }
}

/* ---------- DocList ---------- */
/* Desktop: tiles on a 6-column grid, three to a row; hairlines are the 1px grid gap showing the list's line background.
   Each tile: the shared index (.aq-index) and the document code on one line, the name below. */
.aq-docs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); }
.aq-docs > li { grid-column: span 2; position: relative; min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-3); padding: var(--space-6); background: var(--surface); }
/* Last rows widen to two tiles so no row is left short: 3n+2 items end with one row of two, 3n+1 items with two rows of two. */
.aq-docs > li:where(:nth-child(3n+1):nth-last-child(2), :nth-child(3n+1):nth-last-child(2) ~ li,
  :nth-child(3n+1):nth-last-child(4), :nth-child(3n+1):nth-last-child(4) ~ li) { grid-column: span 3; }
.aq-docs__code { font: 400 20px/24px var(--font-mono); letter-spacing: -0.01em; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
.aq-docs__name { flex-basis: 100%; min-width: 0; font: 400 15px/22px var(--font-sans); color: var(--ink); }
.aq-docs__d { display: block; margin-top: var(--space-1); font-size: 14px; color: var(--ink-muted); }

/* Phone: a compact numbered list, "01  FS  Functional specification", index and codes in aligned columns. */
@container (max-width: 860px) {
  .aq-docs { grid-template-columns: var(--space-8) auto minmax(0, 1fr); gap: 0; background: none; border: 0; border-bottom: 1px solid var(--line); }
  .aq-docs > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; column-gap: var(--space-3); align-items: baseline; padding: var(--space-3) 0; background: none; border-top: 1px solid var(--line); }
  .aq-docs__code { font: 400 14px/22px var(--font-mono); letter-spacing: 0; }
  .aq-docs--plain .aq-docs__name { grid-column: 2 / -1; }
  .aq-docs__name { font-size: 15px; }
}

/* ---------- FAQ: hairline accordion rows ---------- */
/* One row per question: the shared index (.aq-index), the question, and a +/− sign at the right. The answer opens under
   the question column. No cards, no grid paper. Native <details>, so it works without JavaScript; a shared name keeps
   one answer open. Collapsed rows are about 56 px on phones. */
.aq-faq { border-bottom: 1px solid var(--line); }
.aq-faq > details { border-top: 1px solid var(--line); }
.aq-faq summary {
  display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) var(--space-6);
  column-gap: var(--space-4); align-items: baseline;
  padding-block: var(--space-4);
  cursor: pointer; list-style: none;
  font: 500 17px/24px var(--font-sans); color: var(--ink);
}
.aq-faq summary::-webkit-details-marker { display: none; }
.aq-faq summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-faq__q { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-faq summary:hover .aq-faq__q { color: var(--flow); }
.aq-faq__sign { justify-self: end; font: 400 18px/24px var(--font-mono); color: var(--ink-subtle); }
.aq-faq__sign::before { content: "+"; }
.aq-faq details[open] .aq-faq__sign::before { content: "\2212"; }
.aq-faq details[open] .aq-faq__sign { color: var(--flow); }

/* Answer: under the question column */
.aq-faq__a {
  padding: 0 calc(var(--space-6) + var(--space-4)) var(--space-6) calc(var(--space-12) + var(--space-4));
  animation: aq-faq-in 400ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-faq__a p { margin: 0; max-width: var(--text-max); font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }
.aq-faq__a p + p { margin-top: var(--space-2); }
@keyframes aq-faq-in { from { opacity: 0; transform: translateY(var(--space-2)); } to { opacity: 1; transform: none; } }
@keyframes aq-faq-fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .aq-faq__a { animation-name: aq-faq-fade; } }

@container (max-width: 860px) {
  .aq-faq summary { grid-template-columns: var(--space-8) minmax(0, 1fr) var(--space-4); column-gap: var(--space-3); font-size: 16px; line-height: 24px; }
  .aq-faq__a { padding: 0 0 var(--space-4) calc(var(--space-8) + var(--space-3)); }
}

/* ---------- Hero ---------- */
.aq-hero { position: relative; overflow: hidden; padding-block: var(--space-24) var(--space-16); }
.aq-hero--home { padding-block: var(--space-32) var(--space-24); }
.aq-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-12); align-items: stretch; }
.aq-hero__grid--figure { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; }
.aq-hero__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: center; margin-top: var(--space-2); }
.aq-hero .aq-tags { margin-top: var(--space-2); }
.aq-photo { position: relative; z-index: 1; aspect-ratio: 4 / 3; min-height: 100%; max-width: 100%; background-color: var(--surface-sunken); background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: var(--space-8) var(--space-8); background-position: -1px -1px; border: 1px solid var(--line); display: flex; align-items: flex-end; padding: var(--space-4); font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
.aq-arc { position: absolute; right: -1px; bottom: -1px; width: min(38%, 420px); height: auto; pointer-events: none; }
.aq-arc__outer { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
.aq-arc__inner { fill: none; stroke: var(--flow); stroke-width: 1.5; }

/* Figure: equipment drawing on a fading blueprint grid, with callouts carrying the page's key facts.
   The box is 5:4 (viewBox 125 x 100 for the leaders); the drawing is a centred square 84 % of its height. */
.aq-hero__figure { position: relative; z-index: 1; margin: 0; aspect-ratio: 5 / 4; }
.aq-hero__figure::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: var(--space-8) var(--space-8); background-position: center; -webkit-mask: radial-gradient(closest-side, var(--ink) 55%, transparent); mask: radial-gradient(closest-side, var(--ink) 55%, transparent); pointer-events: none; }
.aq-hero__figure .aq-illustration { position: absolute; inset: 8% 16.4%; width: auto; max-width: none; aspect-ratio: auto; margin: 0; }
.aq-hero__leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.aq-hero__leaders line { stroke: var(--flow); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-hero__leaders circle { fill: var(--flow); }
.aq-hero__callouts { position: absolute; inset: 0; margin: 0; pointer-events: none; }
.aq-hero__callout { position: absolute; width: 30%; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-1); padding-block: var(--space-2); background: var(--surface); border-top: 1px solid var(--flow); pointer-events: auto; }
.aq-hero__callout:nth-child(1) { top: 0; left: 0; }
.aq-hero__callout:nth-child(2) { top: 0; right: 0; }
.aq-hero__callout:nth-child(3) { bottom: 0; left: 0; }
.aq-hero__callout:nth-child(4) { bottom: 0; right: 0; }
.aq-hero__callout:nth-child(n+3) { border-top: 0; border-bottom: 1px solid var(--flow); }
.aq-hero__callout dd { margin: 0; font: 300 clamp(16px, 1.7cqi, 22px)/1.2 var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: anywhere; }
.aq-hero__callout dt { font: 500 11px/15px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }

/* Index (hub and company pages): the other pages of this section, numbered, joined by one routed line.
   A 1 px line-strong rule runs down the left from a node to an arrowhead; each item has a dot on the rule and a
   short leader ending in an arrowhead at its number. Number row centre: space-3 padding + 24 px (half of 48 px). */
.aq-hero__grid--index { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; }
.aq-hero__index { position: relative; z-index: 1; min-width: 0; }
.aq-hero__index-label { margin: 0 0 var(--space-2) var(--space-8); font: 500 11px/15px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-hero__index ol { counter-reset: aq-hero-index; position: relative; margin: 0; padding: 0 0 var(--space-6) var(--space-8); list-style: none; }
.aq-hero__index ol::before { content: ""; position: absolute; top: 0; bottom: 6px; left: 0; border-left: 1px solid var(--line-strong); }
.aq-hero__index ol::after { content: ""; position: absolute; bottom: 0; left: -4px; width: 0; height: 0; border-top: 6px solid var(--line-strong); border-inline: 4.5px solid transparent; }
.aq-hero__index li { counter-increment: aq-hero-index; position: relative; }
.aq-hero__index li::before { content: ""; position: absolute; top: calc(var(--space-3) + 24px - 3px); left: calc(-1 * var(--space-8) - 3px); width: 7px; height: 7px; border-radius: var(--radius-pill); background: var(--line-strong); transition: background-color 120ms; }
.aq-hero__index li::after { content: ""; position: absolute; top: calc(var(--space-3) + 24px); left: calc(-1 * var(--space-8)); width: calc(var(--space-6) - 6px); border-top: 1px solid var(--line-strong); }
.aq-hero__index-item { position: relative; display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-3); color: var(--ink); text-decoration: none; }
:where(.aq-page) a.aq-hero__index-item { color: var(--ink); }
.aq-hero__index-item::before {
  content: counter(aq-hero-index, decimal-leading-zero);
  content: counter(aq-hero-index, decimal-leading-zero) / "";
  flex: none; min-width: 2ch; font: 400 13px/48px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--ink-subtle);
}
/* Arrowhead at the end of the leader, pointing at the number */
.aq-hero__index-item::after { content: ""; position: absolute; top: calc(var(--space-3) + 24px - 4px); left: calc(-1 * var(--space-2) - 6px); width: 0; height: 0; border-left: 6px solid var(--line-strong); border-block: 4px solid transparent; transition: border-left-color 120ms; }
.aq-hero__index-t { min-width: 0; font: 500 13px/18px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; overflow-wrap: break-word; transition: color 120ms; }
a.aq-hero__index-item .aq-hero__index-t::after { content: "\a0\2192"; color: var(--flow); }
a.aq-hero__index-item:hover .aq-hero__index-t { color: var(--flow); }
a.aq-hero__index-item:hover::after, a.aq-hero__index-item:focus-visible::after { border-left-color: var(--flow); }
.aq-hero__index li:has(> a:hover, > a:focus-visible)::before { background: var(--flow); }
a.aq-hero__index-item:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-1); }

/* Home: fine-line drawing of a figure-eight distribution loop. Pipe in ink-muted (currentColor), guides in line,
   scale rule and leaders in line-strong, flow arrows in flow, annotations in Geist Mono caps. */
.aq-hero__grid--loop { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; }
.aq-hero__loop { position: relative; z-index: 1; margin: 0; color: var(--ink-muted); }
.aq-hero__loop svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-loop__pipe { fill: none; stroke: currentColor; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
.aq-loop__guide { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 4 4; vector-effect: non-scaling-stroke; }
.aq-loop__rule line, .aq-loop__lead line { stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-loop__part { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-loop__part rect, .aq-loop__part circle { fill: var(--surface); }
.aq-loop__arrow { fill: var(--flow); }
.aq-loop__text text { fill: var(--ink-muted); font: 500 10px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
.aq-loop__text .aq-loop__tag { fill: var(--ink); font-size: 8px; letter-spacing: 0.02em; }

@media (prefers-reduced-motion: reduce) {
  .aq-hero__index li::before, .aq-hero__index-item::after, .aq-hero__index-t { transition: none; }
}

@container (max-width: 860px) {
  /* Phones: the hero fits about 1.5 screens with its facts. Headline sized for 375 px, the drawing small and after the
     actions, callouts and KeyFacts as compact 2 x 2 grids. */
  .aq-hero, .aq-hero--home { padding-block: var(--space-12); }
  .aq-hero .aq-display { font-size: 34px; line-height: 38px; letter-spacing: -0.02em; }
  .aq-hero .aq-display-xl { font-size: 40px; line-height: 44px; }
  .aq-hero .aq-lead { font-size: 17px; line-height: 26px; }
  .aq-hero__grid { row-gap: var(--space-8); }
  .aq-hero__grid, .aq-hero__grid--figure, .aq-hero__grid--index, .aq-hero__grid--loop { grid-template-columns: minmax(0, 1fr); }
  .aq-photo { min-height: 0; aspect-ratio: 2 / 1; }
  .aq-hero__figure { aspect-ratio: auto; margin-top: 0; }
  .aq-hero__figure::before { bottom: auto; aspect-ratio: 1; }
  .aq-hero__figure .aq-illustration { position: relative; inset: auto; width: min(100%, calc(var(--space-32) + var(--space-12))); aspect-ratio: 1; margin-inline: auto; }
  .aq-hero__leaders { display: none; }
  .aq-hero__callouts { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: var(--space-4); border-top: 1px solid var(--line-strong); }
  .aq-hero__callout, .aq-hero__callout:nth-child(n) { position: static; width: auto; background: none; border: 0; border-top: 1px solid var(--line); padding: var(--space-3) var(--space-3) var(--space-3) 0; }
  .aq-hero__callout:nth-child(-n+2) { border-top: 0; }
  .aq-hero__callout dd { font-size: 18px; }
  /* Index: under the actions, smaller figures */
  .aq-hero__grid--index { row-gap: var(--space-8); }
  .aq-hero__index-label { margin-left: var(--space-6); }
  .aq-hero__index ol { padding-left: var(--space-6); }
  .aq-hero__index li::before { top: calc(var(--space-2) + 18px - 3px); left: calc(-1 * var(--space-6) - 3px); }
  .aq-hero__index li::after { top: calc(var(--space-2) + 18px); left: calc(-1 * var(--space-6)); width: calc(var(--space-4) - 6px); }
  .aq-hero__index-item { gap: var(--space-3); padding-block: var(--space-2); }
  .aq-hero__index-item::before { line-height: 36px; }
  .aq-hero__index-item::after { top: calc(var(--space-2) + 18px - 4px); }
  /* Loop drawing: below the actions, capped so annotations stay legible */
  .aq-hero__grid--loop { row-gap: var(--space-8); }
  .aq-hero__loop { width: min(100%, calc(var(--space-32) + var(--space-24))); margin-inline: auto; }
}

/* ---------- LinkGrid: choices (usually pages) as rows of the shared list grammar ---------- */
/* Layout from .aq-rows (base.css): index | title (→ when it links) | one line and an optional standard tag, with the
   linked page's drawing small at the row end on desktop. Phones: compact rows, no drawings. */
.aq-linkgrid .aq-rows__art { transition: background-color 120ms; }
.aq-linkgrid .aq-rows__t { transition: color 120ms; }
@media (prefers-reduced-motion: reduce) { .aq-linkgrid .aq-rows__art, .aq-linkgrid .aq-rows__t { transition: none; } }

/* ---------- OptionList: configuration options as rows of the shared list grammar ---------- */
/* Layout comes from .aq-rows in base.css (index | option | one line on desktop; index | option, line below on phones).
   This file only adds the hook; options never get a box, a grid ground or a decorative glyph. */
.aq-options { min-width: 0; }

/* ---------- ProcessDiagram: treatment train as numbered stages on one serpentine Flow pipe ---------- */
/* Rows of three stages; every second row runs right to left (direction: rtl), so the pipe snakes down
   without any run-time measuring. Pipe = 5px double border in flow, the same language as WaterPath. */
.aq-diagram { min-width: 0; }
.aq-diagram__train { display: flex; flex-direction: column; }
.aq-diagram--base { border: 1px dashed var(--line-strong); border-radius: var(--radius-md); padding: var(--space-6); }
.aq-diagram__row { display: grid; grid-template-columns: minmax(0, 1fr) var(--space-16) minmax(0, 1fr) var(--space-16) minmax(0, 1fr); }
/* Four to a row when that balances the rows (seven stages: 4 + 3, never 3 + 3 + 1) */
.aq-diagram--4 .aq-diagram__row { grid-template-columns: minmax(0, 1fr) var(--space-12) minmax(0, 1fr) var(--space-12) minmax(0, 1fr) var(--space-12) minmax(0, 1fr); }
.aq-diagram__row--rev { direction: rtl; }
.aq-diagram__row > * { direction: ltr; }
.aq-diagram__row--turn { align-items: start; }

/* Stage box: number top left, equipment glyph top right, name at the foot */
.aq-diagram__stage { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto 1fr; column-gap: var(--space-4); row-gap: var(--space-4); padding: var(--space-6) var(--space-4) var(--space-4) var(--space-6); border: 1.5px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--surface); min-width: 0; }
.aq-diagram__num { grid-column: 1; grid-row: 1; font: 300 32px/1 var(--font-mono); letter-spacing: -0.02em; color: var(--flow); }
.aq-diagram__glyph { grid-column: 2; grid-row: 1 / 3; width: 72px; height: 56px; fill: none; stroke: var(--ink-muted); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.aq-diagram__label { grid-column: 1; grid-row: 2; align-self: end; font: 500 16px/22px var(--font-sans); color: var(--ink); overflow-wrap: anywhere; }

/* Pipe between stages: horizontal in a row, vertical (--turn) between rows */
.aq-diagram__link { position: relative; align-self: center; height: 0; border-top: 5px double var(--flow); }
.aq-diagram__link::after { content: ""; position: absolute; top: -8.5px; right: -1px; border: 6px solid transparent; border-left: 9px solid var(--flow); border-right: 0; }
.aq-diagram__row--rev .aq-diagram__link::after { right: auto; left: -1px; border-left: 0; border-right: 9px solid var(--flow); }
.aq-diagram__link--turn { align-self: auto; justify-self: center; width: 0; height: var(--space-12); border-top: 0; border-left: 5px double var(--flow); }
.aq-diagram__row .aq-diagram__link--turn::after { top: auto; right: auto; bottom: -1px; left: -8.5px; border: 6px solid transparent; border-top: 9px solid var(--flow); border-bottom: 0; }

/* Valve and instrument symbols sit on the pipe; the surface fill breaks the line as on a P&ID */
.aq-diagram__fitting { position: absolute; left: 50%; top: -2.5px; width: 28px; height: 28px; transform: translate(-50%, -50%); fill: var(--surface); stroke: var(--ink-muted); stroke-width: 1.5; stroke-linejoin: round; }
.aq-diagram__link--turn .aq-diagram__fitting { left: -2.5px; top: 50%; transform: translate(-50%, -50%) rotate(90deg); }

/* What spans every stage: a dashed control boundary round the train, labelled at its foot */
.aq-diagram__base { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-6); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-diagram__base .aq-diagram__fitting { position: static; flex: none; transform: none; fill: none; }

/* Phone: compact hairline rows "01 | pipe | glyph | name" on one vertical Flow pipe; the boxes, fittings and
   row-to-row links are desktop only. A seven-stage train is about 400 px tall instead of 1,200. */
@container (max-width: 860px) {
  .aq-diagram--base { padding: var(--space-2) var(--space-4) var(--space-4); }
  .aq-diagram__train { border-bottom: 1px solid var(--line); }
  .aq-diagram__row { display: contents; }
  .aq-diagram__link { display: none; }
  .aq-diagram__stage { position: relative; grid-template-columns: var(--space-8) var(--space-4) var(--space-12) minmax(0, 1fr); grid-template-rows: auto; align-items: center; column-gap: var(--space-2); padding: var(--space-2) 0; border: 0; border-top: 1px solid var(--line); border-radius: 0; background: none; }
  .aq-diagram__row:first-child > .aq-diagram__stage:first-child { border-top: 0; }
  .aq-diagram__num { grid-column: 1; grid-row: 1; font: 400 13px/24px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
  .aq-diagram__glyph { grid-column: 3; grid-row: 1; width: var(--space-12); height: var(--space-8); }
  .aq-diagram__label { grid-column: 4; grid-row: 1; align-self: center; font-size: 15px; line-height: 22px; }
  /* The pipe: a 5 px double Flow line down column 2 through every row, from the first stage's centre to the last's, with a node at each stage */
  .aq-diagram__stage::before { content: ""; position: absolute; top: 0; bottom: 0; left: calc(var(--space-8) + var(--space-2) + var(--space-2) - 2.5px); border-left: 5px double var(--flow); }
  .aq-diagram__row:first-child > .aq-diagram__stage:first-child::before { top: 50%; }
  .aq-diagram__row:last-child > .aq-diagram__stage:last-child::before { bottom: 50%; }
  .aq-diagram__stage::after { content: ""; position: absolute; top: 50%; left: calc(var(--space-8) + var(--space-2) + var(--space-2)); width: var(--space-2); height: var(--space-2); border: 1.5px solid var(--flow); border-radius: var(--radius-pill); background: var(--surface); transform: translate(-50%, -50%); }
  .aq-diagram__base { margin-top: var(--space-3); }
}

/* ---------- ProcessSteps: a real sequence as rows of the shared list grammar ---------- */
/* Layout from .aq-rows (base.css): index | step name | what happens. The index already carries the order, so there is
   no pipe, spine or stair: hairlines between steps are the only structure. */
.aq-steps { min-width: 0; }

/* ---------- Prose ---------- */
/* Plain: a few paragraphs within text-max (also used for captions). */
.aq-prose { max-width: var(--text-max); }
.aq-prose p + p { margin-top: var(--space-4); }

/* Sheet (the site's prose block): the first sentence as a light lead, then plain paragraphs in ink-muted.
   Reading text sits on the plain section ground: no grid paper, frame or margin notes.
   ".aq-prose.aq-prose--sheet" selectors match SplitSection's ".aq-split-section__body .aq-prose p:first-child"
   specificity and win by coming later in bundle.css, so the lead and body keep their own type inside a split. */
.aq-prose--sheet { display: flex; flex-direction: column; gap: var(--space-4); }
.aq-prose.aq-prose--sheet > p { margin: 0; font: 400 16px/26px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; overflow-wrap: break-word; }
.aq-prose.aq-prose--sheet > p.aq-prose__lead {
  font: 300 24px/32px var(--font-sans); letter-spacing: -0.01em; color: var(--ink);
  text-wrap: balance;
}

@container (max-width: 860px) {
  .aq-prose.aq-prose--sheet > p.aq-prose__lead { font-size: 20px; line-height: 28px; }
}

/* ---------- Readout: one figure on a precision instrument face ---------- */
/* A drawing frame with four corner marks. The figure is huge Geist Mono in flow, its unit set vertically beside it;
   a dashed reference line crosses the frame at the figure's mid-height and carries the method in a boxed tag. The body
   is the caption. Along the bottom, a decorative tick scale (aria-hidden, CSS only); the --limit modifier adds a flat
   flow-tint reference band ending at a limit marker. The scale is a schematic: it plots nothing. */
.aq-readout {
  position: relative;
  display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  column-gap: var(--space-12); row-gap: var(--space-8);
  padding: var(--space-12);
  border: 1px solid var(--line);
  background-color: var(--surface);
  /* Corner marks: two short line-strong bars at each corner, drawn over the frame line */
  background-image:
    linear-gradient(var(--line-strong), var(--line-strong)), linear-gradient(var(--line-strong), var(--line-strong)),
    linear-gradient(var(--line-strong), var(--line-strong)), linear-gradient(var(--line-strong), var(--line-strong)),
    linear-gradient(var(--line-strong), var(--line-strong)), linear-gradient(var(--line-strong), var(--line-strong)),
    linear-gradient(var(--line-strong), var(--line-strong)), linear-gradient(var(--line-strong), var(--line-strong));
  background-repeat: no-repeat;
  background-origin: border-box;
  background-size: var(--space-6) 2px, 2px var(--space-6), var(--space-6) 2px, 2px var(--space-6),
    var(--space-6) 2px, 2px var(--space-6), var(--space-6) 2px, 2px var(--space-6);
  background-position: left top, left top, right top, right top, left bottom, left bottom, right bottom, right bottom;
}

/* Head: reading on the left, the method tag on the right; font-size here sets the figure, and 1em = its height */
.aq-readout__head {
  grid-column: 1 / -1; position: relative;
  display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-12); align-items: start;
  font-size: clamp(64px, 12cqi, 160px); line-height: 1;
}
/* Reference line through the figure's mid-height, edge to edge of the frame */
.aq-readout__head::before {
  content: ""; position: absolute; top: 0.5em;
  left: calc(-1 * var(--space-12)); right: calc(-1 * var(--space-12));
  border-top: 1px dashed var(--line-strong); pointer-events: none;
}

.aq-readout__reading {
  position: relative; margin: 0; min-width: 0;
  display: flex; flex-wrap: wrap; align-items: flex-start;
  font: 300 1em/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-readout__figure { min-width: 0; overflow-wrap: anywhere; }
.aq-readout__figure .aq-ph { letter-spacing: -0.02em; }
/* Comparator (<, ≤): smaller, centred on the digits */
.aq-readout__cmp { font-size: 0.4em; vertical-align: 0.6em; letter-spacing: 0; color: var(--ink-muted); }
/* Unit: vertical, reading bottom to top, top-aligned with the figure */
.aq-readout__unit {
  writing-mode: vertical-rl; transform: rotate(180deg);
  margin-left: var(--space-2);
  font: 400 max(16px, 0.16em)/1 var(--font-mono); letter-spacing: 0.02em; color: var(--ink);
}
/* Condition ("@ 25 °C"): small, on its own line under the figure; -1ch cancels the leading no-break space */
.aq-readout__cond {
  flex-basis: 100%; margin: var(--space-3) 0 0 -1ch;
  font: 400 14px/22px var(--font-mono); letter-spacing: 0; color: var(--ink-muted);
}

/* Method tag, centred on the reference line */
.aq-readout__ref { position: relative; display: flex; align-items: center; height: 1em; min-width: 0; }
.aq-readout__tag {
  max-width: 100%; padding: var(--space-1) var(--space-3);
  border: 1px solid var(--flow); border-radius: var(--radius-0); background: var(--surface);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink);
  overflow-wrap: anywhere;
}

.aq-readout__caption { grid-column: 2; margin: 0; min-width: 0; }

/* Tick scale: minor ticks every space-2, major ticks every space-16, over a hairline. Decorative only. */
.aq-readout__scale {
  grid-column: 1 / -1; position: relative; height: var(--space-12);
  border-top: 1px solid var(--line);
  background-image:
    repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px var(--space-16)),
    repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px var(--space-2));
  background-repeat: no-repeat;
  background-size: 100% var(--space-6), 100% var(--space-2);
  background-position: left bottom, left bottom;
}
/* Limit readouts: a flat reference band up to a marker. A fixed schematic position, not a measurement. */
.aq-readout--limit .aq-readout__scale::before {
  content: ""; position: absolute; left: 0; width: 75%; top: var(--space-3); height: var(--space-3);
  background: var(--flow-tint);
}
.aq-readout--limit .aq-readout__scale::after {
  content: ""; position: absolute; left: 75%; top: var(--space-2); bottom: 0;
  border-left: 2px solid var(--flow);
}

@container (max-width: 860px) {
  .aq-readout {
    grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6);
    padding: var(--space-6) var(--space-4);
    background-size: var(--space-4) 2px, 2px var(--space-4), var(--space-4) 2px, 2px var(--space-4),
      var(--space-4) 2px, 2px var(--space-4), var(--space-4) 2px, 2px var(--space-4);
  }
  .aq-readout__head { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); font-size: clamp(48px, 18cqi, 112px); }
  .aq-readout__head::before { display: none; }
  /* Unit turns horizontal and drops under the figure */
  .aq-readout__unit {
    writing-mode: horizontal-tb; transform: none; flex-basis: 100%;
    margin: var(--space-2) 0 0 -1ch; font-size: 28px; line-height: 34px; letter-spacing: 0;
  }
  .aq-readout__ref { height: auto; }
  .aq-readout__caption { grid-column: 1; }
  .aq-readout__scale { height: var(--space-8); background-size: 100% var(--space-4), 100% var(--space-2); }
  .aq-readout--limit .aq-readout__scale::before { top: var(--space-2); height: var(--space-2); }
  .aq-readout--limit .aq-readout__scale::after { top: var(--space-1); }
}

/* ---------- RelatedLinks: the pages to read next ---------- */
/* Desktop: three to a row (four for 4, 7 or 8 pages), each a hairline-topped column: the shared index, the page's drawing (when it has one),
   its section as a mono label and its title with an arrow. Phones: compact rows of the shared list grammar,
   index | title, section label below, arrow at the right; no drawings. The whole item is the link. */
.aq-related-links {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: var(--space-6);
  margin: 0; padding: 0; list-style: none;
}
/* Four, seven or eight pages: four to a row */
.aq-related-links:has(> :nth-child(4)):not(:has(> :nth-child(5))),
.aq-related-links:has(> :nth-child(7)) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.aq-related-links > li { min-width: 0; display: flex; border-top: 1px solid var(--line-strong); }
.aq-related-links__card {
  flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas: "i art" "g g" "t t";
  align-items: start; align-content: start; row-gap: var(--space-2);
  padding: var(--space-3) 0 var(--space-6);
  color: var(--ink); text-decoration: none;
}
:where(.aq-page) a.aq-related-links__card { color: var(--ink); }
.aq-related-links__card .aq-index { grid-area: i; }
.aq-related-links__art { grid-area: art; width: var(--space-16); margin-bottom: var(--space-2); transition: background-color 120ms; }
.aq-related-links__group { grid-area: g; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-related-links__title { grid-area: t; font: 500 17px/24px var(--font-sans); overflow-wrap: break-word; text-wrap: pretty; transition: color 120ms; }
.aq-related-links__title::after { content: "\a0\2192"; color: var(--flow); }
.aq-related-links__card:hover .aq-related-links__title { color: var(--flow); }
.aq-related-links__card:hover .aq-related-links__art { background-color: var(--flow); }
.aq-related-links > li:has(> a:hover) { border-top-color: var(--flow); }
.aq-related-links__card:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

@media (prefers-reduced-motion: reduce) {
  .aq-related-links__card, .aq-related-links__art, .aq-related-links__title { transition: none; }
}

@container (max-width: 860px) {
  .aq-related-links, .aq-related-links:has(> :nth-child(4)):not(:has(> :nth-child(5))),
  .aq-related-links:has(> :nth-child(7)) { grid-template-columns: minmax(0, 1fr); border-bottom: 1px solid var(--line); }
  .aq-related-links > li { border-top-color: var(--line); }
  .aq-related-links__card {
    grid-template-columns: var(--space-8) minmax(0, 1fr);
    grid-template-areas: "i t" ". g";
    column-gap: var(--space-3); row-gap: 0; align-items: baseline;
    padding: var(--space-3) 0;
  }
  .aq-related-links__art { display: none; }
  .aq-related-links__title { font-size: 16px; }
}

/* ---------- StandardsGrid: numbered standard cards in a plain frame, joined by thin connector lines ---------- */
/* Desktop: three cards to a row; a horizontal connector runs from each card to the next in its row at number height,
   and a vertical connector drops from every card into the one below. Phones: one column beside a measuring ruler. */
.aq-standards-grid {
  counter-reset: aq-standards;
  list-style: none; margin: 0;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6);
  padding: var(--space-6);
  border: 1px solid var(--line);
  background-color: var(--surface);
}
.aq-standards-grid__item { counter-increment: aq-standards; position: relative; min-width: 0; display: flex; }

/* Connectors live on the item so the card keeps its own pseudo-elements; :where keeps the phone rules able to override */
.aq-standards-grid__item::before,
.aq-standards-grid__item::after { content: ""; position: absolute; pointer-events: none; }
/* Horizontal: to the next card in the same row */
.aq-standards-grid__item:where(:not(:nth-child(3n)):not(:last-child))::after {
  top: calc(var(--space-4) + var(--space-2) - 1px); left: calc(100% + 1px);
  width: calc(var(--space-6) - 2px); border-top: 1px solid var(--line-strong);
}
/* Vertical: up into the card above (rows two onwards) */
.aq-standards-grid__item:where(:nth-child(n+4))::before {
  left: var(--space-8); top: calc(-1 * var(--space-6));
  height: var(--space-6); border-left: 1px solid var(--line-strong);
}

/* Card: a link to Compliance when that page exists, otherwise a plain block */
.aq-standards-grid__card {
  flex: 1; display: flex; flex-wrap: wrap; align-items: baseline; align-content: flex-start;
  column-gap: var(--space-2); row-gap: var(--space-2);
  padding: var(--space-4) var(--space-4) var(--space-6);
  background: var(--surface-raised);
  border: 1px solid var(--line-strong); border-radius: var(--radius-0);
  color: var(--ink); text-decoration: none;
}
.aq-standards-grid__card::before {
  content: counter(aq-standards, decimal-leading-zero);
  content: counter(aq-standards, decimal-leading-zero) / "";
  font: 400 13px/16px var(--font-mono); letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums; color: var(--ink-subtle);
}
a.aq-standards-grid__card:hover { border-color: var(--flow); box-shadow: inset 0 2px 0 var(--flow); }
a.aq-standards-grid__card:hover::before { color: var(--flow); }
a.aq-standards-grid__card:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Code line: the standard's published short name, in mono beside the number */
.aq-standards-grid__code {
  min-width: 0; overflow-wrap: anywhere;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--ink);
}
/* Plain-language name, below the code line */
.aq-standards-grid__name {
  flex-basis: 100%; min-width: 0; overflow-wrap: break-word; text-wrap: balance;
  font: 400 22px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--ink);
}
/* Code only (no name supplied): the code itself takes the large line */
.aq-standards-grid__item--code .aq-standards-grid__code {
  flex-basis: 100%; overflow-wrap: break-word; text-wrap: balance;
  font: 400 22px/28px var(--font-sans); letter-spacing: -0.01em;
}

@container (max-width: 860px) {
  /* Phones: compact hairline rows, two to a row for code-only standards (one when a plain-language name is given);
     no frame, cards, ruler or connectors */
  .aq-standards-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-4); row-gap: 0;
    padding: 0; border: 0; background: none;
  }
  .aq-standards-grid:has(.aq-standards-grid__name) { grid-template-columns: minmax(0, 1fr); }
  .aq-standards-grid__item::before, .aq-standards-grid__item::after { content: none; }
  .aq-standards-grid__card {
    flex-wrap: nowrap; column-gap: var(--space-3);
    padding: var(--space-3) 0; background: none; border: 0; border-top: 1px solid var(--line);
  }
  .aq-standards-grid:has(.aq-standards-grid__name) .aq-standards-grid__card { flex-wrap: wrap; }
  a.aq-standards-grid__card:hover { box-shadow: none; }
  .aq-standards-grid__name,
  .aq-standards-grid__item--code .aq-standards-grid__code { font-size: 16px; line-height: 22px; }
  .aq-standards-grid__name { padding-left: calc(2ch + var(--space-3)); }
}

/* ---------- WaterPath: system families as stops on one serpentine pipe ---------- */
.aq-water-path { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--space-8); padding-right: var(--space-12); }
.aq-water-path__pipe { grid-column: 1 / -1; grid-row: 1; height: 0; margin-top: var(--space-6); border-top: 5px double var(--flow); }
.aq-water-path__pipe--return { grid-row: 3; margin-top: 0; }
.aq-water-path__bend { grid-column: 4; grid-row: 1 / 4; justify-self: end; width: var(--space-12); margin: var(--space-6) calc(-1 * var(--space-12)) 0 0; border: 5px double var(--flow); border-left: 0; border-radius: 0 var(--space-12) var(--space-12) 0; }
.aq-water-path__feed, .aq-water-path__outlet { grid-column: 1; justify-self: start; z-index: 1; display: inline-flex; align-items: center; height: 24px; padding: 0 var(--space-2); background: var(--flow); color: var(--surface); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; border-radius: var(--radius-sm); }
.aq-water-path__feed { grid-row: 1; margin-top: calc(-1 * var(--space-2)); }
.aq-water-path__outlet { grid-row: 3; margin-top: calc(-1 * var(--space-8)); }
.aq-water-path__stop { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-8) 0 var(--space-12); min-width: 0; }
.aq-water-path__stop:nth-of-type(-n+4) { grid-row: 2; }
.aq-water-path__stop:nth-of-type(1) { grid-column: 1; }
.aq-water-path__stop:nth-of-type(2) { grid-column: 2; }
.aq-water-path__stop:nth-of-type(3) { grid-column: 3; }
.aq-water-path__stop:nth-of-type(4) { grid-column: 4; }
.aq-water-path__stop:nth-of-type(5) { grid-row: 4; grid-column: 4; }
.aq-water-path__stop:nth-of-type(6) { grid-row: 4; grid-column: 3; }
.aq-water-path__stop:nth-of-type(7) { grid-row: 4; grid-column: 2; }
.aq-water-path__stop::before { content: ""; position: absolute; top: -10px; left: var(--space-4); width: 15px; height: 15px; border: 1.5px solid var(--flow); border-radius: var(--radius-pill); background: var(--surface); }
.aq-water-path__stop > * { position: relative; z-index: 1; }
.aq-water-path__glyph { width: 72px; height: 56px; fill: none; stroke: var(--ink-muted); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; margin-bottom: var(--space-2); }
.aq-water-path .aq-water-path__art { width: min(100%, 200px); margin: 0 0 var(--space-2); transition: background-color 120ms; }
/* Stop number: the shared index style (see .aq-index in base.css) */
.aq-water-path__num { font: 400 13px/24px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-water-path__stop a { color: var(--ink); text-decoration: none; }
.aq-water-path__stop a::after { content: "\a0\2192"; color: var(--flow); }
.aq-water-path__stop:hover a { color: var(--flow); }
.aq-water-path__stop:hover .aq-water-path__glyph { stroke: var(--flow); }
.aq-water-path__stop:hover .aq-water-path__art { background-color: var(--flow); }
.aq-water-path__stop .aq-tags { margin-top: var(--space-1); }

@container (max-width: 860px) {
  .aq-water-path { grid-template-columns: minmax(0, 1fr); padding-right: 0; }
  .aq-water-path__pipe, .aq-water-path__bend { display: none; }
  .aq-water-path__feed, .aq-water-path__outlet, .aq-water-path__stop:nth-of-type(n) { grid-row: auto; grid-column: 1; margin: 0; }
  /* Phones: compact stops on the riser; the drawing small at the right of the number and name */
  .aq-water-path__stop {
    display: grid; grid-template-columns: minmax(0, 1fr) var(--space-16); column-gap: var(--space-3); row-gap: var(--space-1);
    border-left: 5px double var(--flow); padding: var(--space-4) 0 var(--space-6) var(--space-6);
  }
  .aq-water-path__stop > * { grid-column: 1 / -1; }
  .aq-water-path__stop > .aq-water-path__num, .aq-water-path__stop > .aq-h3 { grid-column: 1; }
  .aq-water-path .aq-water-path__art, .aq-water-path__glyph { grid-column: 2; grid-row: 1 / 3; width: var(--space-16); height: auto; margin: 0; }
  .aq-water-path__stop .aq-h3 { font-size: 17px; line-height: 24px; }
  .aq-water-path__stop::before { top: var(--space-4); left: -10px; }
}

/* ---------- CompareTable ---------- */
/* A comparison matrix: column heads as eyebrow labels, numbered row labels in a narrow left column, hairline cells.
   Desktop: a real table. Phones: each row is a record, its first cell the title and every other cell a "Label value" line.
   The --list variant (two columns) is a numbered row list at every width. */
.aq-compare-table {
  counter-reset: aq-compare-row;
  color: var(--ink);
  min-width: 0;
}
/* Column label inside each cell, and the column tabs: phones only (the thead names the column on desktop) */
.aq-compare-table__k, .aq-compare-table__tabs { display: none; }

.aq-compare-table__table {
  width: 100%; table-layout: fixed; border-collapse: collapse;
  border-block: 1px solid var(--line);
  font-family: var(--font-sans);
}
.aq-compare-table__table th,
.aq-compare-table__table td {
  text-align: left; vertical-align: top;
  padding: var(--space-4);
  border-bottom: 1px solid var(--line);
  border-left: 1px solid var(--line);
  overflow-wrap: break-word;
}
.aq-compare-table__table tr > :first-child { border-left: 0; width: 22%; }

/* Column heads: eyebrow labels */
.aq-compare-table__table thead th {
  background: var(--surface-sunken);
  border-bottom-color: var(--line-strong);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--ink-muted);
}
/* Row labels: the narrow left column, numbered */
.aq-compare-table__table tbody tr { counter-increment: aq-compare-row; }
.aq-compare-table__table tbody th {
  font: 500 14px/22px var(--font-sans); color: var(--ink);
}
/* Row index: the shared index style (.aq-index), written by CSS so cells stay plain */
.aq-compare-table__table tbody th::before {
  content: counter(aq-compare-row, decimal-leading-zero);
  content: counter(aq-compare-row, decimal-leading-zero) / "";
  display: block; margin-bottom: var(--space-1);
  font: 400 13px/24px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  color: var(--ink-subtle);
}
.aq-compare-table__table tbody td { font: 400 14px/22px var(--font-sans); color: var(--ink); }
.aq-compare-table__table tbody tr:last-child > * { border-bottom: 0; }

/* Routing link: names the destination page, reads "PW generation →" */
.aq-compare-table__table td a {
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--flow); text-decoration: none;
}
.aq-compare-table__table td a::after { content: " →"; content: " →" / ""; }
.aq-compare-table__table td a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
.aq-compare-table__table td a:focus-visible,
.aq-compare-table__tab:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* List variant (two columns): numbered rows, label left, value right; thead becomes a label strip */
.aq-compare-table--list .aq-compare-table__table,
.aq-compare-table--list thead,
.aq-compare-table--list tbody { display: block; }
.aq-compare-table--list tr {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
}
.aq-compare-table--list tr > * { width: auto; }
.aq-compare-table--list tr > :first-child { width: auto; }

/* Tab button (--tabs, phones) */
.aq-compare-table__tab {
  appearance: none; flex: none; width: var(--space-32); margin: 0; cursor: pointer;
  display: flex; align-items: flex-start; min-height: 44px;
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--line); border-radius: var(--radius-0);
  background: var(--surface-sunken);
  font: 500 13px/18px var(--font-sans); text-align: left; color: var(--ink-muted);
  overflow-wrap: break-word;
}
.aq-compare-table__tab[aria-pressed="true"] {
  background: var(--surface-raised); color: var(--ink);
  border-color: var(--line-strong); box-shadow: inset 0 2px 0 var(--flow);
}

@container (max-width: 860px) {
  /* Phones: no frame, no sideways scroll, no tabs. Each row is a record on a hairline: index and title (the row label),
     then one line per other column, "Label  value", the label in small muted type. Link-only columns (__go) end the
     record as a plain link. The column heads stay for screen readers only. */
  .aq-compare-table { padding: 0; border: 0; background: none; }
  .aq-compare-table__table,
  .aq-compare-table__table tbody,
  .aq-compare-table__table tr,
  .aq-compare-table__table th,
  .aq-compare-table__table td { display: block; width: auto; }
  .aq-compare-table__table { background: none; border: 0; border-bottom: 1px solid var(--line); }
  .aq-compare-table__table tr > :first-child { width: auto; }
  .aq-compare-table__table thead {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  .aq-compare-table__table tbody tr { padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .aq-compare-table__table th,
  .aq-compare-table__table td { padding: 0; border: 0; }
  .aq-compare-table__table tbody tr:last-child > * { border: 0; }
  /* Title line: the shared index in the left column, the row label beside it */
  .aq-compare-table__table tbody th { position: relative; padding-left: calc(var(--space-8) + var(--space-3)); font: 500 16px/24px var(--font-sans); color: var(--ink); }
  .aq-compare-table__table tbody th::before { position: absolute; left: 0; top: 0; margin: 0; }
  .aq-compare-table__table tbody td { margin-top: 0; padding-left: calc(var(--space-8) + var(--space-3)); font-size: 14px; line-height: 22px; }
  .aq-compare-table__table tbody td[data-empty] { display: none; }
  .aq-compare-table__k { display: inline; margin-right: var(--space-2); font: 500 13px/22px var(--font-sans); color: var(--ink-muted); }
  .aq-compare-table__k::after { content: ":"; }
  .aq-compare-table__table td.aq-compare-table__go { margin-top: var(--space-1); }

  /* Tabs (four or more value columns): one strip of tabs that scrolls inside itself, never two lines; each row the
     label left (13/20 ink-muted) and the chosen column's value right. */
  .aq-compare-table--tabs .aq-compare-table__tabs { display: flex; gap: var(--space-1); margin-bottom: var(--space-2); overflow-x: auto; scrollbar-width: thin; overscroll-behavior-x: contain; }
  .aq-compare-table--tabs .aq-compare-table__table tbody tr { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); column-gap: var(--space-4); align-items: baseline; }
  .aq-compare-table--tabs .aq-compare-table__table tbody th { padding-left: 0; font: 500 13px/20px var(--font-sans); color: var(--ink-muted); }
  .aq-compare-table--tabs .aq-compare-table__table tbody th::before { display: none; }
  .aq-compare-table--tabs .aq-compare-table__table tbody td { grid-column: 2; margin: 0; padding-left: 0; }
  .aq-compare-table--tabs .aq-compare-table__table tbody td[data-empty] { display: block; }
  .aq-compare-table--tabs[data-col="1"] tbody td:not(:nth-child(2)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="2"] tbody td:not(:nth-child(3)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="3"] tbody td:not(:nth-child(4)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="4"] tbody td:not(:nth-child(5)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="5"] tbody td:not(:nth-child(6)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="6"] tbody td:not(:nth-child(7)):not(.aq-compare-table__go) { display: none; }

  /* List variant (two columns): label above value */
  .aq-compare-table--list .aq-compare-table__table tbody th { padding-left: 0; font: 500 13px/20px var(--font-sans); color: var(--ink-muted); }
  .aq-compare-table--list .aq-compare-table__table tbody th::before { display: none; }
  .aq-compare-table--list .aq-compare-table__table tbody td { padding-left: 0; }
}

/* ---------- KeyFacts: the numbers a page stands on, as a measurement strip ---------- */
/* One framed strip between two rulers (tick bands inside the top and bottom of the frame). Each fact is a cell:
   the name, a large mono figure with its unit set smaller beside it, and the source standard on the last line.
   Small round fixings sit where the cell dividers meet the rulers, like the screws of a data plate.
   Rulers and fixings are CSS only. No index: facts are not a sequence. */
.aq-key-facts {
  position: relative; margin: 0;
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr);
  padding: var(--space-3) 0;
  border: 1px solid var(--line-strong);
  background-color: var(--surface);
  /* Rulers: major ticks every space-16, minor every space-2, top edge and bottom edge */
  background-image:
    repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px var(--space-16)),
    repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px var(--space-2)),
    repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px var(--space-16)),
    repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px var(--space-2));
  background-repeat: no-repeat;
  background-size: 100% var(--space-2), 100% var(--space-1), 100% var(--space-2), 100% var(--space-1);
  background-position: var(--space-4) top, var(--space-4) top, var(--space-4) bottom, var(--space-4) bottom;
}

.aq-key-facts > div {
  position: relative; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-3);
  padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
  border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
}
.aq-key-facts > div + div { border-left: 1px solid var(--line); }

/* Fixings: a small ring on each divider where it meets the top and bottom ruler; the strip's right end gets the dl's own */
.aq-key-facts > div::before, .aq-key-facts > div::after,
.aq-key-facts::before, .aq-key-facts::after {
  content: ""; position: absolute; z-index: 1;
  width: var(--space-2); height: var(--space-2); box-sizing: border-box;
  border: 1px solid var(--line-strong); border-radius: var(--radius-pill); background: var(--surface);
  pointer-events: none;
}
.aq-key-facts > div::before { top: 0; left: 0; transform: translate(-50%, -50%); }
.aq-key-facts > div::after { bottom: 0; left: 0; transform: translate(-50%, 50%); }
.aq-key-facts::before { top: var(--space-3); right: 0; transform: translate(50%, -50%); }
.aq-key-facts::after { bottom: var(--space-3); right: 0; transform: translate(50%, 50%); }

/* Index and name */
.aq-key-facts dt {
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}


/* Figure with its comparator and unit */
.aq-key-facts dd { margin: 0; }
.aq-key-facts__value, .aq-key-facts dd:first-of-type {
  font: 300 clamp(32px, 3.6cqi, 48px)/1.1 var(--font-mono); letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; word-spacing: -0.25em; color: var(--ink);
}
.aq-key-facts:has(> :nth-child(5)) dd:first-of-type { font-size: clamp(26px, 2.5cqi, 36px); }
.aq-key-facts__fig { overflow-wrap: anywhere; }
/* Unconfirmed ranges ("[500–20,000]") are long: set them smaller so they stay on one line in a narrow cell */
.aq-key-facts__fig .aq-ph { font-size: 0.6em; letter-spacing: 0; vertical-align: 0.2em; }
.aq-key-facts__cmp { font-size: 0.66em; letter-spacing: 0; color: var(--ink-muted); }
.aq-key-facts__unit { display: inline-block; font: 400 max(14px, 0.42em)/1.2 var(--font-mono); letter-spacing: 0; color: var(--ink-muted); }

/* Source standard, on the cell's last line */
.aq-key-facts dd.aq-key-facts__src {
  margin-top: auto; padding-top: var(--space-2);
  border-top: 1px dashed var(--line);
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.02em; color: var(--ink-muted);
  overflow-wrap: anywhere;
}

.aq-hero .aq-key-facts { margin-top: var(--space-16); }

@container (max-width: 860px) {
  /* Phones: a compact 2 x 2 (or 2 x n) grid between the same rulers; no fixings */
  .aq-key-facts { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .aq-key-facts > div { gap: var(--space-2); padding: var(--space-3); border-bottom: 0; }
  .aq-key-facts > div + div { border-left: 0; }
  .aq-key-facts > div:nth-child(even) { border-left: 1px solid var(--line); }
  .aq-key-facts > div:nth-child(n+3) { border-top: 1px solid var(--line); }
  .aq-key-facts > div:last-child, .aq-key-facts > div:nth-last-child(2):nth-child(odd) { border-bottom: 1px solid var(--line); }
  .aq-key-facts > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .aq-key-facts > div::before, .aq-key-facts > div::after, .aq-key-facts::before, .aq-key-facts::after { content: none; }
  .aq-key-facts dt { font-size: 11px; line-height: 15px; letter-spacing: 0.06em; }
  .aq-key-facts dd:first-of-type, .aq-key-facts:has(> :nth-child(5)) dd:first-of-type { font-size: 22px; line-height: 1.15; }
  .aq-key-facts dd.aq-key-facts__src { font-size: 11px; line-height: 15px; }
  .aq-hero .aq-key-facts { margin-top: var(--space-8); }
}

/* ---------- SpecTable ---------- */
/* Shared: caption, header labels, cell type. */
.aq-spec { width: 100%; border-collapse: collapse; font-family: var(--font-sans); color: var(--ink); }
.aq-spec caption { text-align: left; padding-bottom: var(--space-3); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-spec th, .aq-spec td { text-align: left; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); vertical-align: top; }
.aq-spec thead th { background: var(--surface-sunken); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-spec tbody th { font: 400 16px/24px var(--font-sans); color: var(--ink); }
.aq-spec__value { font: 400 14px/20px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: break-word; }
.aq-spec__method { font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }

/* Spec sheet (default): a two-column specification matrix with the critical row as a full-width band.
   Table elements change display, so the renderer also sets explicit ARIA table roles. */
.aq-spec:not(.aq-spec--compare) { display: block; }
/* The caption is the section eyebrow on screen (blocks/spec.js); here it stays for screen readers only */
.aq-spec:not(.aq-spec--compare) caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; padding: 0; }
.aq-spec:not(.aq-spec--compare) thead { display: block; background: var(--surface-sunken); border: 1px solid var(--line); }
.aq-spec:not(.aq-spec--compare) thead tr { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); padding: var(--space-2) var(--space-6); }
.aq-spec:not(.aq-spec--compare) thead th { padding: 0; border: 0; background: none; }
.aq-spec:not(.aq-spec--compare) thead th + th::before { content: "·"; content: "·" / ""; margin-right: var(--space-2); }
.aq-spec:not(.aq-spec--compare) tbody { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); padding-inline: var(--space-6); background: var(--surface-raised); border: 1px solid var(--line); border-top: 0; }
.aq-spec:not(.aq-spec--compare) tbody tr {
  display: grid; grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas: "p s" "v v" "m m";
  row-gap: var(--space-1); column-gap: var(--space-4);
  padding-block: var(--space-4); border-top: 1px solid var(--line); margin-top: -1px;
}
.aq-spec:not(.aq-spec--compare) tbody tr > * { display: block; padding: 0; border: 0; }
.aq-spec:not(.aq-spec--compare) tbody th { grid-area: p; font: 400 16px/24px var(--font-sans); }
.aq-spec:not(.aq-spec--compare) .aq-spec__value { grid-area: v; font: 400 14px/20px var(--font-mono); font-variant-numeric: tabular-nums; }
/* Placeholders keep their style but at the row's text size */
.aq-spec .aq-spec__value .aq-ph { font-size: inherit; }
.aq-spec:not(.aq-spec--compare) .aq-spec__method { grid-area: m; font: 400 14px/20px var(--font-sans); }
.aq-spec:not(.aq-spec--compare) .aq-spec__method:empty { display: none; }
.aq-spec:not(.aq-spec--compare) .aq-spec__status { grid-area: s; }

/* Critical rows. Rows keep their source order. hl rows at the top (is-lead) are full-width bands, their value one step
   larger (readout size is for KeyFacts and Readout only); an hl row further down is tinted in place, same rule and tint. */
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead {
  grid-column: 1 / -1;
  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  grid-template-areas: "p v" "m v" "s v";
  grid-template-rows: auto auto 1fr;
  column-gap: var(--space-8);
  margin-inline: calc(var(--space-6) * -1); margin-top: 0;
  padding: var(--space-6); border-top: 0; border-left: 2px solid var(--flow);
  background: var(--flow-tint);
}
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr.is-lead { border-top: 1px solid var(--surface-raised); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr:not(.is-lead), .aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr:not(.is-lead) + tr { border-top: 0; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead th { font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead .aq-spec__value { align-self: center; font: 400 20px/28px var(--font-mono); letter-spacing: -0.01em; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead .aq-spec__status { justify-self: start; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-highlight:not(.is-lead) { margin-inline: calc(var(--space-4) * -1); padding-inline: calc(var(--space-4) - 2px) var(--space-4); border-left: 2px solid var(--flow); background: var(--flow-tint); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-highlight .aq-spec__method { color: var(--ink-muted); }

/* Row link (rows[].link): a quiet page link under the basis, "FAT and SAT →" */
.aq-spec__link { display: block; margin-top: var(--space-1); font: 500 14px/20px var(--font-sans); color: var(--flow); text-decoration: none; }
.aq-spec__link::after { content: "\a0\2192"; content: "\a0\2192" / ""; }
.aq-spec__link:hover { text-decoration: underline; text-underline-offset: 3px; }
.aq-spec__link:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Status words for results */
.aq-status { display: inline-flex; align-items: center; gap: var(--space-1); font: 500 14px/24px var(--font-sans); }
.aq-status--pass { color: var(--pass); }
.aq-status--caution { color: var(--caution); }
.aq-status--fail { color: var(--fail); }

@container (max-width: 860px) {
  /* Phone: compact two-line rows on hairlines. Line 1 the parameter; line 2 the value, then " · " and the basis in small
     muted type. The column-label strip is hidden on screen (kept for screen readers). */
  .aq-spec:not(.aq-spec--compare) thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-spec:not(.aq-spec--compare) tbody { display: block; padding-inline: 0; background: none; border: 0; border-bottom: 1px solid var(--line); }
  .aq-spec:not(.aq-spec--compare) tbody tr,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight { display: block; margin: 0; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight:not(.is-lead) { margin: 0; padding-inline: var(--space-3); border-top: 0; }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight + tr:not(.is-highlight) { border-top: 0; }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight + tr.is-highlight { border-top: 1px solid var(--surface); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr:not(.is-lead) + tr:not(.is-highlight) { border-top: 1px solid var(--line); }
  .aq-spec:not(.aq-spec--compare) tbody th,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead th { display: block; margin-bottom: var(--space-1); font: 400 15px/22px var(--font-sans); }
  .aq-spec:not(.aq-spec--compare) .aq-spec__value,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead .aq-spec__value { display: inline; font: 400 14px/22px var(--font-mono); letter-spacing: 0; }
  .aq-spec:not(.aq-spec--compare) .aq-spec__method,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight .aq-spec__method { display: inline; font-size: 12px; line-height: 18px; }
  .aq-spec__link { display: inline; margin: 0; font-size: 12px; line-height: 18px; }
  .aq-spec:not(.aq-spec--compare) .aq-spec__method:not(:empty)::before { content: "\a0\b7\a0"; content: "\a0\b7\a0" / ""; color: var(--ink-subtle); }
}

/* ---------- StandardTag ---------- */
.aq-tag {
  display: inline-flex; align-items: center; height: 28px; padding: 0 var(--space-3);
  border: 1px solid var(--line-strong); border-radius: var(--radius-pill);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--ink);
  background: transparent; white-space: nowrap; text-decoration: none;
}
a.aq-tag:hover { border-color: var(--ink); }
.aq-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

/* Narrow containers: a long standard name wraps inside its tag */
@container (max-width: 860px) {
  .aq-tag { max-width: 100%; white-space: normal; height: auto; }
}

/* ---------- EnquiryForm: the enquiry as an engineering specification data sheet ---------- */
/* A drawing frame (double rule, ruler ticks on the top and left edges) around a title row, numbered fieldsets
   (1.0, 2.0) with numbered items (1.1, 1.2), one submit band and a revision strip along the bottom edge. */
.aq-form {
  position: relative;
  display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8);
  max-width: 880px; min-width: 0; box-sizing: border-box;
  padding: var(--space-12) var(--space-8) 0 var(--space-12);
  background: var(--surface-raised);
  border: 1px solid var(--line-strong);
  box-shadow: inset 0 0 0 var(--space-1) var(--surface-raised), inset 0 0 0 calc(var(--space-1) + 1px) var(--line);
}
/* Ruler ticks: a major tick every 96 px and a minor one every 24 px, top edge then left edge */
.aq-form::before, .aq-form::after { content: ""; position: absolute; pointer-events: none; background-repeat: no-repeat; }
.aq-form::before {
  top: var(--space-3); left: var(--space-12); right: var(--space-8); height: var(--space-3);
  background-image:
    repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px var(--space-24)),
    repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px var(--space-6));
  background-size: 100% 100%, 100% 50%;
}
.aq-form::after {
  top: var(--space-12); bottom: var(--space-16); left: var(--space-3); width: var(--space-3);
  background-image:
    repeating-linear-gradient(180deg, var(--line-strong) 0 1px, transparent 1px var(--space-24)),
    repeating-linear-gradient(180deg, var(--line) 0 1px, transparent 1px var(--space-6));
  background-size: 100% 100%, 50% 100%;
}
.aq-form .aq-field { max-width: none; }
.aq-form__full { grid-column: 1 / -1; }

/* Title row */
.aq-form__title {
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6);
  margin: 0; padding-bottom: var(--space-3);
  border-bottom: 2px solid var(--ink);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--ink-muted);
}
.aq-form__title > :first-child { color: var(--ink); }

/* Numbered sections */
.aq-form__section { border: 0; margin: 0; padding: 0; min-width: 0; }
.aq-form__legend {
  float: left; width: 100%; box-sizing: border-box;
  display: flex; align-items: baseline; gap: var(--space-3);
  margin: 0 0 var(--space-6); padding: var(--space-2) var(--space-3);
  background: var(--surface-sunken);
  border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line);
  font: 500 15px/24px var(--font-sans); color: var(--ink);
}
.aq-form__num { font: 500 13px/24px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--flow); }
.aq-form__grid { clear: both; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
.aq-form__ref {
  margin-right: var(--space-2);
  font: 400 12px/20px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-subtle);
}
.aq-form .aq-field__input { border-radius: var(--radius-0); }

/* Checkbox groups: each option is a 44 px row cell; a ticked cell takes the flow edge */
.aq-form .aq-checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: var(--space-2); }
.aq-form .aq-checks label {
  display: flex; gap: var(--space-3); align-items: center;
  min-height: 44px; box-sizing: border-box; padding: var(--space-2) var(--space-3);
  background: var(--surface); border: 1px solid var(--line);
  cursor: pointer; overflow-wrap: anywhere;
}
.aq-form .aq-checks label:hover { border-color: var(--ink-muted); }
.aq-form .aq-checks label:has(:checked) { border-color: var(--flow); background: var(--flow-tint); box-shadow: inset 2px 0 0 var(--flow); }
.aq-form .aq-checks input { flex: none; width: var(--space-4); height: var(--space-4); margin: 0; accent-color: var(--flow); }
.aq-form .aq-checks input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Hidden conditional fields, file upload */
.aq-form [hidden] { display: none; }
.aq-field__file { font: 400 14px/22px var(--font-sans); color: var(--ink); padding: var(--space-4); border: 1px dashed var(--line-strong); border-radius: var(--radius-0); width: 100%; min-width: 0; background: var(--surface-sunken); }
.aq-field__file:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Stepped variant: each step is one numbered section; the progress list sits under the title row */
.aq-form--steps { gap: var(--space-6); }
.aq-form__progress { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin: 0; padding: 0; list-style: none; counter-reset: aq-form-step; }
.aq-form__progress li { counter-increment: aq-form-step; font: 500 14px/20px var(--font-sans); color: var(--ink-subtle); }
.aq-form__progress li::before { content: counter(aq-form-step) ".0 "; font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--ink-subtle); }
.aq-form__progress li[aria-current="step"], .aq-form__progress li[aria-current="step"]::before { color: var(--flow); }
.aq-form__step[hidden] { display: none; }
.aq-form__step > .aq-form__actions { margin-top: var(--space-8); }
.aq-form__note { margin: var(--space-4) 0 0; }
.aq-form__step > .wform-msg { display: block; margin-top: var(--space-2); }

/* Submit band and revision strip */
.aq-form__actions {
  display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap;
  padding-top: var(--space-6); border-top: 1px solid var(--line-strong);
}
.aq-form__strip {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 calc(-1 * var(--space-8)) 0 calc(-1 * var(--space-12));
  border-top: 1px solid var(--line-strong);
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--ink-muted);
}
.aq-form__strip > span { padding: var(--space-2) var(--space-3); min-width: 0; overflow-wrap: anywhere; }
.aq-form__strip > span + span { border-left: 1px solid var(--line-strong); }
.aq-form__strip > :last-child { text-align: right; }

@container (max-width: 860px) {
  /* Phones: narrower frame, ticks only on the top edge, one column, full-width submit */
  .aq-form { gap: var(--space-6); padding: var(--space-8) var(--space-4) 0; }
  .aq-form::before { top: var(--space-2); left: var(--space-4); right: var(--space-4); height: var(--space-3); }
  .aq-form::after { display: none; }
  .aq-form__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-form__legend { margin-bottom: var(--space-4); }
  .aq-form__submit { width: 100%; justify-content: center; }
  .aq-form__strip { margin: 0 calc(-1 * var(--space-4)); }
  .aq-form__strip > span { padding: var(--space-2); }
}

/* ---------- TextField ---------- */
.aq-field { display: grid; gap: var(--space-2); max-width: 420px; min-width: 0; }
.aq-field__label { font: 500 14px/20px var(--font-sans); color: var(--ink); }
.aq-field__optional { font-weight: 400; color: var(--ink-muted); }
.aq-field__input {
  width: 100%; height: 44px; padding: 0 var(--space-4); box-sizing: border-box;
  background: var(--surface-raised); color: var(--ink);
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  font: 400 16px/24px var(--font-sans);
}
textarea.aq-field__input { height: auto; min-height: 120px; padding: var(--space-3) var(--space-4); resize: vertical; }
.aq-field__input::placeholder { color: var(--ink-subtle); }
.aq-field__input:hover { border-color: var(--ink-muted); }
.aq-field__input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-color: var(--ink); }
.aq-field__suffix { position: relative; }
.aq-field__suffix .aq-field__input { padding-right: 64px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.aq-field__unit { position: absolute; right: var(--space-4); top: 50%; transform: translateY(-50%); font: 400 14px/20px var(--font-mono); color: var(--ink-muted); }
.aq-field__help { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }
.aq-field.is-error .aq-field__input { border-color: var(--fail); }
.aq-field.is-error .aq-field__help { color: var(--fail); }
.aq-fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
.aq-checks { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
.aq-checks label { display: inline-flex; gap: var(--space-2); align-items: center; font: 400 15px/24px var(--font-sans); color: var(--ink); }
