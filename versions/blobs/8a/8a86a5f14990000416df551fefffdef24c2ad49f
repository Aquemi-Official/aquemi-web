/* ---------- NavBar and phone menu ---------- */
/* Like the tab strip of a drawing set: ruled cells, a mono index number on every section, a corner-marked frame round the one action. */
.aq-nav {
  position: relative; display: flex; align-items: center; gap: var(--space-6);
  height: 72px; padding: 0 var(--space-8);
  background: var(--surface); border-bottom: 1px solid var(--line);
}
.aq-nav__home { display: flex; align-items: center; align-self: stretch; padding-right: var(--space-6); border-right: 1px solid var(--line); }
.aq-nav__logo { width: 112px; height: auto; }
.aq-nav__logo--lockup { width: 152px; }

.aq-nav__links { display: flex; align-self: stretch; margin: 0; padding: 0; list-style: none; flex: 1; min-width: 0; }
.aq-nav__links li { display: flex; }
.aq-nav__links li + li { border-left: 1px solid var(--line); }
.aq-nav__links a {
  position: relative; display: flex; flex-direction: column; justify-content: center; gap: var(--space-1);
  padding: 0 var(--space-4); color: var(--ink-muted); text-decoration: none; font: 500 14px/20px var(--font-sans); white-space: nowrap;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__num { font: 500 11px/12px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-subtle); font-variant-numeric: tabular-nums; }
.aq-nav__label { display: block; }
.aq-nav__links a:hover { color: var(--ink); }
.aq-nav__links a[aria-current="page"] { color: var(--ink); background: var(--surface-sunken); }
.aq-nav__links a[aria-current="page"] .aq-nav__num { color: var(--flow); }
.aq-nav__links a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; border-bottom: 2px solid var(--flow); }
.aq-nav__links a:focus-visible { outline-offset: -2px; }

/* Corner-marked frame: four L-shaped registration marks drawn in currentColor round the button */
.aq-nav__frame {
  display: inline-flex; padding: var(--space-1); color: var(--line-strong);
  background:
    linear-gradient(currentColor, currentColor) left top / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) left top / 1px var(--space-2),
    linear-gradient(currentColor, currentColor) right top / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) right top / 1px var(--space-2),
    linear-gradient(currentColor, currentColor) left bottom / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) left bottom / 1px var(--space-2),
    linear-gradient(currentColor, currentColor) right bottom / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) right bottom / 1px var(--space-2);
  background-repeat: no-repeat;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__frame:hover, .aq-nav__frame:focus-within { color: var(--flow); }
.aq-nav__toggle { display: none; }

/* Phone menu: numbered sections, a rule, the page's section jump, then the proposal button */
.aq-menu { display: none; }
.aq-menu__list { display: grid; margin: 0; padding: 0; list-style: none; }
.aq-menu__list a {
  display: flex; align-items: baseline; gap: var(--space-3);
  padding: var(--space-3) var(--space-2); color: var(--ink); text-decoration: none;
  font: 400 20px/28px var(--font-sans); border-bottom: 1px solid var(--line);
}
.aq-menu__list .aq-nav__num { font-size: 12px; line-height: 16px; min-width: var(--space-6); }
.aq-menu__list--jump a { padding-block: var(--space-2); font: 400 16px/24px var(--font-sans); color: var(--ink-muted); }
.aq-menu__list a[aria-current] { color: var(--ink); background: var(--surface-sunken); box-shadow: inset 2px 0 0 var(--flow); }
