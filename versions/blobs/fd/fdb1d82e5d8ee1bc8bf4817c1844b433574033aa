/* ---------- NotesRegister: technical notes as a drawing register (block "register") ----------
   Drawn on a cream plate (wPlate light, title block "Aquemi | Notes register"). Desktop: a framed filter bar of
   [bracketed] mono topic chips across the top; the featured note in a framed panel on the left with an equipment Spot
   vignette, the register on the right as a fully ruled revision table with uppercase mono column heads.
   Phones: the chip bar scrolls sideways inside its own frame, the panel sits above, rows keep the register's rules:
   a mono number column, then the title with mono meta (topic · standard · status). */
.aq-notes-register__plate { min-width: 0; }
.aq-notes-register {
  display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
  grid-template-areas: "filter filter" "count count" "feature reg"; column-gap: var(--space-6); align-items: start;
}

/* Filter bar: a framed strip, "Filter" caption, chips as [bracketed] mono tags */
.aq-notes-register__filter {
  grid-area: filter; display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-1); margin-bottom: var(--space-6);
  padding: 0 var(--space-2); border: 1px solid var(--line-strong); background: var(--surface-raised);
}
.aq-notes-register__fk { padding: 0 var(--space-2); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-notes-register__fk::after { content: ":"; }
.aq-notes-register__chip {
  display: inline-flex; align-items: center; gap: var(--space-1); min-height: 44px; padding: 0 var(--space-2); margin: 0;
  background: transparent; border: 0; border-radius: var(--radius-sm); cursor: pointer;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap;
}
.aq-notes-register__chip::before { content: "["; color: var(--ink-subtle); }
.aq-notes-register__chip::after { content: "]"; color: var(--ink-subtle); }
.aq-notes-register__chip span { color: var(--ink-subtle); }
.aq-notes-register__chip:hover { color: var(--ink); }
.aq-notes-register__chip:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-notes-register__chip[aria-pressed="true"] { background: var(--flow-tint); color: var(--ink); box-shadow: inset 0 -2px 0 var(--flow); }
.aq-notes-register__chip[aria-pressed="true"]::before, .aq-notes-register__chip[aria-pressed="true"]::after, .aq-notes-register__chip[aria-pressed="true"] span { color: var(--flow); }
.aq-notes-register__count { grid-area: count; position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* Featured note: a framed panel with a mono title strip, like a drawing's title block, and a Spot vignette */
.aq-notes-register__feature {
  grid-area: feature; display: flex; flex-direction: column; gap: var(--space-4);
  padding: var(--space-6); border: 1px solid var(--line-strong); background: var(--surface-raised); box-shadow: inset 0 2px 0 var(--flow);
}
.aq-notes-register__flabel { display: flex; flex-wrap: wrap; margin: 0 0 var(--space-2); border: 1px solid var(--line); width: fit-content; }
.aq-notes-register__flabel span { padding: var(--space-1) var(--space-3); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-notes-register__flabel span + span { border-left: 1px solid var(--line); }
.aq-notes-register__flabel span:first-child { color: var(--flow); }
.aq-notes-register__ft { margin: 0; font: 400 22px/30px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-notes-register__fd { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
/* Phones set .aq-tag to height: auto; keep its pill padded */
.aq-notes-register__feature .aq-tag { padding-block: var(--space-1); }
.aq-notes-register__vig {
  display: flex; justify-content: center; padding: var(--space-4); margin-top: var(--space-2);
  border: 1px dashed var(--line-strong); background: var(--surface);
}
.aq-notes-register__spot { background-color: var(--ink-muted); }
.aq-notes-register__go { margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--line); font: 500 12px/18px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-notes-register__go a { margin-left: var(--space-1); text-decoration: none; }
.aq-notes-register__go a:hover { text-decoration: underline; }

/* Register: a revision table, every cell ruled */
.aq-notes-register__reg { grid-area: reg; min-width: 0; }
.aq-notes-register__table { width: 100%; border-collapse: collapse; border: 1px solid var(--line-strong); background: var(--surface-raised); }
.aq-notes-register__table thead th {
  padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line-strong); text-align: center; vertical-align: middle;
  background: var(--surface-sunken);
  font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-notes-register__table tbody tr { position: relative; border-bottom: 1px solid var(--line-strong); }
.aq-notes-register__table tbody tr[hidden] { display: none; }
.aq-notes-register__table tbody tr:hover { background: var(--flow-tint); }
.aq-notes-register__table td, .aq-notes-register__table tbody th { padding: var(--space-3); text-align: left; vertical-align: top; }
.aq-notes-register__table th + th, .aq-notes-register__table td + td, .aq-notes-register__table td + th, .aq-notes-register__table th + td { border-left: 1px solid var(--line-strong); }
.aq-notes-register__date, .aq-notes-register__no, .aq-notes-register__topic, .aq-notes-register__std {
  font: 400 12px/22px var(--font-mono); letter-spacing: 0.02em; color: var(--ink-muted);
}
.aq-notes-register__date, .aq-notes-register__no { white-space: nowrap; }
.aq-notes-register__topic { text-transform: uppercase; letter-spacing: 0.06em; font-size: 11px; }
.aq-notes-register__std { width: 24%; color: var(--ink); }
.aq-notes-register__planned { color: var(--ink-subtle); text-transform: uppercase; letter-spacing: 0.06em; font-size: 11px; }
.aq-notes-register__t { font: 400 15px/22px var(--font-sans); color: var(--ink); text-wrap: pretty; }
.aq-notes-register__t a { color: var(--ink); text-decoration: none; }
.aq-notes-register__t a::after { content: ""; position: absolute; inset: 0; }
.aq-notes-register__t a:hover { color: var(--flow); }
.aq-notes-register__table tr.is-featured .aq-notes-register__no { color: var(--flow); }
/* A topic filter shows every matching row, folded or not, and hides the fold button */
.aq-notes-register .aq-fold.is-filtered .aq-fold-x { display: table-row; }
.aq-notes-register .aq-fold.is-filtered .aq-fold-x[hidden] { display: none; }
.aq-notes-register .aq-fold.is-filtered .aq-fold__btn { display: none; }

@container (max-width: 860px) {
  .aq-notes-register { grid-template-columns: minmax(0, 1fr); grid-template-areas: "filter" "count" "feature" "reg"; }
  /* Chips scroll sideways inside their own framed bar, never the page */
  .aq-notes-register__filter { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-bottom: var(--space-4); }
  .aq-notes-register__filter::-webkit-scrollbar { display: none; }
  .aq-notes-register__chip, .aq-notes-register__fk { flex: none; }
  .aq-notes-register__feature { padding: var(--space-4); gap: var(--space-3); margin-bottom: var(--space-6); }
  .aq-notes-register__ft { font-size: 19px; line-height: 26px; }
  .aq-notes-register__vig { padding: var(--space-3); }
  .aq-notes-register__spot { width: var(--space-24); height: var(--space-24); }
  /* Rows keep the ruled register: a mono number column, then title and mono meta */
  .aq-notes-register__table, .aq-notes-register__table tbody { display: block; }
  .aq-notes-register__table thead { display: none; }
  .aq-notes-register__table tbody tr { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) auto; column-gap: var(--space-3); padding-right: var(--space-3); }
  .aq-notes-register__table td, .aq-notes-register__table tbody th { padding: 0; border-left: 0 !important; }
  .aq-notes-register__no { grid-column: 1; grid-row: 1 / 4; padding: var(--space-3) var(--space-1) !important; border-right: 1px solid var(--line-strong); text-align: center; }
  .aq-notes-register__t { grid-column: 2 / -1; grid-row: 1; padding: var(--space-3) 0 var(--space-1) !important; font-size: 15px; line-height: 22px; }
  .aq-notes-register__topic, .aq-notes-register__std, .aq-notes-register__date { width: auto; line-height: 18px; font-size: 11px; }
  .aq-notes-register__topic { grid-column: 2; grid-row: 2; }
  .aq-notes-register__date { grid-column: 3; grid-row: 2; text-align: right; }
  .aq-notes-register__std { grid-column: 2 / -1; grid-row: 3; padding: var(--space-1) 0 var(--space-3) !important; font-size: 12px; }
  .aq-notes-register .aq-fold.is-filtered .aq-fold-x { display: grid; }
}

/* Phones: every label people read is 12 px or more */
@container (max-width: 860px) {
  .aq-notes-register__fk, .aq-notes-register__flabel span, .aq-notes-register__planned, .aq-notes-register__topic { font-size: 12px; }
}
