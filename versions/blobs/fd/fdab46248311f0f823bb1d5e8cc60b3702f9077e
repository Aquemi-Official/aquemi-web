/* ---------- StrataRun: one water run stepping down a terrace of paper slabs (look "strata-run") ----------
   Desktop: the stage labels in a row of equal columns over the drawing; each label's left hairline is the top of its
   leader, which the svg carries on down to the part (the svg is as wide as the row, one column per stage). Slabs are
   stacked sheets: raised tops, sunken sides, a hairline at every sheet edge. Behind them, a cut-paper stream in
   flow-tint with its own thickness edge. Phones: labels stack down a vertical pipe, each with its own slab drawing. */
.aq-strata-run-sec { overflow: hidden; }
.aq-strata-run { position: relative; display: grid; gap: 0; }
.aq-strata-run__stack { pointer-events: none; }
.aq-strata-run__stages {
  list-style: none; margin: 0; padding: 0; position: relative; z-index: 1;
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr);
}
.aq-strata-run__stage {
  position: relative; display: grid; align-content: start; gap: var(--space-1);
  padding: 0 var(--space-4) var(--space-4) var(--space-3);
  border-left: 1px solid var(--line-strong);
  transition: border-color 200ms ease;
}
.aq-strata-run__stage .aq-index { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--flow); }
.aq-strata-run__t { margin: 0; font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); }
.aq-strata-run__t a { color: inherit; text-decoration: none; padding-block: 10px; }
.aq-strata-run__t a::after { content: "→"; display: inline-block; margin-left: var(--space-2); color: var(--flow); transition: transform 200ms ease; }
.aq-strata-run__t a:hover::after, .aq-strata-run__t a:focus-visible::after { transform: translateX(3px); }
.aq-strata-run__t a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-strata-run__d { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--ink-muted); max-width: 24ch; }
.aq-strata-run__thumb { display: none; }
.aq-strata-run__stage.is-hot, .aq-strata-run__stage:hover { border-left-color: var(--flow); }

.aq-strata-run__fig { position: relative; margin-top: calc(-1 * var(--space-1)); }
.aq-strata-run__svg { display: block; width: 100%; height: auto; }
/* the slabs: stacked sheets */
.aq-strata-run__slab { fill: var(--surface-sunken); stroke: var(--line-strong); stroke-width: 1; stroke-linejoin: round; }
.aq-strata-run__slab.is-top { fill: var(--surface-raised); }
/* the stream behind, with its paper edge */
.aq-strata-run__stream { fill: var(--flow-tint); }
.aq-strata-run__edge { fill: var(--line); }
/* leaders and the monitoring bus */
.aq-strata-run__lead { fill: none; stroke: var(--line-strong); stroke-width: 1; transition: stroke 200ms ease; }
.aq-strata-run__dot { fill: var(--line-strong); transition: fill 200ms ease; }
.aq-strata-run__lead.is-hot { stroke: var(--flow); }
.aq-strata-run__dot.is-hot { fill: var(--flow); }
.aq-strata-run__bus { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-strata-run__node { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1; }
.aq-strata-run__bus-g.is-hot .aq-strata-run__bus, .aq-strata-run__bus-g.is-hot .aq-strata-run__node { stroke: var(--flow); }
.aq-strata-run__svg .aq-iso__part.is-hot .aq-iso__eq, .aq-strata-run__svg .aq-iso__part.is-hot .aq-iso__ln, .aq-strata-run__svg .aq-iso__part.is-hot .aq-iso__thin { stroke: var(--flow); }
.aq-strata-run__return .aq-iso__pipe-wall { stroke-dasharray: none; }

.aq-strata-run__base {
  display: flex; align-items: center; gap: var(--space-3); margin: var(--space-2) 0 0;
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-strata-run__base a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; border-bottom: 1px solid transparent; }
.aq-strata-run__base a::after { content: "→"; margin-left: var(--space-2); color: var(--flow); }
.aq-strata-run__base a:hover { color: var(--ink); }
.aq-strata-run__base a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-strata-run__bus-key { width: var(--space-12); height: 0; border-top: 1px dashed var(--line-strong); flex: none; }

@container (max-width: 860px) {
  .aq-strata-run__fig { display: none; }
  .aq-strata-run__stages { grid-auto-flow: row; grid-template-columns: minmax(0, 1fr); }
  /* the vertical pipe: twin walls with the water line down the middle, one stage per joint */
  .aq-strata-run__stage {
    grid-template-columns: minmax(0, 1fr) 112px; grid-template-rows: auto auto 1fr; column-gap: var(--space-3); row-gap: var(--space-1); align-items: start;
    border-left: 0; padding: 0 0 var(--space-6) var(--space-8);
  }
  .aq-strata-run__stage::before {
    content: ""; position: absolute; left: calc(var(--space-2) + 1px); top: 0; bottom: 0; box-sizing: border-box; width: 11px; padding: 0 3.25px;
    border-left: 1.5px solid var(--line-strong); border-right: 1.5px solid var(--line-strong);
    background: var(--flow); background-clip: content-box;
  }
  .aq-strata-run__stage::after {
    content: ""; position: absolute; left: calc(var(--space-2) - 3px); top: var(--space-1); width: 13px; height: 13px;
    border: 1.5px solid var(--line-strong); background: var(--surface); border-radius: 50%;
  }
  .aq-strata-run__stage:last-child::before { bottom: auto; height: var(--space-2); }
  .aq-strata-run__stage > * { grid-column: 1; }
  .aq-strata-run__thumb { display: block; grid-column: 2; grid-row: 1 / span 3; }
  .aq-strata-run__mini { width: 100%; height: auto; }
  .aq-strata-run__d { max-width: none; }
  .aq-strata-run__base { padding-left: var(--space-8); }
}
