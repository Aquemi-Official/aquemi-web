/* ---------- MembraneAtlas: feed conditions as plates of what each does to a membrane surface ---------- */
/* Four columns; the heading takes the first cell, the plates fill the rest, hairlines between them like a printed atlas. */
.aq-membrane-atlas { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
.aq-membrane-atlas__head { padding: var(--space-6) var(--space-6) var(--space-8) 0; }
.aq-membrane-atlas__head .aq-h1 { font-size: 40px; line-height: 46px; letter-spacing: -0.03em; font-weight: 300; }
.aq-membrane-atlas__plates { display: contents; list-style: none; margin: 0; padding: 0; }
.aq-membrane-atlas__plate { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6) var(--space-6) var(--space-8);
  border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.aq-membrane-atlas__plate:nth-child(4n) { border-left: 0; padding-left: 0; }

/* The scope: a round micrograph under a reticle */
.aq-membrane-atlas__scope { position: relative; width: 100%; max-width: 240px; margin: 0 auto var(--space-2); }
.aq-membrane-atlas__fig { position: absolute; left: 0; top: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-membrane-atlas__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-membrane-atlas__svg * { vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.aq-membrane-atlas__field { fill: var(--surface-raised); }
.aq-membrane-atlas__rim { fill: none; stroke: var(--ink); stroke-width: 1.5; }
.aq-membrane-atlas__tick, .aq-membrane-atlas__cross { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-membrane-atlas__tex { fill: none; stroke: var(--line-strong); stroke-width: 0.75; opacity: 0.38; }
.aq-membrane-atlas__hole { fill: var(--ink); stroke: var(--ink); stroke-width: 1; }
.aq-membrane-atlas__crack { fill: none; stroke: var(--ink); stroke-width: 1; }
.aq-membrane-atlas__split { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 3 3; }
.aq-membrane-atlas__perm { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-membrane-atlas__dot { fill: var(--flow); }
.aq-membrane-atlas__rod { fill: var(--surface-raised); stroke: var(--ink); stroke-width: 1; }
.aq-membrane-atlas__cake { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; }
.aq-membrane-atlas__cake--fill { fill: var(--ink-muted); }
.aq-membrane-atlas__xtal { fill: var(--surface-sunken); stroke: var(--ink); stroke-width: 1; }
.aq-membrane-atlas__glass { fill: var(--surface-sunken); stroke: var(--ink); stroke-width: 1; }
.aq-membrane-atlas__glint { fill: none; stroke: var(--ink-muted); stroke-width: 0.75; }
.aq-membrane-atlas__rust { fill: var(--ink-muted); }
.aq-membrane-atlas__eps { fill: var(--surface-sunken); stroke: var(--ink-muted); stroke-width: 1; stroke-dasharray: 2 2; }
.aq-membrane-atlas__plate:hover .aq-membrane-atlas__rim { stroke: var(--flow); }

/* Text: the condition, then the effect and our design, each under a mono label */
.aq-membrane-atlas__t { margin: 0; font: 500 17px/24px var(--font-sans); color: var(--ink); }
.aq-membrane-atlas__dl { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-membrane-atlas__row { display: flex; flex-direction: column; gap: var(--space-1); }
.aq-membrane-atlas__row dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-membrane-atlas__row dd { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--ink-muted); }
.aq-membrane-atlas__row--ours { padding-left: var(--space-3); border-left: 2px solid var(--flow); }
.aq-membrane-atlas__row--ours dt { color: var(--flow); }
.aq-membrane-atlas__row--ours dd { color: var(--ink); }

/* Fold: desktop shows every plate; phones keep the block's fold */
.aq-fold:not(.is-open) .aq-membrane-atlas__plate.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-membrane-atlas) > .aq-fold__btn { display: none; }

@container (max-width: 1100px) {
  .aq-membrane-atlas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .aq-membrane-atlas__head { grid-column: 1 / -1; }
  .aq-membrane-atlas__plate:nth-child(4n) { border-left: 1px solid var(--line); padding-left: var(--space-6); }
  .aq-membrane-atlas__plate:nth-child(2n+1) { border-left: 0; padding-left: 0; }
}
@container (max-width: 860px) {
  .aq-membrane-atlas { grid-template-columns: minmax(0, 1fr); }
  .aq-membrane-atlas__head { padding: var(--space-4) 0 var(--space-6); }
  .aq-membrane-atlas__head .aq-h1 { font-size: 32px; line-height: 38px; }
  .aq-membrane-atlas__plate, .aq-membrane-atlas__plate:nth-child(n) { display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-2);
    padding: var(--space-6) 0; border-left: 0; }
  .aq-membrane-atlas__scope { grid-row: 1 / 3; margin: 0; }
  .aq-membrane-atlas__fig { position: static; display: block; margin-bottom: var(--space-1); }
  .aq-fold:not(.is-open) .aq-membrane-atlas__plate.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-membrane-atlas) > .aq-fold__btn { display: flex; }
}
