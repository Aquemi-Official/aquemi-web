/* ---------- SignalDial: an instrument schedule beside one multi-channel transmitter dial (look "signal-dial") ---------- */
/* Desktop: the table (left) and the dial (right) side by side; the dial's bezel turns (--sd-a, degrees) to bring the
   chosen channel under the index. Phones: the dial first, smaller; the rows stack under it. */
.aq-signal-dial {
  display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr); grid-template-areas: "table fig";
  column-gap: var(--space-16); align-items: center;
}
.aq-signal-dial__fig { grid-area: fig; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
.aq-signal-dial__table { grid-area: table; }

/* the dial */
.aq-signal-dial__dial {
  position: relative; width: 100%; max-width: 460px; aspect-ratio: 1; border-radius: 50%;
  background: var(--surface-raised); cursor: ew-resize; touch-action: pan-y; user-select: none; -webkit-user-select: none;
}
.aq-signal-dial__dial:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-2); }
.aq-signal-dial__dial.is-drag { cursor: grabbing; }
.aq-signal-dial__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.aq-signal-dial__rim { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-signal-dial__rim2 { fill: var(--surface); stroke: var(--line); stroke-width: 1; }
.aq-signal-dial__ring {
  transform: rotate(calc(var(--sd-a, 0) * 1deg)); transform-box: view-box; transform-origin: 200px 200px;
  transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
}
.aq-signal-dial__dial.is-drag .aq-signal-dial__ring { transition: none; }
.aq-signal-dial__tk { stroke: var(--line-strong); stroke-width: 1; opacity: 0.6; }
.aq-signal-dial__tk--mid { opacity: 1; }
.aq-signal-dial__tk--stop { stroke: var(--ink); stroke-width: 1.5; opacity: 1; }
.aq-signal-dial__tk--stop.is-on { stroke: var(--flow); stroke-width: 2.5; }
.aq-signal-dial__sn { font: 400 12px var(--font-mono); fill: var(--ink-subtle); text-anchor: middle; transition: fill 200ms ease; }
.aq-signal-dial__sn.is-on { fill: var(--flow); }
.aq-signal-dial__fine { fill: none; stroke: var(--line-strong); stroke-width: 1; opacity: 0.5; }
.aq-signal-dial__index { fill: var(--flow); stroke: var(--flow); stroke-width: 1.5; }

/* the readout on the face */
.aq-signal-dial__read {
  position: absolute; left: 50%; top: 50%; width: 58%; transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; text-align: center; pointer-events: none;
}
.aq-signal-dial__ch { font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-subtle); }
.aq-signal-dial__num { display: flex; align-items: baseline; gap: var(--space-2); color: var(--ink); }
.aq-signal-dial__digits { font: 300 clamp(56px, 7vw, 96px)/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
.aq-signal-dial__of { font: 400 13px/1 var(--font-mono); color: var(--ink-subtle); }
.aq-signal-dial__name { margin-top: var(--space-2); font: 400 18px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.aq-signal-dial__lim { align-self: stretch; height: 1px; margin: var(--space-3) calc(-1 * var(--space-4)) var(--space-2); background: var(--flow); }
.aq-signal-dial__val { font: 400 13px/18px var(--font-sans); color: var(--ink-muted); text-wrap: balance; }
.aq-signal-dial__tag {
  margin-top: var(--space-2); padding: 0 var(--space-2); border: 1px solid var(--line-strong);
  font: 400 11px/18px var(--font-mono); color: var(--ink-muted); white-space: normal;
}
.aq-signal-dial__tag[hidden] { display: none; }
.aq-signal-dial__read.is-tick > * { animation: aq-sd-tick 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
@keyframes aq-sd-tick { from { opacity: 0.2; transform: translateY(var(--sd-dir, 8px)); } to { opacity: 1; transform: none; } }
.aq-signal-dial__hint { margin: 0; font: 400 12px/16px var(--font-mono); color: var(--ink-subtle); }

/* the schedule */
.aq-signal-dial__table { width: 100%; border-collapse: collapse; }
.aq-signal-dial__table thead th {
  padding: 0 var(--space-3) var(--space-3); text-align: left; border-bottom: 1px solid var(--line-strong);
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-signal-dial__row > * { padding: var(--space-3); vertical-align: top; border-bottom: 1px solid var(--line); text-align: left; transition: background-color 200ms ease; }
.aq-signal-dial__row > th { padding: 0; width: 34%; font-weight: 400; }
.aq-signal-dial__pick {
  display: grid; grid-template-columns: var(--space-8) 1fr; align-items: baseline; width: 100%; min-height: 44px;
  padding: var(--space-3); border: 0; border-left: 2px solid transparent; background: none; text-align: left; cursor: pointer;
  font: 500 15px/22px var(--font-sans); color: var(--ink);
}
.aq-signal-dial__pick:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-signal-dial__n { font: 400 12px/22px var(--font-mono); color: var(--ink-subtle); }
.aq-signal-dial__v { font: 400 15px/22px var(--font-sans); color: var(--ink); text-wrap: pretty; }
.aq-signal-dial__m { font: 400 13px/22px var(--font-mono); color: var(--ink-muted); }
.aq-signal-dial__go { display: block; font-family: var(--font-sans); }
.aq-signal-dial__row.is-on > * { background: var(--flow-tint); }
.aq-signal-dial__row.is-on .aq-signal-dial__pick { border-left-color: var(--flow); }
.aq-signal-dial__row.is-on .aq-signal-dial__n { color: var(--flow); }
.aq-fold:not(.is-open) .aq-signal-dial__row.aq-fold-x { display: table-row; }
.aq-fold:has(> .aq-signal-dial) > .aq-fold__btn { display: none; }
.aq-signal-dial__note { margin: 0; padding-left: var(--space-4); border-left: 2px solid var(--flow); font: 400 14px/22px var(--font-sans); color: var(--ink-muted); max-width: var(--text-max); }

@media (prefers-reduced-motion: reduce) {
  .aq-signal-dial__ring { transition: none; }
  .aq-signal-dial__read.is-tick > * { animation: none; }
}

@container (max-width: 860px) {
  .aq-signal-dial { grid-template-columns: minmax(0, 1fr); grid-template-areas: "fig" "table"; row-gap: var(--space-8); }
  .aq-signal-dial__dial { max-width: 320px; }
  .aq-signal-dial__digits { font-size: 56px; }
  .aq-signal-dial__name { font-size: 16px; line-height: 22px; }
  .aq-signal-dial__val { font-size: 12px; line-height: 16px; }
  .aq-signal-dial__lim { margin-top: var(--space-2); }
  .aq-signal-dial__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .aq-signal-dial__table, .aq-signal-dial__table tbody { display: block; }
  .aq-signal-dial__row, .aq-fold:not(.is-open) .aq-signal-dial__row.aq-fold-x { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); border-bottom: 1px solid var(--line); }
  .aq-fold:not(.is-open) .aq-signal-dial__row.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-signal-dial) > .aq-fold__btn { display: flex; }
  .aq-signal-dial__row > * { border-bottom: 0; }
  .aq-signal-dial__row > th { grid-column: 1 / -1; width: auto; }
  .aq-signal-dial__v, .aq-signal-dial__m { grid-column: 2; padding: 0 var(--space-3) var(--space-2) 0; }
  .aq-signal-dial__m { padding-bottom: var(--space-4); }
}
.aq-signal-dial-sec { position: relative; }
.aq-signal-dial__p { min-width: 0; }
