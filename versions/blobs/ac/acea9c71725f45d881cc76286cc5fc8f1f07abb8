/* ---------- RailModules: options as modules clipped on a DIN rail, in macro close-up (look "rail-modules") ---------- */
/* The backplate (surface-sunken with a mounting-hole pattern) bleeds to both page edges behind the module row; the
   rail is a slotted band across its middle. Modules are front elevations: surface-raised bodies, terminal rows of
   screws (sunken band, round heads with a slot), a lamp (flow when lit), mono number, the option's Spot icon engraved
   and its name. Under the plate each module's line hangs on a leader. Phones: rail vertical at the left, modules as
   wide cards with the line inside. */
.aq-rail-modules-sec { overflow: hidden; }
.aq-rail-modules { --rm-h: calc(var(--space-32) * 2.4); --rm-pad: var(--space-12); position: relative; }
.aq-rail-modules__plate { position: relative; padding-top: var(--rm-pad, var(--space-12)); isolation: isolate; }
.aq-rail-modules__plate::before {
  content: ""; position: absolute; z-index: -2; top: 0; left: calc(50% - 50vw); width: 100vw; height: calc(var(--rm-h, calc(var(--space-32) * 2.4)) + 2 * var(--rm-pad, var(--space-12)));
  background-color: var(--surface-sunken); border-block: 1px solid var(--line-strong);
  background-image: radial-gradient(circle, var(--line-strong) 1.5px, transparent 2px); background-size: var(--space-8) var(--space-8); background-position: center;
}
.aq-rail-modules__rail {
  position: absolute; z-index: -1; left: calc(50% - 50vw); width: 100vw; top: calc(var(--rm-pad, var(--space-12)) + var(--rm-h, calc(var(--space-32) * 2.4)) / 2 - var(--space-8) / 2); height: var(--space-8);
  background-color: var(--surface-raised); border-block: 1px solid var(--line-strong);
  background-image: repeating-linear-gradient(90deg, transparent 0 var(--space-6), var(--line-strong) var(--space-6) calc(var(--space-6) + 1px), var(--surface-sunken) calc(var(--space-6) + 1px) calc(var(--space-12) - 1px), var(--line-strong) calc(var(--space-12) - 1px) var(--space-12));
  background-size: var(--space-12) 40%; background-repeat: repeat-x; background-position: 0 50%;
}
.aq-rail-modules__base { position: absolute; top: calc(var(--rm-pad, var(--space-12)) / 2); left: 0; margin: 0; transform: translateY(-50%); }
.aq-rail-modules__base span { display: inline-block; padding: var(--space-1) var(--space-3); background: var(--surface-raised); border: 1px solid var(--line-strong); font: 500 12px/16px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); }
.aq-rail-modules__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--rm-n, 5), minmax(0, 1fr)); column-gap: var(--space-2); }
.aq-rail-modules__m { display: flex; flex-direction: column; min-width: 0; }
.aq-rail-modules__body {
  height: var(--rm-h, calc(var(--space-32) * 2.4)); display: flex; flex-direction: column; background: var(--surface-raised); border: 1px solid var(--line-strong); color: var(--ink); text-decoration: none;
  transition: transform 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms ease;
}
a.aq-rail-modules__body:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-rail-modules__term { display: flex; justify-content: space-around; align-items: center; height: var(--space-12); background: var(--surface-sunken); border-bottom: 1px solid var(--line-strong); }
.aq-rail-modules__term:last-child { border-bottom: 0; border-top: 1px solid var(--line-strong); }
.aq-rail-modules__term i { position: relative; width: var(--space-6); height: var(--space-6); border-radius: 50%; border: 1px solid var(--line-strong); background: var(--surface-raised); transform: rotate(var(--rm-rot, 35deg)); }
.aq-rail-modules__term i::after { content: ""; position: absolute; left: 20%; right: 20%; top: calc(50% - 1px); height: 2px; background: var(--line-strong); }
.aq-rail-modules__term i:nth-child(2n) { --rm-rot: -20deg; }
.aq-rail-modules__face { flex: 1; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); min-height: 0; }
.aq-rail-modules__top { display: flex; align-items: center; justify-content: space-between; }
.aq-rail-modules__led { width: var(--space-3); height: var(--space-3); border-radius: 50%; border: 1px solid var(--line-strong); background: var(--surface-sunken); transition: background-color 200ms ease, box-shadow 200ms ease; }
.aq-rail-modules__m.is-on .aq-rail-modules__led, .aq-rail-modules__body:hover .aq-rail-modules__led, .aq-rail-modules__body:focus-visible .aq-rail-modules__led { background: var(--flow); border-color: var(--flow); box-shadow: 0 0 0 3px var(--flow-tint); }
.aq-rail-modules__n { font: 400 12px/16px var(--font-mono); color: var(--ink-muted); }
.aq-rail-modules__ic.aq-spot { width: var(--space-12); height: var(--space-12); background-color: var(--ink-muted); margin-top: auto; }
.aq-rail-modules__t { margin: 0; min-height: 2lh; font: 400 20px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.aq-rail-modules__go { color: var(--flow); margin-left: var(--space-2); display: inline-block; transition: transform 200ms ease; }
.aq-rail-modules__body:hover { transform: translateY(calc(-1 * var(--space-1))); border-color: var(--ink-muted); }
a.aq-rail-modules__body:hover { border-color: var(--flow); }
a.aq-rail-modules__body:hover .aq-rail-modules__go { transform: translateX(var(--space-1)); }
/* the callout under the plate, hung on a leader from the module */
.aq-rail-modules .aq-rail-modules__d { position: relative; margin: calc(var(--rm-pad, var(--space-12)) + var(--space-6)) 0 0; padding-top: var(--space-3); border-top: 1px solid var(--line-strong); font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-rail-modules__d::before { content: ""; position: absolute; left: var(--space-4); bottom: 100%; height: calc(var(--rm-pad, var(--space-12)) + var(--space-6)); border-left: 1px solid var(--line-strong); transform-origin: top; transform: scaleY(var(--rm-lead, 1)); }
.aq-rail-modules__d::after { content: ""; position: absolute; left: calc(var(--space-4) - 3px); top: -4px; width: 7px; height: 7px; border-radius: 50%; background: var(--ink-muted); }
.aq-fold:not(.is-open) .aq-rail-modules__m.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-rail-modules) > .aq-fold__btn { display: none; }

@container (max-width: 860px) {
  .aq-rail-modules { --rm-pad: var(--space-6); }
  .aq-rail-modules__plate { padding: var(--space-12) 0 var(--space-6) var(--space-12); }
  .aq-rail-modules__plate::before { height: auto; bottom: 0; }
  .aq-rail-modules__rail { left: var(--space-3); width: var(--space-6); top: 0; bottom: 0; height: auto; border-block: 0; border-inline: 1px solid var(--line-strong);
    background-image: repeating-linear-gradient(180deg, transparent 0 var(--space-6), var(--line-strong) var(--space-6) calc(var(--space-6) + 1px), var(--surface-sunken) calc(var(--space-6) + 1px) calc(var(--space-12) - 1px), var(--line-strong) calc(var(--space-12) - 1px) var(--space-12));
    background-size: 40% var(--space-12); background-repeat: repeat-y; background-position: 50% 0; }
  .aq-rail-modules__base { top: var(--space-6); left: var(--space-12); }
  .aq-rail-modules__list { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
  .aq-rail-modules__m { display: grid; grid-template-columns: minmax(0, 1fr); background: var(--surface-raised); border: 1px solid var(--line-strong); }
  .aq-fold:not(.is-open) .aq-rail-modules__m.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-rail-modules) > .aq-fold__btn { display: flex; }
  .aq-rail-modules__body { height: auto; border: 0; flex-direction: row; }
  .aq-rail-modules__term { flex-direction: column; height: auto; width: var(--space-8); border: 0; border-right: 1px solid var(--line-strong); justify-content: space-evenly; padding-block: var(--space-2); }
  .aq-rail-modules__term:last-child { display: none; }
  .aq-rail-modules__term i { width: var(--space-4); height: var(--space-4); }
  .aq-rail-modules__face { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: var(--space-3); row-gap: var(--space-2); }
  .aq-rail-modules__top { grid-column: 1 / -1; }
  .aq-rail-modules__ic.aq-spot { width: var(--space-8); height: var(--space-8); margin: 0; }
  .aq-rail-modules__t { min-height: 0; font-size: 18px; line-height: 24px; }
  .aq-rail-modules .aq-rail-modules__d { margin: 0 var(--space-4) var(--space-4) calc(var(--space-8) + var(--space-4)); padding-top: 0; border: 0; font-size: 14px; line-height: 21px; }
  .aq-rail-modules__d::before, .aq-rail-modules__d::after { display: none; }
}
