/* ---------- ToleranceScales: calibration acceptance as bands on rulers (look "tolerance-scales") ----------
   Rows on hairlines, 12-column split: the instrument (number, name, basis) in 4 columns, its readouts in 8, one per
   check, side by side. A readout: check name in mono, acceptance in light display figures, the ruler under it
   (ticks, nominal line, the band between the limits in flow-tint with flow limit lines). The hl row sits on a raised
   panel with a flow top rule and larger figures. The value's full text stays in the DOM for screen readers (__v,
   visually hidden); the readouts repeat it for the eye (aria-hidden). */
.aq-tolerance-scales { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
.aq-tolerance-scales__row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-8); padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
.aq-tolerance-scales__row.is-hl { background: var(--surface-raised); border-top: 2px solid var(--flow); padding: var(--space-8) var(--space-6); margin-top: var(--space-4); }
.aq-tolerance-scales__n { display: block; font: 500 12px/16px var(--font-mono); color: var(--ink-subtle); margin-bottom: var(--space-2); }
.aq-tolerance-scales__p { margin: 0; font: 300 26px/32px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); text-wrap: balance; }
.aq-tolerance-scales .aq-tolerance-scales__m { margin: var(--space-3) 0 0; font: 400 13px/20px var(--font-mono); color: var(--ink-muted); }
.aq-tolerance-scales__mk { display: block; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-tolerance-scales .aq-tolerance-scales__v { position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-tolerance-scales__reads { position: relative; }
.aq-tolerance-scales__grid { display: grid; grid-template-columns: repeat(var(--checks, 1), minmax(0, 1fr)); gap: var(--space-6); align-items: end; }
.aq-tolerance-scales__read { display: flex; flex-direction: column; min-width: 0; }
.aq-tolerance-scales .aq-tolerance-scales__k { margin: 0 0 var(--space-1); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-tolerance-scales .aq-tolerance-scales__f { margin: 0; font: 300 44px/50px var(--font-sans); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--ink); white-space: nowrap; }
.aq-tolerance-scales__row.is-hl .aq-tolerance-scales__f { font-size: 52px; line-height: 58px; }
.aq-tolerance-scales .aq-tolerance-scales__t { margin: 0; font: 300 24px/30px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; max-width: 26ch; }
.aq-tolerance-scales__ruler { display: block; width: 100%; height: var(--space-8); margin-top: var(--space-3); overflow: visible; }
.aq-tolerance-scales__ruler * { vector-effect: non-scaling-stroke; }
.aq-tolerance-scales__ticks { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-tolerance-scales__band { fill: var(--flow-tint); }
.aq-tolerance-scales__lim { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-tolerance-scales__nom { fill: none; stroke: var(--ink); stroke-width: 1; stroke-dasharray: 3 2; }
.aq-tolerance-scales__ref { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-tolerance-scales__read--span .aq-tolerance-scales__lim, .aq-tolerance-scales__read--ref .aq-tolerance-scales__lim { stroke: var(--ink-muted); }
.aq-tolerance-scales__row:hover .aq-tolerance-scales__band { fill: color-mix(in srgb, var(--flow-tint) 70%, var(--flow)); }
.aq-tolerance-scales-sec .aq-tolerance-scales__note { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-6); max-width: var(--text-max); font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }
.aq-tolerance-scales__seal { flex: none; width: var(--space-12); height: var(--space-12); border: 1.5px solid var(--flow); border-radius: 50%; outline: 1px solid var(--flow); outline-offset: -6px; }

@container (max-width: 860px) {
  .aq-tolerance-scales__row { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); padding: var(--space-6) 0; }
  .aq-tolerance-scales__row.is-hl { padding: var(--space-6) var(--space-4); }
  .aq-tolerance-scales__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-tolerance-scales__p { font-size: 22px; line-height: 28px; }
  .aq-tolerance-scales .aq-tolerance-scales__f, .aq-tolerance-scales__row.is-hl .aq-tolerance-scales__f { font-size: 36px; line-height: 42px; }
  .aq-tolerance-scales .aq-tolerance-scales__t { font-size: 20px; line-height: 26px; }
}
.aq-tolerance-scales__row.is-many .aq-tolerance-scales__f, .aq-tolerance-scales__row.is-hl.is-many .aq-tolerance-scales__f { font-size: 36px; line-height: 44px; }
@container (max-width: 860px) { .aq-tolerance-scales__row.is-many .aq-tolerance-scales__f, .aq-tolerance-scales__row.is-hl.is-many .aq-tolerance-scales__f { font-size: 32px; line-height: 38px; } }
.aq-tolerance-scales-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; max-width: 20ch; }
@container (max-width: 860px) { .aq-tolerance-scales-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); } }
