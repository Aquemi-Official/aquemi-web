/* ---------- JointSteps: a fabrication sequence told on one joint (look "joint-steps"). Navy title column (bleeding to
   the section's left and top/bottom edges), a drawing sheet with the joint (IsoKit on the light sheet; sticky on wide
   screens), the steps on a numbered rail. The figure's data-st names the stage shown; that stage's group of lines
   turns flow. ---------- */
.aq-section.aq-joint-steps-sec { overflow: clip; }
.aq-joint-steps {
  --jst-ease: cubic-bezier(0.2, 0, 0, 1);
  display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.45fr) minmax(0, 1fr); column-gap: var(--space-8); align-items: stretch;
}
.aq-joint-steps__title { position: relative; z-index: 0; padding: var(--space-4) var(--space-8) var(--space-8) 0; color: var(--on-navy); }
.aq-joint-steps__title::before { content: ""; position: absolute; z-index: -1; top: -50vh; bottom: -50vh; right: 0; left: -100vw; background: var(--navy); }
.aq-joint-steps__title .aq-sec-head { position: sticky; top: var(--space-24); }
.aq-joint-steps__title .aq-h1 { font: 300 52px/56px var(--font-sans); letter-spacing: -0.03em; color: var(--on-navy); }
.aq-joint-steps__title .aq-lead { color: var(--on-navy-muted); }

/* the sheet */
.aq-joint-steps__sheet { min-width: 0; }
.aq-joint-steps__fig { position: sticky; top: var(--space-16); border: 1px solid var(--line); background: var(--surface-raised); }
.aq-joint-steps__fig .aq-iso { display: block; width: 100%; height: auto; }
.aq-joint-steps__st * { transition: stroke 260ms var(--jst-ease, ease-out), fill 260ms var(--jst-ease, ease-out), stroke-width 260ms var(--jst-ease, ease-out); }
.aq-joint-steps__print { fill: none; stroke: var(--ink-muted); stroke-width: 4; stroke-dasharray: 6 3 2 3 10 4; }
.aq-joint-steps__zone { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-joint-steps__svg .aq-iso__flow { opacity: 0.4; transition: opacity 260ms var(--jst-ease, ease-out), stroke-width 260ms var(--jst-ease, ease-out); }
.aq-joint-steps__fig[data-st="plan"] [data-st="plan"] *, .aq-joint-steps__fig[data-st="join"] [data-st="join"] *,
.aq-joint-steps__fig[data-st="qualify"] [data-st="qualify"] .aq-iso__pipe-wall, .aq-joint-steps__fig[data-st="qualify"] [data-st="qualify"] .aq-iso__eq, .aq-joint-steps__fig[data-st="qualify"] [data-st="qualify"] .aq-iso__hid,
.aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__eq, .aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__ln, .aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__thin, .aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__pipe-wall { stroke: var(--flow); }
.aq-joint-steps__fig[data-st="plan"] [data-st="plan"] .aq-iso__label, .aq-joint-steps__fig[data-st="plan"] .aq-iso__sheet-t { fill: var(--flow); stroke: none; }
.aq-joint-steps__fig[data-st="receive"] .aq-joint-steps__print { stroke: var(--flow); }
.aq-joint-steps__fig[data-st="join"] .aq-joint-steps__zone { stroke-width: 1.5; }
.aq-joint-steps__fig[data-st="clean"] .aq-iso__flow { opacity: 1; stroke-width: 6; }
.aq-joint-steps__fig[data-st="test"] [data-iso-id="len"] .aq-iso__pipe-wall { stroke: var(--flow); }
/* the joint's tag: number and method, real text over the drawing */
.aq-joint-steps__tag {
  position: absolute; transform: translate(-100%, -50%); display: flex; align-items: baseline; gap: var(--space-2); max-width: 46%;
  padding: var(--space-1) var(--space-2); background: var(--surface-raised); border: 1px solid var(--line-strong);
  font: 400 13px/18px var(--font-sans); color: var(--ink); transition: border-color 260ms var(--jst-ease, ease-out);
}
.aq-joint-steps__tag--right { transform: translate(0, -50%); }
.aq-joint-steps__tag b { font: 500 13px/18px var(--font-mono); letter-spacing: 0.06em; }
.aq-joint-steps__fig[data-st="join"] .aq-joint-steps__tag, .aq-joint-steps__fig[data-st="plan"] .aq-joint-steps__tag { border-color: var(--flow); }

/* the rail */
.aq-joint-steps__rail { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
.aq-joint-steps__step { display: grid; grid-template-columns: var(--space-16) minmax(0, 1fr); column-gap: var(--space-4); padding: var(--space-6) 0 var(--space-8) var(--space-6); border-bottom: 1px solid var(--line); position: relative; outline-offset: -2px; }
.aq-joint-steps__step::before { content: ""; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: var(--flow); transform: scaleY(0); transform-origin: 50% 0; transition: transform 260ms var(--jst-ease, ease-out); }
.aq-joint-steps__step.is-on::before { transform: scaleY(1); }
.aq-joint-steps__step:focus-visible { outline: 2px solid var(--focus); }
.aq-joint-steps__n { display: flex; flex-direction: column; gap: var(--space-1); font: 300 44px/44px var(--font-sans); letter-spacing: -0.03em; color: var(--ink-subtle); transition: color 260ms var(--jst-ease, ease-out); }
.aq-joint-steps__n small { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-muted); }
.aq-joint-steps__step.is-on .aq-joint-steps__n { color: var(--flow); }
.aq-joint-steps__t { margin: 0; font: 500 18px/24px var(--font-sans); color: var(--ink); text-wrap: balance; }
.aq-joint-steps__t a { color: inherit; text-decoration: underline; text-decoration-color: var(--flow); text-underline-offset: 0.2em; }
.aq-joint-steps__t a::after { content: " \2192"; }
.aq-joint-steps__d { margin: var(--space-2) 0 0; font: 400 15px/23px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-joint-steps__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-3) 0 0; }
.aq-joint-steps__wit, .aq-joint-steps__stamp { display: inline-flex; gap: var(--space-2); padding: var(--space-1) var(--space-2); border: 1px solid var(--line-strong); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--ink); }
.aq-joint-steps__stamp span { white-space: nowrap; }
.aq-joint-steps__stamp span:first-child { text-transform: uppercase; }
.aq-joint-steps__stamp { flex-wrap: wrap; column-gap: var(--space-2); row-gap: 0; }
.aq-joint-steps__stamp { border-width: 1.5px; border-color: var(--ink); }

@media (prefers-reduced-motion: reduce) {
  .aq-joint-steps * { transition: none !important; }
}
@container (max-width: 1100px) {
  .aq-joint-steps { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .aq-joint-steps__title { grid-column: 1 / -1; padding: var(--space-8) 0; margin-bottom: var(--space-8); }
  .aq-joint-steps__title::before { right: -100vw; bottom: 0; }
  .aq-joint-steps__title .aq-sec-head { position: static; }
}
@container (max-width: 860px) {
  .aq-joint-steps { grid-template-columns: minmax(0, 1fr); }
  .aq-joint-steps__title { padding: var(--space-4) 0 var(--space-8); margin-bottom: var(--space-6); }
  .aq-joint-steps__title .aq-h1 { font: 300 36px/42px var(--font-sans); }
  .aq-joint-steps__fig { position: relative; top: 0; margin-bottom: var(--space-6); }
  .aq-joint-steps__tag { max-width: 70%; font-size: 12px; }
  .aq-joint-steps__step { grid-template-columns: var(--space-12) minmax(0, 1fr); padding-left: var(--space-4); }
  .aq-joint-steps__n { font-size: 32px; line-height: 36px; }
}
.aq-joint-steps__txt { min-width: 0; }
@container (max-width: 860px) {
  .aq-joint-steps__tag, .aq-joint-steps__tag--right { left: var(--space-2) !important; top: var(--space-2) !important; transform: none; }
}
