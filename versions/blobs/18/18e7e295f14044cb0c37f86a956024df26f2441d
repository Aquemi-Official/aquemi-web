@import url("https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@300;400;500&display=swap");

/* ---------- Base ---------- */
.aq-root {
  background: var(--surface);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 26px;
  -webkit-font-smoothing: antialiased;
}
.aq-root *:focus-visible, .aq-page *:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Logo: the navy file in light mode, the limestone file in dark mode (explicit theme or system setting) */
.aq-logo--on-dark { display: none; }
[data-theme="dark"] .aq-logo--on-light { display: none; }
[data-theme="dark"] .aq-logo--on-dark { display: block; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-logo--on-light { display: none; }
  :root:not([data-theme="light"]) .aq-logo--on-dark { display: block; }
}

/* ---------- Page layout and type ---------- */
.aq-page { container-type: inline-size; background: var(--surface); color: var(--ink); font: 400 16px/26px var(--font-sans); -webkit-font-smoothing: antialiased; }
:where(.aq-page) *, :where(.aq-page) *::before, :where(.aq-page) *::after { box-sizing: border-box; }
:where(.aq-page) a { color: var(--flow); }
.aq-page h1, .aq-page h2, .aq-page h3, .aq-page h5, .aq-page p { margin: 0; }
.aq-page h1, .aq-page h2, .aq-page h3 { text-wrap: balance; }
.aq-in { max-width: var(--content-max); margin: 0 auto; padding-inline: var(--space-8); }
.aq-section { padding-block: var(--space-16); }
.aq-section + .aq-section { border-top: 1px solid var(--line); }
.aq-stack { display: flex; flex-direction: column; gap: var(--space-4); }
.aq-stack-l { display: flex; flex-direction: column; gap: var(--space-8); }
.aq-eyebrow { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-lead { font: 400 18px/28px var(--font-sans); color: var(--ink-muted); max-width: var(--text-max); }
.aq-small { font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }
.aq-display-xl { font: 300 72px/76px var(--font-sans); letter-spacing: -0.03em; }
.aq-display { font: 300 56px/60px var(--font-sans); letter-spacing: -0.025em; }
.aq-h1 { font: 400 40px/46px var(--font-sans); letter-spacing: -0.02em; }
.aq-h2 { font: 400 28px/34px var(--font-sans); letter-spacing: -0.01em; }
.aq-h3 { font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; }

/* Placeholder: a fact only Aquemi can supply, written [in square brackets] until confirmed */
.aq-ph { background: var(--caution-tint); color: var(--ink); font-family: var(--font-mono); font-size: 0.86em; padding: 0 3px; border-radius: var(--radius-sm); }
.is-clean .aq-ph { background: none; color: inherit; font-family: inherit; font-size: inherit; padding: 0; }

@container (max-width: 860px) {
  .aq-in { padding-inline: var(--space-4); }
  .aq-section { padding-block: var(--space-12); }
  .aq-display-xl { font-size: 44px; line-height: 48px; }
  .aq-display { font-size: 38px; line-height: 42px; }
  .aq-h1 { font-size: 30px; line-height: 36px; }
}
