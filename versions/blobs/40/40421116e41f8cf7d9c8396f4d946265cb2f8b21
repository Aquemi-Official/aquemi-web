/* ---------- CaseStudy: facts beside one large measured-outcome figure ---------- */
/* Cases stack, each opened by a line hairline. Desktop: Client, Problem and System delivered as hairline rows in the
   left column; the outcome on a surface-raised panel spanning their height on the right, its top edge a flow
   hairline and the figure set large in Geist Mono Light. No heavy boxes, no shadows. */
.aq-cases { counter-reset: aq-case; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-16); }
.aq-case {
  counter-increment: aq-case;
  display: flex; flex-direction: column; gap: var(--space-6);
  min-width: 0; padding-top: var(--space-8);
  border-top: 1px solid var(--line);
}

/* Header: "Case 01" eyebrow, then the title */
.aq-case__title { margin: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-case__title::before {
  content: "Case " counter(aq-case, decimal-leading-zero);
  display: block; margin-bottom: var(--space-2);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--ink-muted);
}

/* The dl is the grid; each dt/dd pair is a div (which dl allows) */
.aq-case__facts {
  margin: 0;
  display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  grid-auto-rows: auto; column-gap: var(--space-12); row-gap: 0;
}
.aq-case__fact, .aq-case__outcome { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__fact { grid-column: 1; padding: var(--space-4) 0; border-top: 1px solid var(--line); }
.aq-case__fact:first-child { border-top: 0; padding-top: 0; }
.aq-case__facts dt, .aq-case__entries dt, .aq-case__figures dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case dd { margin: 0; overflow-wrap: break-word; }
.aq-case__fact dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcome: spans the fact rows; the flow top hairline is the case's one accent */
.aq-case__outcome {
  grid-column: 2; grid-row: 1 / span 3; align-self: stretch;
  padding: var(--space-6) var(--space-8) var(--space-8);
  background: var(--surface-raised);
  border-top: 1px solid var(--flow);
}
.aq-case__facts:not(:has(> .aq-case__fact)) > .aq-case__outcome { grid-column: 1 / -1; grid-row: auto; }
.aq-case__outcome dd { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-6); }
.aq-case__figure { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-2); min-width: 0; padding-top: var(--space-4); }
.aq-case__num {
  min-width: 0; overflow-wrap: anywhere;
  font: 300 clamp(64px, 9cqi, 128px)/1 var(--font-mono);
  letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-case__unit { font: 400 28px/34px var(--font-mono); letter-spacing: 0; color: var(--ink); }
/* A bracketed value inside the figure keeps the placeholder look, scaled to the slot */
.aq-case__num .aq-ph, .aq-case__unit .aq-ph { font-size: 0.4em; vertical-align: middle; }
.aq-case__result { max-width: var(--text-max); font: 400 18px/28px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* No figure supplied yet: a dashed placeholder slot the size of the figure, so the gap is obvious in review */
.aq-case__figure.is-empty {
  align-items: center; justify-content: center;
  min-height: clamp(96px, 9cqi, 128px);
  margin-top: var(--space-4); padding: var(--space-4);
  border: 1px dashed var(--caution);
  background: var(--caution-tint);
}
.aq-case__figure.is-empty .aq-ph { font-size: 18px; line-height: 24px; text-align: center; }
.is-clean .aq-case__figure.is-empty { border-color: var(--line); background: none; color: var(--ink-subtle); }

/* Outcome spans however many fact rows there are (three by default; Standard met makes four). Two-column widths only. */
@container (min-width: 861px) {
  .aq-case__facts:has(> .aq-case__fact:nth-child(4)) > .aq-case__outcome { grid-row: 1 / span 4; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(3))) > .aq-case__outcome { grid-row: 1 / span 2; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(2))) > .aq-case__outcome { grid-row: 1; }
}

/* How it was measured: a full-width hairline row under the facts and outcome, quieter than the facts */
.aq-case__method {
  grid-column: 1 / -1; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  margin-top: var(--space-6); padding-top: var(--space-4);
  border-top: 1px solid var(--line);
}
.aq-case__method dd { font: 400 15px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Status label: says the case is a template or awaiting client approval (a draft flag, like a placeholder) */
.aq-case__status {
  align-self: flex-start;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--caution); background: var(--caution-tint);
  padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm);
}

/* Project profile: the KeyFacts strip of headline KPIs, under the title, as KeyFacts draws it (between hairlines,
   on the page ground); the case's own dt/dd rules are scoped so they do not reach it */
.aq-case__profile { background: none; }

/* Motion hook (CaseStudy/motion.js): the timeline line runs out stop by stop through --aq-run; complete without script */
.aq-case__timeline li::before { transform: scaleX(var(--aq-run, 1)); transform-origin: left; }

@container (max-width: 860px) {
  /* Phones: one column. Facts and method are hairline rows (label above text); the outcome panel follows them,
     figure scaled to the screen. */
  .aq-cases { gap: var(--space-12); }
  .aq-case { padding-top: var(--space-6); gap: var(--space-4); }
  .aq-case__facts { grid-template-columns: minmax(0, 1fr); }
  .aq-case__fact, .aq-case__outcome { grid-column: 1; grid-row: auto; }
  .aq-case__fact { gap: var(--space-1); padding: var(--space-3) 0; }
  .aq-case__outcome { margin-block: var(--space-3) 0; padding: var(--space-4); }
  .aq-case__method { grid-column: 1; gap: var(--space-1); margin-top: var(--space-4); padding-top: var(--space-3); }
  .aq-case__fact dd { font-size: 15px; line-height: 24px; }
  .aq-case__outcome dd { gap: var(--space-4); }
  .aq-case__figure { padding-top: var(--space-2); }
  .aq-case__num { font-size: clamp(48px, 16cqi, 80px); }
  .aq-case__unit { font-size: 20px; line-height: 24px; }
  .aq-case__result { font-size: 16px; line-height: 26px; }
  .aq-case__figure.is-empty { min-height: var(--space-24); margin-top: var(--space-2); }
  .aq-case__figure.is-empty .aq-ph { font-size: 15px; }
}

/* ---------- Project record (.aq-case--record): the case told as a project record ----------
   Facts as hairline rows beside the system's equipment drawing with what changed marked on it, then the measured
   outcomes as large figures with the method beneath, then the order-to-release milestones on one hairline. */
.aq-case__label { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case__brief { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-12); align-items: start; }
.aq-case__brief.is-bare { grid-template-columns: minmax(0, 1fr); }
.aq-case__entries { margin: 0; display: flex; flex-direction: column; }
.aq-case__entry { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
.aq-case__entry:first-child { border-top: 0; padding-top: 0; }
.aq-case__entry dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Drawing: the page's equipment mask on a Plate (base.css: a line frame on surface-raised); numbered marks pin what changed */
.aq-case__drawing { margin: 0; display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
/* The inner box is the drawing's own square, so pin positions (% of the drawing) land on the equipment at any width */
.aq-case__plate { position: relative; width: min(100%, 26rem); margin-inline: auto; }
.aq-case__art .aq-illustration { max-width: none; }
.aq-case__mark {
  flex: none; display: inline-grid; place-items: center; box-sizing: border-box; width: var(--space-6); height: var(--space-6);
  border: 1px solid var(--flow); border-radius: var(--radius-sm); background: var(--surface-raised); color: var(--flow);
  font: 500 12px/1 var(--font-mono); font-variant-numeric: tabular-nums;
}
.aq-case__pin { position: absolute; transform: translate(-50%, -50%); display: flex; }
.aq-case__changes { display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__changes ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__changes li { display: flex; align-items: flex-start; gap: var(--space-3); font: 400 15px/24px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcomes, the hero of the record: large mono figures with the unit, an eyebrow caption, and the method beneath;
   two per row on desktop, one per row on phones */
.aq-case__outcomes { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--line); }
.aq-case__outcomes > .aq-case__result { margin: 0; font-size: 16px; line-height: 26px; }
.aq-case__figures { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); row-gap: var(--space-8); }
.aq-case__fig { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding-top: var(--space-4); border-top: 1px solid var(--line); }
.aq-case__fig dt { order: 2; }
.aq-case__fig dd { display: contents; }
.aq-case__val { order: 1; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-1); min-width: 0; }
.aq-case__fig .aq-case__num { font: 300 clamp(48px, 5.4cqi, 64px)/1.05 var(--font-mono); letter-spacing: -0.04em; color: var(--ink); overflow-wrap: anywhere; }
.aq-case__fig .aq-case__num .aq-ph { font-size: 1em; padding: 0 var(--space-1); }
.aq-case__fig .aq-case__unit { font: 400 clamp(20px, 2.4cqi, 28px)/1.2 var(--font-mono); letter-spacing: 0; color: var(--ink); }
.aq-case__how { order: 3; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; overflow-wrap: break-word; }

/* Timeline: order to release, milestones as small square stops on one hairline */
.aq-case__timeline { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--line); }
.aq-case__timeline ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); }
.aq-case__timeline li { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding-top: var(--space-8); text-align: center; min-width: 0; }
.aq-case__timeline li::before { content: ""; position: absolute; top: var(--space-2); left: 0; right: 0; border-top: 1px solid var(--line-strong); }
.aq-case__timeline li:first-child::before { left: 50%; }
.aq-case__timeline li:last-child::before { right: 50%; }
.aq-case__stop {
  position: absolute; top: calc(var(--space-2) - 4px); left: 50%; transform: translateX(-50%); box-sizing: border-box;
  width: 9px; height: 9px; border: 1px solid var(--flow); background: var(--surface);
}
.aq-case__timeline li:last-child .aq-case__stop { background: var(--flow); }
.aq-case__mt { font: 500 14px/20px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-case__when { font: 400 13px/20px var(--font-mono); color: var(--ink-muted); font-variant-numeric: tabular-nums; }

@container (max-width: 860px) {
  /* Phones: drawing first, then the facts, outcomes one per row, then a vertical timeline */
  .aq-case__brief { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-case__drawing { order: -1; }
  .aq-case__plate { width: min(100%, 17.5rem); }
  .aq-case__entry { padding: var(--space-3) 0; }
  .aq-case__entry dd { font-size: 15px; line-height: 24px; }
  .aq-case__changes li { font-size: 14px; line-height: 22px; }
  .aq-case__outcomes, .aq-case__timeline { padding-top: var(--space-4); }
  .aq-case__figures { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-case__fig .aq-case__num { font-size: clamp(40px, 13cqi, 52px); }
  .aq-case__fig .aq-case__unit { font-size: 20px; }
  .aq-case__how { font-size: 13px; line-height: 20px; }
  .aq-case__timeline ol { grid-template-columns: minmax(0, 1fr); }
  .aq-case__timeline li { flex-direction: row; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: var(--space-3); padding: 0 0 var(--space-4) var(--space-8); text-align: left; }
  .aq-case__timeline li::before { top: var(--space-2); bottom: 0; left: 4px; right: auto; border-top: 0; border-left: 1px solid var(--line-strong); }
  .aq-case__timeline li:first-child::before { left: 4px; }
  .aq-case__timeline li:last-child::before { display: none; }
  .aq-case__timeline li:last-child { padding-bottom: 0; }
  .aq-case__stop { top: 6px; left: 0; transform: none; }
}
@container (max-width: 860px) { .aq-case__timeline li::before { transform: scaleY(var(--aq-run, 1)); transform-origin: top; } }
