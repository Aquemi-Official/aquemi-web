/* ---------- LoopDock: options shown where they fit on one isometric loop, on a limestone band ---------- */
.aq-loop-dock { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--space-8); align-items: center; }
.aq-loop-dock__stage { position: relative; }
.aq-loop-dock__plane { position: relative; aspect-ratio: 900 / 640; }
.aq-loop-dock__svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.aq-loop-dock__mk { position: absolute; z-index: 1; display: grid; place-items: center; width: var(--space-8); height: var(--space-8); translate: -50% -130%;
  border-radius: var(--radius-pill); background: var(--navy); color: var(--on-navy); font: 500 12px/1 var(--font-mono); transition: translate 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-dock__mk::after { content: ""; position: absolute; left: 50%; top: 100%; height: var(--space-3); border-left: 1px solid var(--navy); }
.aq-loop-dock__mk.is-on { background: var(--flow); translate: -50% -150%; }
.aq-loop-dock__mk.is-on::after { border-color: var(--flow); }
.aq-loop-dock__base { position: absolute; display: flex; align-items: center; gap: var(--space-2); translate: calc(-100% - var(--space-4)) -50%; max-width: calc(var(--space-32) + var(--space-16)); text-align: right;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-loop-dock__bic.aq-spot { width: var(--space-6); height: var(--space-6); background-color: var(--on-limestone-muted); }

/* Option cards under the drawing */
.aq-loop-dock__cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
.aq-loop-dock__card { display: flex; }
.aq-loop-dock__body { flex: 1; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); background: var(--surface-raised); color: var(--ink); text-decoration: none;
  border-top: 3px solid var(--navy); transition: border-color 200ms cubic-bezier(0.2, 0, 0, 1), transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-dock__card.is-on .aq-loop-dock__body { border-top-color: var(--flow); transform: translateY(calc(-1 * var(--space-1))); }
.aq-loop-dock__no { margin: 0; display: flex; align-items: center; justify-content: space-between; font: 400 28px/1 var(--font-mono); color: var(--ink-subtle); }
.aq-loop-dock__card.is-on .aq-loop-dock__no span { color: var(--flow); }
.aq-loop-dock__glyph.aq-spot { width: var(--space-8); height: var(--space-8); background-color: var(--ink-muted); }
.aq-loop-dock__t { margin: 0; font: 400 24px/30px var(--font-sans); letter-spacing: -0.01em; }
.aq-loop-dock__d { margin: 0; font: 400 15px/23px var(--font-sans); color: var(--ink-muted); }
a.aq-loop-dock__body:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Desktop shows every option; the fold is for phones */
.aq-fold:not(.is-open) .aq-loop-dock__card.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-loop-dock) > .aq-fold__btn { display: none; }

.aq-loop-dock-sec { overflow: hidden; }

@container (max-width: 860px) {
  .aq-loop-dock { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .aq-loop-dock__plane { margin-inline: calc(-1 * var(--space-4)); }
  .aq-loop-dock__mk { width: var(--space-6); height: var(--space-6); font-size: 12px; }
  .aq-loop-dock__base { position: static; translate: none; white-space: normal; margin-top: var(--space-2); }
  .aq-loop-dock__cards { grid-template-columns: minmax(0, 1fr); }
  .aq-loop-dock__body { padding: var(--space-4); }
  .aq-fold:not(.is-open) .aq-loop-dock__card.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-loop-dock) > .aq-fold__btn { display: flex; }
}
