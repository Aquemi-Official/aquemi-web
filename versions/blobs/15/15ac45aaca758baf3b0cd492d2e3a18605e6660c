/* ---------- Router: pick your situation, see one route (table block with as: "router", blocks/router.js) ----------
   On a drawing plate (wPlate). Desktop: situations as rows on the left, each with a large mono index; the chosen one is
   a flow-framed tab with a node on its edge. The open route on the right spans every row: framed stations, each with
   a mono "station" number and a header strip, joined by flow pipes with arrowheads; the linked end station is filled.
   A pipe runs from the chosen situation into the route. Phones: one column; the route opens under its situation and
   its stations run down a riser with arrowheads between them. */
.aq-router { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-12); align-items: start; }
.aq-router__opt {
  grid-column: 1; position: relative; display: grid; grid-template-columns: var(--space-16) minmax(0, 1fr); align-items: center;
  width: 100%; min-height: 64px; margin: 0; padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
  background: none; border: 1px solid transparent; border-bottom-color: var(--line); cursor: pointer; text-align: left;
  font: 500 16px/22px var(--font-sans); letter-spacing: -0.005em; color: var(--ink-muted);
}
.aq-router__opt .aq-index { font: 300 30px/34px var(--font-mono); letter-spacing: -0.02em; color: var(--ink-subtle); }
.aq-router__t { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-router__opt:hover { color: var(--ink); }
.aq-router__opt:hover .aq-index { color: var(--ink-muted); }
.aq-router__opt:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-router__opt[aria-expanded="true"] { color: var(--ink); background: var(--flow-tint); border-color: var(--flow); }
.aq-router__opt[aria-expanded="true"] .aq-index { color: var(--flow); }
/* the pipe from the chosen situation into the route frame, a node on the tab's edge */
.aq-router__opt[aria-expanded="true"]::after {
  content: ""; position: absolute; top: calc(50% - 4px); right: calc(-1 * var(--space-12) - 1px); width: var(--space-12); height: 9px;
  background: var(--flow); clip-path: polygon(0 4px, calc(100% - 7px) 4px, calc(100% - 7px) 0, 100% 50%, calc(100% - 7px) 100%, calc(100% - 7px) 5px, 0 5px);
}
.aq-router__opt[aria-expanded="true"]::before {
  content: ""; position: absolute; z-index: 1; top: calc(50% - 5px); right: -6px; width: 11px; height: 11px;
  border: 1px solid var(--flow); border-radius: var(--radius-pill); background: var(--surface);
}
.aq-router__route { grid-column: 2; position: relative; align-self: stretch; padding: var(--space-6); border: 1px solid var(--line-strong); }
.aq-router__route[hidden] { display: none; }
.aq-router__hit { position: absolute; inset: 0; z-index: 0; }
.aq-router__route.is-link:hover { border-color: var(--flow); }
.aq-router__stations { position: relative; z-index: 1; pointer-events: none; list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--space-6); align-items: start; counter-reset: aq-station; }
.aq-router__stations a { pointer-events: auto; }
.aq-router__stations > li { position: relative; min-width: 0; padding-top: var(--space-6); counter-increment: aq-station; }
.aq-router__stations > li::before {
  content: "Station 0" counter(aq-station); position: absolute; top: 0; left: 0;
  font: 500 10px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle);
}
/* pipe with an arrowhead across the gap to the next station */
.aq-router__stations > li:not(:last-child)::after {
  content: ""; position: absolute; top: calc(var(--space-6) + 12px); right: calc(-1 * var(--space-6)); width: var(--space-6); height: 9px;
  background: var(--flow); clip-path: polygon(0 4px, calc(100% - 7px) 4px, calc(100% - 7px) 0, 100% 50%, calc(100% - 7px) 100%, calc(100% - 7px) 5px, 0 5px);
}
.aq-router__k {
  margin: 0; padding: var(--space-2) var(--space-3); border: 1px solid var(--line-strong); border-bottom-color: var(--line);
  font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-router__v {
  margin: 0; padding: var(--space-3); border: 1px solid var(--line-strong); border-top: 0;
  font: 400 15px/22px var(--font-sans); color: var(--ink); overflow-wrap: break-word; text-wrap: pretty;
}
.aq-router__stations > li:first-child .aq-router__k { color: var(--flow); }
.aq-router__stations > li.is-go .aq-router__k { background: var(--flow); border-color: var(--flow); color: var(--surface); }
.aq-router__stations > li.is-go .aq-router__v { background: var(--flow-tint); border-color: var(--flow); }
.aq-router__v a { font-weight: 500; text-decoration: none; }
.aq-router__v a::after { content: "\a0\2192"; }
.aq-router__v a:hover, .aq-router__route.is-link:hover li.is-go a { text-decoration: underline; }

@container (max-width: 860px) {
  .aq-router { grid-template-columns: minmax(0, 1fr); }
  .aq-router__opt { grid-template-columns: var(--space-12) minmax(0, 1fr); min-height: 56px; padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2); font-size: 15px; line-height: 21px; }
  .aq-router__opt .aq-index { font-size: 24px; line-height: 28px; }
  .aq-router__opt[aria-expanded="true"]::after { top: auto; bottom: calc(-1 * var(--space-3) - 1px); right: auto; left: calc(var(--space-6) - 4px); width: 9px; height: var(--space-3); clip-path: polygon(4px 0, 5px 0, 5px calc(100% - 7px), 100% calc(100% - 7px), 50% 100%, 0 calc(100% - 7px), 4px calc(100% - 7px)); }
  .aq-router__opt[aria-expanded="true"]::before { top: auto; right: auto; bottom: -6px; left: calc(var(--space-6) - 6px); }
  .aq-router__route { grid-column: 1; grid-row: auto !important; margin: var(--space-3) 0 var(--space-3); padding: var(--space-3); }
  .aq-router__stations { grid-auto-flow: row; row-gap: var(--space-3); }
  .aq-router__stations > li { padding-top: 0; }
  .aq-router__stations > li::before { display: none; }
  .aq-router__k { padding: var(--space-1) var(--space-3); }
  .aq-router__k::before { content: "0" counter(aq-station) "  "; white-space: pre; color: inherit; }
  .aq-router__stations > li:not(:last-child)::after {
    top: auto; bottom: calc(-1 * var(--space-3)); right: auto; left: calc(var(--space-6) - 4px); width: 9px; height: var(--space-3);
    clip-path: polygon(4px 0, 5px 0, 5px calc(100% - 7px), 100% calc(100% - 7px), 50% 100%, 0 calc(100% - 7px), 4px calc(100% - 7px));
  }
  .aq-router__v { padding: var(--space-2) var(--space-3); font-size: 14px; line-height: 21px; }
}
