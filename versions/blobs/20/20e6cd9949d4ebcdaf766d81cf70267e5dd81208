/* ---------- Prose ---------- */
/* Plain: a few paragraphs within text-max (also used for captions). */
.aq-prose { max-width: var(--text-max); }
.aq-prose p + p { margin-top: var(--space-4); }

/* Sheet (concept O): a drafting grid ground, the first sentence pulled out as a light lead, the rest in a narrow
   column with numbered margin notes joined to it by leader lines. The notes quote the text; they never add to it.
   ".aq-prose.aq-prose--sheet" selectors match SplitSection's ".aq-split-section__body .aq-prose p:first-child"
   specificity and win by coming later in bundle.css, so the lead and body keep their own type inside a split. */
.aq-prose--sheet {
  max-width: none;
  display: flex; flex-direction: column; gap: var(--space-8);
  padding: var(--space-8);
  border: 1px solid var(--line);
  background-color: var(--surface);
  background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: var(--space-12) var(--space-12);
  background-position: -1px -1px;
}
.aq-prose.aq-prose--sheet > p.aq-prose__lead {
  margin: 0; max-width: 30em;
  font: 300 26px/34px var(--font-sans); letter-spacing: -0.01em; color: var(--ink);
  text-wrap: balance; overflow-wrap: break-word;
}

/* One row per paragraph: text column (about 60 characters) and the notes margin beside it */
.aq-prose__row {
  display: grid; align-items: start; justify-content: start;
  grid-template-columns: minmax(0, 60ch) calc(var(--space-32) + var(--space-16));
  column-gap: var(--space-12);
}
.aq-prose.aq-prose--sheet .aq-prose__row > p {
  grid-column: 1; margin: 0;
  font: 400 16px/26px var(--font-sans); color: var(--ink-muted);
  text-wrap: pretty; overflow-wrap: break-word;
}

/* The quoted term in the text: dotted underline and its note number */
.aq-prose__ref {
  color: var(--ink);
  text-decoration: underline dotted var(--line-strong); text-decoration-thickness: 1px; text-underline-offset: var(--space-1);
}
.aq-prose__ref::after {
  content: attr(data-n);
  content: attr(data-n) / "";
  display: inline-block; margin-left: calc(var(--space-1) / 2); vertical-align: super;
  font: 500 10px/1 var(--font-mono); font-variant-numeric: tabular-nums; color: var(--flow);
}
.aq-prose__row:hover .aq-prose__ref { text-decoration-color: var(--flow); }

/* Margin notes: "01 / Ph. Eur. monograph 0169", each with a leader line back across the gap to the text column */
.aq-prose__notes {
  grid-column: 2; list-style: none; margin: 0; padding: 0;
  display: flex; flex-direction: column; gap: var(--space-3);
}
.aq-prose__notes > li {
  position: relative; display: flex; align-items: baseline; gap: var(--space-2);
  padding-top: var(--space-1);
  font: 400 12px/16px var(--font-mono); color: var(--ink-subtle);
}
.aq-prose__n { font-weight: 500; font-variant-numeric: tabular-nums; color: var(--flow); white-space: nowrap; }
.aq-prose__n::after { content: " /"; }
.aq-prose__q { min-width: 0; overflow-wrap: anywhere; }
.aq-prose__notes > li::before {
  content: ""; position: absolute; pointer-events: none;
  top: calc(var(--space-1) + var(--space-2)); left: calc(-1 * var(--space-12));
  width: calc(var(--space-12) - var(--space-2));
  border-top: 1px solid var(--line-strong);
}
.aq-prose__notes > li::after {
  content: ""; position: absolute; pointer-events: none;
  top: calc(var(--space-1) + var(--space-2) - 2px); left: calc(-1 * var(--space-12) - 2px);
  width: 5px; height: 5px; border-radius: var(--radius-pill); background: var(--flow);
}
.aq-prose__row:hover .aq-prose__notes > li::before { border-top-color: var(--flow); }

@container (max-width: 860px) {
  /* Phones: one column; each paragraph's notes follow it as ruled lines, number and term at the right */
  .aq-prose--sheet { padding: var(--space-6) var(--space-4); gap: var(--space-6); }
  .aq-prose.aq-prose--sheet > p.aq-prose__lead { font-size: 22px; line-height: 30px; }
  .aq-prose__row { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
  .aq-prose__notes { grid-column: 1; gap: var(--space-2); }
  .aq-prose__notes > li { align-items: center; padding-top: 0; }
  .aq-prose__notes > li::before { position: static; order: -1; flex: 1 1 var(--space-6); width: auto; min-width: var(--space-6); }
  .aq-prose__notes > li::after { position: static; order: -2; flex: none; }
  .aq-prose__q { flex: 0 1 auto; text-align: right; }
}
