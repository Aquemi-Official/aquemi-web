/* ---------- ProcessDiagram: stages of a treatment train, left to right ---------- */
.aq-diagram { overflow-x: auto; }
.aq-diagram svg { display: block; max-width: 100%; min-width: 560px; height: auto; }
.aq-diagram__box { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
.aq-diagram__label { fill: var(--ink); font: 400 13px var(--font-sans); }
.aq-diagram__num { fill: var(--ink-muted); font: 500 10px var(--font-mono); letter-spacing: 0.08em; }
.aq-diagram__arrow { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-diagram__base { stroke: var(--line); stroke-width: 1; }
