/* ---------- StandardsMap: a plant map of the water system, each zone labelled with the standards that govern it ----------
   Desktop: zones as dashed framed areas in two rows, a flow-coloured pipe header between them, a branch from each zone to
   the pipe. Phones: zones stacked as compact rows on a vertical pipe at the left, codes as chips. Navy ground. */
.aq-standards-map { min-width: 0; }
.aq-standards-map__zones {
  position: relative; list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); grid-template-rows: auto var(--space-16) auto;
  column-gap: var(--space-8);
}
/* the pipe header: one flow line across the middle row, an arrow at its end */
.aq-standards-map__zones::before {
  content: ""; grid-row: 2; grid-column: 1 / -1; align-self: center; height: 0;
  border-top: 2px solid var(--flow);
}
.aq-standards-map__zones::after {
  content: ""; grid-row: 2; grid-column: -2 / -1; justify-self: end; align-self: center; margin-right: -2px;
  width: 0; height: 0; border-left: var(--space-2) solid var(--flow); border-block: 5px solid transparent;
}
.aq-standards-map__zone {
  position: relative; display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;
  padding: var(--space-6); border: 1px dashed var(--line-strong);
}
/* branch from each zone to the pipe, with a node where it joins */
.aq-standards-map__zone::after {
  content: ""; position: absolute; left: var(--space-12); height: calc(var(--space-8) - 1px); border-left: 2px solid var(--flow);
}
.aq-standards-map__zone.is-up::after { top: 100%; }
.aq-standards-map__zone.is-down::after { bottom: 100%; }
.aq-standards-map__zone::before {
  content: ""; position: absolute; left: calc(var(--space-12) - 3px); width: var(--space-2); height: var(--space-2);
  border-radius: var(--radius-pill); background: var(--flow);
}
.aq-standards-map__zone.is-up::before { top: calc(100% + var(--space-8) - 4px); }
.aq-standards-map__zone.is-down::before { bottom: calc(100% + var(--space-8) - 4px); }
.aq-standards-map__head { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
.aq-standards-map__head .aq-index { flex: none; }
.aq-standards-map__icon { flex: none; background-color: var(--flow); }
.aq-standards-map__t { margin: 0; font: 500 18px/26px var(--font-sans); color: var(--ink); text-wrap: balance; }
.aq-standards-map__t a { color: inherit; text-decoration: none; }
.aq-standards-map__t a:hover { color: var(--flow); text-decoration: underline; }
.aq-standards-map__codes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
.aq-standards-map__code {
  display: inline-block; padding: 1px var(--space-2); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  font: 400 13px/22px var(--font-mono); color: var(--ink); text-decoration: none; white-space: nowrap;
}
.aq-standards-map__code::after { content: "\a0\2193"; color: var(--ink-subtle); }
.aq-standards-map__code:hover { border-color: var(--flow); color: var(--flow); }
.aq-standards-map__code:hover::after { color: var(--flow); }
.aq-standards-map__code:focus-visible, .aq-standards-map__t a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
/* the row a code jumped to flashes once (it may sit on a light sheet) */
.aq-standards-map-hit { outline: 2px solid var(--flow); outline-offset: var(--space-1); animation: aq-standards-map-hit 2.4s ease-out forwards; }
.aq-standards-map-hit:focus { outline: 2px solid var(--flow); }
@keyframes aq-standards-map-hit { 0%, 60% { outline-color: var(--flow); } 100% { outline-color: transparent; } }
@media (prefers-reduced-motion: reduce) { .aq-standards-map-hit { animation: none; } }

@container (max-width: 860px) {
  .aq-standards-map__zones { display: flex; flex-direction: column; gap: var(--space-3); padding-left: var(--space-6); }
  .aq-standards-map__zones::before { position: absolute; align-self: auto; left: var(--space-1); top: var(--space-4); bottom: var(--space-4); height: auto; border-top: 0; border-left: 2px solid var(--flow); }
  .aq-standards-map__zones::after { display: none; }
  .aq-standards-map__zone { gap: var(--space-2); padding: var(--space-3) var(--space-4); }
  .aq-standards-map__zone.is-up::after, .aq-standards-map__zone.is-down::after {
    top: calc(var(--space-6) - 1px); bottom: auto; left: calc(-1 * var(--space-6) + var(--space-1)); width: calc(var(--space-6) - var(--space-1)); height: 0;
    border-left: 0; border-top: 2px solid var(--flow);
  }
  .aq-standards-map__zone.is-up::before, .aq-standards-map__zone.is-down::before { top: calc(var(--space-6) - 4px); bottom: auto; left: calc(-1 * var(--space-6) + 1px); }
  .aq-standards-map__t { font-size: 16px; line-height: 24px; }
  .aq-standards-map__code { font-size: 12px; line-height: 20px; }
}
