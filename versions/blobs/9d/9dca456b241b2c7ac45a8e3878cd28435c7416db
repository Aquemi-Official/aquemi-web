/* ---------- ParameterCallouts ---------- */
/* Design parameters called out on the page's equipment drawing. Desktop: a 2:1 figure (viewBox 200 x 100 for the
   leaders): label columns 0-25 % and 75-100 %, the drawing a centred square between them on a fading blueprint grid.
   Labels hang from a flow rule (the bottom label of a side stands on one); flow leaders run from the rule's inner end
   to a numbered pin on the drawing. Any rows that are not called out follow as a SpecTable. */
.aq-parameter-callouts { display: flex; flex-direction: column; gap: var(--space-8); }
.aq-parameter-callouts__fig { position: relative; aspect-ratio: 2 / 1; }
.aq-parameter-callouts__fig::before { content: ""; position: absolute; inset: 0 25%; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: var(--space-8) var(--space-8); background-position: center; -webkit-mask: radial-gradient(closest-side, var(--ink) 55%, transparent); mask: radial-gradient(closest-side, var(--ink) 55%, transparent); pointer-events: none; }
.aq-parameter-callouts__art { position: absolute; top: 0; bottom: 0; left: 25%; right: 25%; }
.aq-parameter-callouts__art .aq-illustration { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; aspect-ratio: auto; margin: 0; }
.aq-parameter-callouts__pins { position: absolute; inset: 0; }
.aq-parameter-callouts__pin { position: absolute; transform: translate(-50%, -50%); padding: 0 var(--space-1); border: 1px solid var(--flow); border-radius: var(--radius-sm); background: var(--surface); font: 500 11px/18px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); }
.aq-parameter-callouts__leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.aq-parameter-callouts__leaders line { stroke: var(--flow); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-parameter-callouts__list { list-style: none; margin: 0; padding: 0; }
.aq-parameter-callouts__item { position: absolute; width: 25%; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1); align-content: start; padding-top: var(--space-2); border-top: 1px solid var(--flow); }
.aq-parameter-callouts__item.is-l { left: 0; padding-right: var(--space-4); }
.aq-parameter-callouts__item.is-r { right: 0; padding-left: var(--space-4); }
.aq-parameter-callouts__item.is-up { border-top: 0; padding-top: 0; padding-bottom: var(--space-2); border-bottom: 1px solid var(--flow); }
.aq-parameter-callouts__item > .aq-index { grid-row: 1 / span 3; }
.aq-parameter-callouts__p { grid-column: 2; margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-parameter-callouts__v { grid-column: 2; margin: 0; font: 400 16px/22px var(--font-mono); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: break-word; }
.aq-parameter-callouts__v .aq-ph { font-size: inherit; }
.aq-parameter-callouts__m { grid-column: 2; margin: 0; font: 400 13px/18px var(--font-sans); color: var(--ink-muted); }

@container (max-width: 860px) {
  /* Phone: the drawing with its numbered pins on top, the numbered list below on hairlines */
  .aq-parameter-callouts { gap: var(--space-6); }
  .aq-parameter-callouts__fig { aspect-ratio: auto; }
  .aq-parameter-callouts__fig::before { inset: 0 0 auto; aspect-ratio: 1; }
  .aq-parameter-callouts__leaders { display: none; }
  .aq-parameter-callouts__art { position: relative; inset: auto; width: min(100%, calc(var(--space-32) * 2.5)); aspect-ratio: 1; margin-inline: auto; }
  .aq-parameter-callouts__pin { font-size: 10px; line-height: 16px; }
  .aq-parameter-callouts__list { margin-top: var(--space-4); border-bottom: 1px solid var(--line); }
  /* List rows as SpecTable phone rows: the parameter, then the value and " · " basis in one run */
  .aq-parameter-callouts__item, .aq-parameter-callouts__item.is-l, .aq-parameter-callouts__item.is-r, .aq-parameter-callouts__item.is-up { position: relative; display: block; width: auto; padding: var(--space-3) 0 var(--space-3) var(--space-8); border: 0; border-top: 1px solid var(--line); }
  .aq-parameter-callouts__item > .aq-index { position: absolute; left: 0; top: var(--space-3); line-height: 22px; }
  .aq-parameter-callouts__p { margin-bottom: var(--space-1); }
  .aq-parameter-callouts__v, .aq-parameter-callouts__m { display: inline; }
  .aq-parameter-callouts__m::before { content: "\a0\b7\a0"; content: "\a0\b7\a0" / ""; color: var(--ink-subtle); }
  .aq-parameter-callouts__p { font: 400 15px/22px var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--ink); }
  .aq-parameter-callouts__v { font-size: 14px; line-height: 22px; letter-spacing: 0; }
  .aq-parameter-callouts__m { font-size: 12px; line-height: 18px; }
}
