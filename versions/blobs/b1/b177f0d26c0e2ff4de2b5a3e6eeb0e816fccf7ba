/* ---------- Button ---------- */
.aq-btn {
  display: inline-flex; align-items: center; gap: var(--space-2);
  height: 44px; padding: 0 var(--space-6);
  border: 1px solid transparent; border-radius: var(--radius-sm);
  font: 500 14px/20px var(--font-sans); letter-spacing: 0; white-space: nowrap;
  text-decoration: none; cursor: pointer;
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-btn--primary { background: var(--action); color: var(--on-action); }
.aq-btn--primary:hover { background: var(--action-hover); }
.aq-btn--secondary { background: transparent; color: var(--ink); border-color: var(--line-strong); }
.aq-btn--secondary:hover { border-color: var(--ink); }
.aq-btn--link { height: auto; padding: 0; color: var(--flow); background: none; }
.aq-btn--link:hover { text-decoration: underline; text-underline-offset: 4px; }
.aq-btn[disabled] { background: var(--surface-sunken); color: var(--ink-subtle); border-color: transparent; cursor: not-allowed; }
.aq-btn__arrow { transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-btn:hover .aq-btn__arrow { transform: translateX(3px); }

@media (prefers-reduced-motion: reduce) {
  .aq-btn, .aq-btn__arrow { transition: none; }
}
