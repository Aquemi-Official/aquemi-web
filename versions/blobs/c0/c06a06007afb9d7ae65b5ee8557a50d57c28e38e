/* ---------- DerivationSheet: a grade table worked as numbered equation lines on a calculation pad ---------- */
.aq-derivation-sheet-sec { position: relative; }
.aq-derivation-sheet { position: relative; margin-top: var(--space-8); padding: var(--space-6) var(--space-8) var(--space-6) var(--space-16); background: var(--surface-raised);
  border: 1px solid var(--line-strong); overflow: hidden; }
.aq-derivation-sheet__grid { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.aq-derivation-sheet__grid path { fill: none; stroke: var(--line); stroke-width: 0.6; }
.aq-derivation-sheet__g5 path, .aq-derivation-sheet__grid pattern#aq-ds-grid5 path { stroke: var(--line); stroke-width: 1.2; }
.aq-derivation-sheet__margin { position: absolute; top: 0; bottom: 0; left: var(--space-12); width: var(--space-1); border-inline: 1px solid var(--flow); opacity: 0.7; transform-origin: 50% 0; }
.aq-derivation-sheet__lines { position: relative; list-style: none; margin: 0; padding: 0; }

.aq-derivation-sheet__line { position: relative; display: grid; align-items: center; column-gap: var(--space-4);
  grid-template-columns: minmax(0, 4fr) var(--space-12) minmax(0, 4fr) var(--space-12) minmax(0, 3fr); padding: var(--space-8) 0; }
.aq-derivation-sheet__line + .aq-derivation-sheet__line { border-top: 1px dashed var(--line-strong); }
.aq-derivation-sheet__no { position: absolute; left: calc(var(--space-12) * -1 - var(--space-1)); top: var(--space-8); width: var(--space-12); text-align: center;
  font: 400 14px/20px var(--font-mono); color: var(--flow); }
.aq-derivation-sheet__k { display: block; margin-bottom: var(--space-2); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-derivation-sheet__line + .aq-derivation-sheet__line .aq-derivation-sheet__k { display: none; }
.aq-derivation-sheet__given, .aq-derivation-sheet__lim, .aq-derivation-sheet__ans { min-width: 0; }
.aq-derivation-sheet__t { margin: 0; font: 300 24px/31px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); }
.aq-derivation-sheet__set { margin: 0; font: 400 15px/23px var(--font-mono); color: var(--ink-muted); }
.aq-derivation-sheet__op { display: block; width: var(--space-12); color: var(--ink-subtle); }
.aq-derivation-sheet__op svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-derivation-sheet__op path { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
.aq-derivation-sheet__op.is-imp { color: var(--flow); }

/* Hero figure: the number large, the unit beside it, the reference under a hairline */
.aq-derivation-sheet__v { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 var(--space-3); }
.aq-derivation-sheet__num { font: 300 72px/72px var(--font-mono); letter-spacing: -0.05em; color: var(--ink); font-variant-numeric: tabular-nums; }
.aq-derivation-sheet__u { font: 400 15px/20px var(--font-sans); color: var(--ink-muted); max-width: 12ch; }
.aq-derivation-sheet__ref { margin: var(--space-2) 0 0; padding-top: var(--space-2); border-top: 1px solid var(--line); font: 400 13px/20px var(--font-mono); color: var(--ink-muted); }

/* The answer, boxed */
.aq-derivation-sheet__ans { position: relative; padding: var(--space-4); }
.aq-derivation-sheet__w { position: relative; margin: 0; font: 400 19px/26px var(--font-sans); color: var(--ink); }
.aq-derivation-sheet__box { position: absolute; inset: 0; border: 1.5px solid var(--ink); pointer-events: none; }
.aq-derivation-sheet__box::after { content: ""; position: absolute; left: var(--space-1); right: var(--space-1); bottom: calc(var(--space-2) * -1); height: 0; border-top: 1px solid var(--ink); }
.aq-derivation-sheet__line:hover .aq-derivation-sheet__box { border-color: var(--flow); }
.aq-derivation-sheet__line:hover .aq-derivation-sheet__op { color: var(--flow); }

@container (max-width: 1100px) {
  .aq-derivation-sheet { padding-right: var(--space-6); }
  .aq-derivation-sheet__line { grid-template-columns: minmax(0, 1fr) var(--space-8) minmax(0, 1fr); row-gap: var(--space-4); }
  .aq-derivation-sheet__op { width: var(--space-8); }
  .aq-derivation-sheet__op.is-imp { grid-column: 2; }
  .aq-derivation-sheet__ans { grid-column: 3; }
  .aq-derivation-sheet__num { font-size: 60px; line-height: 60px; }
}

/* Phones: each line reads down the pad, arrows turned to point down, labels back on every line */
@container (max-width: 860px) {
  .aq-derivation-sheet { margin-top: var(--space-4); padding: var(--space-2) var(--space-4) var(--space-2) var(--space-12); }
  .aq-derivation-sheet__margin { left: var(--space-8); }
  .aq-derivation-sheet__line { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); padding: var(--space-6) 0; }
  .aq-derivation-sheet__no { left: calc(var(--space-8) * -1 - var(--space-3)); top: var(--space-6); width: var(--space-8); font-size: 13px; }
  .aq-derivation-sheet__line + .aq-derivation-sheet__line .aq-derivation-sheet__k { display: block; }
  .aq-derivation-sheet__op, .aq-derivation-sheet__op.is-imp { grid-column: 1; width: var(--space-8); transform: rotate(90deg); margin: var(--space-1) 0 var(--space-1) var(--space-2); }
  .aq-derivation-sheet__ans { grid-column: 1; }
  .aq-derivation-sheet__t { font-size: 20px; line-height: 27px; }
  .aq-derivation-sheet__num { font-size: 52px; line-height: 56px; }
}
