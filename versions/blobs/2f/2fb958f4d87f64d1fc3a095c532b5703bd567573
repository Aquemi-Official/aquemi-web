/* ---------- ProofFolders: an evidence table as a drawer of manila folders (look "proof-folders"). Each row is the
   standard set on the ground plus its folder (limestone, data-theme="light" so the paper keeps light-theme contrast in
   the dark theme): a tab with the code, a typed slip, clipped proof sheets struck with a stamp, a navy index label.
   Folders overlap upward so each tab sits over the folder before it; the tab steps right row by row. ---------- */
.aq-proof-folders { position: relative; }
.aq-proof-folders__cols, .aq-proof-folders__row { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 3.1fr); column-gap: var(--space-6); }
.aq-proof-folders__cols { padding-bottom: var(--space-6); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-proof-folders__cols { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr) minmax(0, 1.1fr) minmax(0, 0.75fr); }
.aq-proof-folders__cols span:nth-child(n+2) { padding-left: var(--space-6); }
.aq-proof-folders__list { list-style: none; margin: 0; padding: var(--space-8) 0 0; }
.aq-proof-folders__row { position: relative; align-items: start; }
.aq-proof-folders__row + .aq-proof-folders__row { margin-top: calc(-1 * var(--space-3)); }

/* The standard, on the ground */
/* the index is the row's own first child (so a standards-map chip matches the standard's cell alone) */
.aq-proof-folders__row > .aq-index { position: absolute; left: 0; top: var(--space-6); }
.aq-proof-folders__std { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-12); }
.aq-proof-folders__name { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-proof-folders__code { font: 300 30px/36px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); }
.aq-proof-folders__title { font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* The folder */
.aq-proof-folders__folder {
  position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1.1fr) minmax(0, 0.75fr); align-items: start;
  min-height: var(--space-32); padding: var(--space-6) 0 var(--space-8);
  background: var(--limestone); color: var(--on-limestone);
  border-top: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent);
  box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--on-limestone) 10%, transparent);
}
.aq-proof-folders__folder > div { padding: 0 var(--space-6); min-width: 0; }
.aq-proof-folders__tab {
  position: absolute; bottom: 100%; left: calc(var(--space-6) + var(--i, 0) * 13%); height: var(--space-8); padding: 0 var(--space-6) 0 var(--space-4);
  display: flex; align-items: center; background: var(--limestone); color: var(--on-limestone);
  border: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); border-bottom: 0;
  clip-path: polygon(0 0, calc(100% - var(--space-3)) 0, 100% 100%, 0 100%);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; white-space: nowrap;
}
/* every second folder a shade deeper, so the files read apart */
.aq-proof-folders__row:nth-child(even) .aq-proof-folders__folder, .aq-proof-folders__row:nth-child(even) .aq-proof-folders__tab { background: color-mix(in srgb, var(--limestone) 93%, var(--on-limestone)); }
/* the slip: typed, set slightly off square */
.aq-proof-folders__slip {
  margin: 0; padding: var(--space-4) var(--space-4) var(--space-6); background: var(--surface-raised); color: var(--ink);
  border: 1px solid var(--line); font: 400 15px/23px var(--font-mono); letter-spacing: -0.01em; transform: rotate(-0.6deg); text-wrap: pretty;
}
.aq-proof-folders__row:nth-child(even) .aq-proof-folders__slip { transform: rotate(0.5deg); }
/* the proof: sheets fanned under a clip */
.aq-proof-folders__proof { position: relative; padding-top: var(--space-2) !important; }
.aq-proof-folders__sheets { list-style: none; margin: 0; padding: 0; display: grid; }
.aq-proof-folders__sheet {
  grid-area: auto; position: relative; margin-top: calc(-1 * var(--space-1)); padding: var(--space-3) var(--space-4);
  background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line);
  font: 400 14px/20px var(--font-sans); transform: rotate(calc(1.2deg - var(--j, 0) * 1.6deg)) translateX(calc(var(--j, 0) * var(--space-2)));
}
.aq-proof-folders__sheet:first-child { margin-top: 0; }
.aq-proof-folders__clip {
  position: absolute; z-index: 1; top: calc(-1 * var(--space-2)); left: calc(var(--space-6) + var(--space-8)); width: var(--space-3); height: var(--space-8);
  border: 1.5px solid var(--line-strong); border-radius: var(--radius-pill);
}
.aq-proof-folders__clip::after { content: ""; position: absolute; inset: var(--space-1) calc(var(--space-1) / 2) var(--space-2); border: 1.5px solid var(--line-strong); border-radius: var(--radius-pill); }
/* the stamp, struck over the sheets */
.aq-proof-folders__stamp {
  position: absolute; right: var(--space-2); bottom: calc(-1 * var(--space-6)); z-index: 2; display: flex; flex-direction: column; align-items: center;
  padding: var(--space-1) var(--space-3); border: 3px double var(--flow); color: var(--flow);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; transform: rotate(-7deg); opacity: 0.88; pointer-events: none;
  mix-blend-mode: multiply;
}
.aq-proof-folders__stamp span + span { font-size: 12px; line-height: 14px; letter-spacing: 0.16em; }
.aq-proof-folders__row:nth-child(even) .aq-proof-folders__stamp { transform: rotate(5deg); right: auto; left: 45%; }
/* the index label: navy, the row's link */
.aq-proof-folders__label { margin: 0; padding: var(--space-3) var(--space-4); background: var(--navy); color: var(--on-navy); font: 400 15px/22px var(--font-sans); }
.aq-proof-folders__label a { color: inherit; text-decoration: none; display: block; }
.aq-proof-folders__label a::after { content: "\a0\2192"; }
.aq-proof-folders__label a:hover { text-decoration: underline; text-underline-offset: 3px; }
.aq-proof-folders__label:has(a) { position: relative; min-height: var(--space-12); box-sizing: border-box; }
.aq-proof-folders__label a::before { content: ""; position: absolute; inset: 0; }
.aq-proof-folders__label:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-proof-folders__label a:focus-visible { outline: none; }
/* cell names: read by screen readers on desktop (the column heads are drawn), shown on phones */
.aq-proof-folders__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
.aq-proof-folders .aq-fold__btn { margin-top: var(--space-8); }
.aq-proof-folders__row.aq-standards-map-hit .aq-proof-folders__folder { outline: 2px solid var(--flow); outline-offset: 2px; }

.aq-proof-folders-sec .aq-sec-head { margin-bottom: var(--space-2); }
.aq-proof-folders__how, .aq-proof-folders__go { position: relative; z-index: 1; }

/* motion slides parts in from the side; never let them widen the page */
.aq-section.aq-proof-folders-sec { overflow-x: clip; }

@container (max-width: 860px) {
  .aq-proof-folders__cols { display: none; }
  .aq-proof-folders__list { padding-top: var(--space-6); }
  .aq-proof-folders__row { grid-template-columns: minmax(0, 1fr); }
  .aq-proof-folders__row + .aq-proof-folders__row { margin-top: var(--space-6); }
  .aq-proof-folders__row > .aq-index { top: var(--space-1); }
  .aq-proof-folders__std { padding: 0 0 var(--space-8) var(--space-8); flex-direction: row; align-items: baseline; gap: var(--space-3); }
  .aq-proof-folders__code { font-size: 24px; line-height: 30px; }
  .aq-proof-folders__folder { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); padding: var(--space-4) 0 var(--space-6); min-height: 0; }
  .aq-proof-folders__folder > div { padding: 0 var(--space-4); }
  .aq-proof-folders__tab { left: calc(var(--space-4) + var(--i, 0) * 8%); }
  .aq-proof-folders__k { position: static; width: auto; height: auto; overflow: visible; clip-path: none; margin: 0 0 var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
  .aq-proof-folders__clip { left: auto; right: var(--space-8); }
  .aq-proof-folders__stamp, .aq-proof-folders__row:nth-child(even) .aq-proof-folders__stamp { bottom: calc(-1 * var(--space-4)); right: var(--space-4); left: auto; }
}
