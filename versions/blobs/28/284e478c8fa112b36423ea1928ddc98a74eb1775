.aq-module-plinth:has(.aq-module-plinth__card[data-k="7"]:hover) .aq-module-plinth__blk[data-k="7"], .aq-module-plinth:has(.aq-module-plinth__card[data-k="7"]:focus-within) .aq-module-plinth__blk[data-k="7"] { transform: translateY(-6px); }
.aq-module-plinth:has(.aq-module-plinth__card[data-k="7"]:hover) .aq-module-plinth__blk[data-k="7"] path, .aq-module-plinth:has(.aq-module-plinth__card[data-k="7"]:focus-within) .aq-module-plinth__blk[data-k="7"] path { stroke: var(--limestone); }
.aq-module-plinth:has(.aq-module-plinth__card[data-k="7"]:hover) .aq-module-plinth__mk[data-k="7"], .aq-module-plinth:has(.aq-module-plinth__card[data-k="7"]:focus-within) .aq-module-plinth__mk[data-k="7"] { background: var(--limestone); color: var(--navy); border-color: var(--limestone); }

@container (max-width: 1100px) {
  .aq-module-plinth { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); }
  .aq-module-plinth__fig { position: relative; top: auto; max-width: calc(var(--space-32) * 5); }
}

/* Phones: the drawing on top, the cards in one column, the fold back on */
@container (max-width: 860px) {
  .aq-module-plinth { margin-top: var(--space-4); row-gap: var(--space-6); }
  .aq-module-plinth__mk { min-width: var(--space-6); height: var(--space-4); font-size: 11px; }
  .aq-module-plinth__base { font-size: 11px; }
  .aq-module-plinth__cards { grid-template-columns: minmax(0, 1fr); }
  .aq-module-plinth__card { padding: var(--space-4); }
  .aq-module-plinth__t { font-size: 17px; line-height: 22px; }
  .aq-fold:not(.is-open) .aq-module-plinth__card.aq-fold-x { display: none; }
  .aq-module-plinth__list .aq-fold__btn { display: flex; }
}
