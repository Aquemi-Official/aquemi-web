/* ---------- Readout: the page's one highlighted figure ---------- */
/* The brand's "proof in numbers": one measurement set large in Geist Mono Light in flow, its unit beside it,
   the method on a limit tag (the StandardTag look), and a one-sentence caption. No frame: white space carries it.
   A limit (--limit) adds a 1 px flow rule under the reading. */
.aq-readout {
  display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  column-gap: var(--space-12); row-gap: var(--space-6); align-items: end;
}

/* Head: reading on the left, the method tag on the right; font-size here sets the figure */
.aq-readout__head { display: contents; }

.aq-readout__reading {
  grid-column: 1; grid-row: 1 / span 2; align-self: end;
  margin: 0; min-width: 0; padding-bottom: var(--space-4);
  display: flex; flex-wrap: wrap; align-items: baseline;
  font: 300 clamp(64px, 10cqi, 128px)/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-readout--limit .aq-readout__reading { border-bottom: 1px solid var(--flow); }
.aq-readout__figure { min-width: 0; overflow-wrap: anywhere; }
.aq-readout__figure .aq-ph { letter-spacing: -0.02em; }
/* Comparator (<, ≤): smaller, in ink-muted */
.aq-readout__cmp { font-size: 0.45em; letter-spacing: 0; color: var(--ink-muted); }
/* Unit: on the baseline beside the figure */
.aq-readout__unit { margin-left: var(--space-2); font: 400 28px/34px var(--font-mono); letter-spacing: 0; color: var(--ink); }
/* Condition ("@ 25 °C"): small, on its own line under the figure; -1ch cancels the leading no-break space */
.aq-readout__cond {
  flex-basis: 100%; margin: var(--space-3) 0 0 -1ch;
  font: 400 14px/22px var(--font-mono); letter-spacing: 0; color: var(--ink-muted);
}

/* Method: the limit tag, as StandardTag draws it */
.aq-readout__ref { grid-column: 2; grid-row: 1; display: flex; min-width: 0; }
.aq-readout__tag {
  display: inline-flex; align-items: center; min-height: 28px; max-width: 100%; padding: var(--space-1) var(--space-3);
  border: 1px solid var(--line-strong); border-radius: var(--radius-pill);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--ink);
  overflow-wrap: anywhere;
}

.aq-readout__caption { grid-column: 2; grid-row: 2; margin: 0; min-width: 0; }

@container (max-width: 860px) {
  .aq-readout { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); }
  .aq-readout__reading { grid-column: 1; grid-row: auto; font-size: clamp(48px, 16cqi, 88px); }
  /* Unit drops under the figure */
  .aq-readout__unit { flex-basis: 100%; margin: var(--space-2) 0 0 -1ch; font-size: 24px; line-height: 30px; }
  .aq-readout__ref, .aq-readout__caption { grid-column: 1; grid-row: auto; }
}
