/* ---------- ContactRoutes: the ways in, as rows on hairlines (block contact-routes) ----------
   Each route is a row: an eyebrow ("Route N", plus "Urgent" / "This page"), a head (title and one line on the left;
   the response clock and the action on the right), and a numbered 1 → 2 → 3 strip along its foot under a hairline.
   Rows are separated by line hairlines on the page ground. The route for this page (is-current) has a flow top
   hairline; the urgent route (is-urgent) sits on a quiet limestone panel with a call line. Desktop keeps the data
   order (--o); phones stack in markup order, urgent first. */
.aq-contact-routes {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: minmax(0, 1fr);
  border-bottom: 1px solid var(--line);
}
.aq-contact-routes__route {
  order: var(--o, 0); min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-6);
  padding: var(--space-8);
  border-top: 1px solid var(--line); color: var(--ink);
}
.aq-contact-routes__route.is-current { border-top-color: var(--flow); }
.aq-contact-routes__route.is-urgent { background: var(--limestone); color: var(--on-limestone); border-top-color: transparent; }

/* Eyebrow: Route N · Urgent · This page */
.aq-contact-routes__tab {
  margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-contact-routes__rn { font-variant-numeric: tabular-nums; }
.aq-contact-routes__mark { display: inline-flex; align-items: center; gap: var(--space-3); color: var(--ink); }
.aq-contact-routes__mark::before { content: "·"; content: "·" / ""; color: var(--ink-muted); }
.aq-contact-routes__route.is-current .aq-contact-routes__mark { color: var(--flow); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__tab { color: var(--on-limestone-muted); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__mark { color: var(--on-limestone); }
.aq-contact-routes__dot { display: none; }

/* Head: title and one line on the left; response clock and action on the right */
.aq-contact-routes__head { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: var(--space-12); row-gap: var(--space-4); align-items: start; }
.aq-contact-routes__main { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.aq-contact-routes__side { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
.aq-contact-routes__t { margin: 0; font: 400 28px/34px var(--font-sans); letter-spacing: -0.01em; color: inherit; overflow-wrap: break-word; text-wrap: balance; }
.aq-contact-routes__d { margin: 0; max-width: var(--text-max); font: 400 16px/26px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-contact-routes__route.is-urgent .aq-contact-routes__d { color: var(--on-limestone-muted); }

/* Response clock */
.aq-contact-routes__clock {
  margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: var(--space-2); row-gap: var(--space-1);
}
.aq-contact-routes__icon { width: 16px; height: 16px; background-color: var(--ink-muted); }
.aq-contact-routes__k { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__k { color: var(--on-limestone-muted); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__icon { background-color: var(--on-limestone-muted); }
.aq-contact-routes__v { grid-column: 1 / -1; font: 400 15px/24px var(--font-sans); color: inherit; overflow-wrap: break-word; }
.aq-contact-routes__action .aq-btn { width: 100%; height: auto; min-height: 44px; padding-block: var(--space-2); justify-content: center; text-align: center; white-space: normal; }

/* Call line: the urgent route's number, large in mono */
.aq-contact-routes__call {
  margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-1);
  padding-top: var(--space-4); border-top: 1px solid var(--line-strong); color: inherit;
}
.aq-contact-routes__call .aq-contact-routes__icon { width: 20px; height: 20px; align-self: center; }
.aq-contact-routes__num { font: 300 40px/44px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
.aq-contact-routes__num .aq-ph { font-size: 0.6em; }
a.aq-contact-routes__num:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }

/* Step strip: three numbered steps under a hairline, an arrow between them */
.aq-contact-routes__steps {
  list-style: none; margin: 0; padding: var(--space-4) 0 0;
  border-top: 1px solid var(--line);
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-8);
}
.aq-contact-routes__route.is-urgent .aq-contact-routes__steps { border-top-color: var(--line-strong); }
.aq-contact-routes__steps > li { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); align-items: baseline; min-width: 0; }
.aq-contact-routes__n { font: 400 13px/22px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__n { color: var(--on-limestone-muted); }
.aq-contact-routes__s { font: 400 15px/22px var(--font-sans); color: inherit; overflow-wrap: break-word; text-wrap: pretty; }
.aq-contact-routes__arrow { position: absolute; right: calc(-1 * var(--space-6)); top: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-subtle); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__arrow { color: var(--on-limestone-muted); }

/* Motion hooks (motion.js): --aq-riser grows the route line down, --aq-stub runs each sheet's stub in and lands its
   arrowhead, --aq-line runs the step strip's dashed line. All default to 1: the drawing is complete without motion. */
.aq-contact-routes::before { transform: scaleY(var(--aq-riser, 1)); transform-origin: center top; }
.aq-contact-routes__route::before { transform: scaleX(var(--aq-stub, 1)); transform-origin: left center; }
.aq-contact-routes__route::after { opacity: var(--aq-stub, 1); }
.aq-contact-routes__steps::before { transform: scaleX(var(--aq-line, 1)); transform-origin: left center; }
@media (prefers-reduced-motion: no-preference) {
  .aq-contact-routes__route { transition: border-color 160ms; }
  .aq-contact-routes__route:not(.is-current):not(.is-urgent):hover { border-color: var(--ink-muted); }
  .aq-contact-routes__action .aq-btn__arrow { display: inline-block; transition: transform 160ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-contact-routes__action .aq-btn:hover .aq-btn__arrow { transform: translateY(2px); }
}

@container (max-width: 860px) {
  .aq-contact-routes__route { order: 0; gap: var(--space-4); padding: var(--space-6) var(--space-4); }
  .aq-contact-routes__route:not(.is-urgent) { padding-inline: 0; }
  /* the head opens up so the urgent call line sits right under the title, above the clock and the action */
  .aq-contact-routes__head { display: contents; }
  .aq-contact-routes__main { order: 0; }
  .aq-contact-routes__call { order: 1; }
  .aq-contact-routes__side { order: 2; gap: var(--space-3); }
  .aq-contact-routes__steps { order: 3; }
  .aq-contact-routes__t { font-size: 22px; line-height: 28px; }
  .aq-contact-routes__d { font-size: 15px; line-height: 24px; }
  .aq-contact-routes__v { font-size: 14px; line-height: 22px; }
  .aq-contact-routes__num { font-size: 28px; line-height: 34px; }
  /* steps stack: one per line, numbered */
  .aq-contact-routes__steps { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); padding-top: var(--space-3); }
  .aq-contact-routes__s { font-size: 14px; line-height: 22px; }
  .aq-contact-routes__n { font-size: 12px; }
  .aq-contact-routes__arrow { display: none; }
}
