/* ---------- EnquiryForm ---------- */
.aq-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); max-width: 880px; }
.aq-form .aq-field { max-width: none; }
.aq-form__full { grid-column: 1 / -1; }
.aq-form__actions { grid-column: 1 / -1; display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap; }
.aq-form [hidden] { display: none; }
.aq-field__file { font: 400 14px/22px var(--font-sans); color: var(--ink); padding: var(--space-4); border: 1px dashed var(--line-strong); border-radius: var(--radius-sm); background: var(--surface-sunken); }
.aq-field__file:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Stepped variant */
.aq-form--steps { gap: var(--space-8); }
.aq-form__progress { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--space-6); margin: 0; padding: 0 0 var(--space-4); list-style: none; counter-reset: aq-form-step; border-bottom: 1px solid var(--line); }
.aq-form__progress li { counter-increment: aq-form-step; font: 500 14px/20px var(--font-sans); color: var(--ink-subtle); }
.aq-form__progress li::before { content: counter(aq-form-step, decimal-leading-zero) ' '; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-subtle); }
.aq-form__progress li[aria-current="step"], .aq-form__progress li[aria-current="step"]::before { color: var(--flow); }
.aq-form__step { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); border: 0; margin: 0; padding: 0; min-width: 0; }
.aq-form__step[hidden] { display: none; }
.aq-form__step > legend { grid-column: 1 / -1; padding: 0; margin-bottom: var(--space-2); }

@container (max-width: 860px) {
  .aq-form, .aq-form__step { grid-template-columns: minmax(0, 1fr); }
}
