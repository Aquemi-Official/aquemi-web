/* ---------- WetRunHmi: the test bay's operator screen, dry or with water (look "wet-run-hmi") ----------
   A dark section (data-theme="dark" on the section, so every token inside takes its dark value in both themes).
   Desktop: the heading and the alarm list on the left (4 of 12), the screen on the right. The screen is a raised panel
   with a status bar (lamp, the two-position switch) over the mimic: flat process symbols in line-strong on a faint
   grid, the water as flow lines over the empty pipe, readout bars, the record's trend. State lives on the screen:
   is-wet (default, complete without script) or is-dry. Markers are HTML over the mimic, placed in % of its box. */
.aq-wet-run-hmi-sec, .aq-section--alt.aq-wet-run-hmi-sec { background: var(--surface); color: var(--ink); }
.aq-wet-run-hmi { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-12); align-items: start; }
.aq-wet-run-hmi__side { display: flex; flex-direction: column; gap: var(--space-8); }
.aq-wet-run-hmi__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
.aq-wet-run-hmi__pt { position: relative; display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); column-gap: var(--space-3); padding: var(--space-4) 0; border-bottom: 1px solid var(--line); outline: none; }
.aq-wet-run-hmi__pt:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-wet-run-hmi__n { grid-row: 1 / span 2; align-self: start; display: inline-flex; align-items: center; justify-content: center; width: var(--space-8); height: var(--space-8);
  border: 1.5px solid var(--flow); color: var(--flow); font: 500 12px/1 var(--font-mono); letter-spacing: 0.04em; }
.aq-wet-run-hmi__t { margin: 0; font: 500 17px/24px var(--font-sans); color: var(--ink); }
.aq-wet-run-hmi__d { margin: var(--space-1) 0 0; font: 400 15px/23px var(--font-sans); color: var(--ink-muted); }

/* the screen */
.aq-wet-run-hmi__screen { position: relative; background: var(--surface-raised); border: 1px solid var(--line-strong); }
.aq-wet-run-hmi__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4); border-bottom: 1px solid var(--line); }
.aq-wet-run-hmi__lamp { width: var(--space-3); height: var(--space-3); border-radius: 50%; border: 1.5px solid var(--flow); transition: background-color 200ms; }
.is-wet .aq-wet-run-hmi__lamp { background: var(--flow); }
.aq-wet-run-hmi__switch { display: inline-flex; border: 1px solid var(--line-strong); }
.aq-wet-run-hmi__mode { min-height: 44px; min-width: 88px; padding: 0 var(--space-4); border: 0; background: transparent; color: var(--ink-muted); cursor: pointer;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; transition: background-color 200ms, color 200ms; }
.aq-wet-run-hmi__mode[aria-pressed="true"] { background: var(--flow); color: var(--surface); }
.aq-wet-run-hmi__mode:hover:not([aria-pressed="true"]) { color: var(--ink); }
.aq-wet-run-hmi__mode:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-wet-run-hmi__mimic { position: relative; padding: var(--space-6); }
.aq-wet-run-hmi__svg { display: block; width: 100%; height: auto; aspect-ratio: 800 / 420; overflow: visible; }
.aq-wet-run-hmi__grid { fill: none; stroke: var(--line); stroke-width: 1; opacity: 0.5; }
.aq-wet-run-hmi__grid2 { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
.aq-wet-run-hmi__ln { fill: none; stroke: var(--line-strong); stroke-width: 8; stroke-linecap: square; opacity: 0.35; }
.aq-wet-run-hmi__fl { fill: none; stroke: var(--flow); stroke-width: 3; stroke-linecap: round; transition: opacity 400ms; }
.aq-wet-run-hmi__eq { fill: var(--surface-raised); stroke: var(--line-strong); stroke-width: 1.5; stroke-linejoin: round; }
.aq-wet-run-hmi__thin { fill: none; stroke: var(--line-strong); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
.aq-wet-run-hmi__tag { font: 500 13px/1 var(--font-mono); letter-spacing: 0.08em; fill: var(--ink-muted); }
.aq-wet-run-hmi__rd { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-wet-run-hmi__rdv { fill: var(--flow); transform-box: fill-box; transform-origin: 0 50%; transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
.aq-wet-run-hmi__trend { fill: none; stroke: var(--flow); stroke-width: 2; stroke-linejoin: round; transition: opacity 400ms; }
.aq-wet-run-hmi__flat { fill: none; stroke: var(--ink-subtle); stroke-width: 1.5; stroke-dasharray: 4 4; opacity: 0; transition: opacity 400ms; }
.aq-wet-run-hmi__log { fill: none; stroke: var(--ink-subtle); stroke-width: 4; transition: opacity 400ms; }
.aq-wet-run-hmi__sig { fill: none; stroke: var(--ink-subtle); stroke-width: 1; stroke-dasharray: 3 5; }
.aq-wet-run-hmi__mk { position: absolute; transform: translate(-50%, -50%); display: inline-flex; align-items: center; justify-content: center; width: var(--space-8); height: var(--space-8);
  border-radius: 50%; background: var(--flow); color: var(--surface); font: 500 12px/1 var(--font-mono); letter-spacing: 0.04em;
  box-shadow: 0 0 0 var(--space-1) var(--surface-raised), 0 0 0 calc(var(--space-1) + 1.5px) var(--flow); transition: background-color 300ms, color 300ms, box-shadow 300ms, transform 200ms cubic-bezier(0.2, 0, 0, 1); }
/* dry: empty pipes, blank readouts, findings unlit */
.is-dry .aq-wet-run-hmi__fl, .is-dry .aq-wet-run-hmi__trend { opacity: 0; }
.is-dry .aq-wet-run-hmi__flat { opacity: 1; }
.is-dry .aq-wet-run-hmi__log { opacity: 0.25; }
.is-dry .aq-wet-run-hmi__rdv { transform: scaleX(0); }
.is-dry .aq-wet-run-hmi__mk { background: var(--surface-raised); color: var(--ink-subtle); box-shadow: 0 0 0 var(--space-1) var(--surface-raised), 0 0 0 calc(var(--space-1) + 1.5px) var(--line-strong); }
/* pointing at a finding lights its marker */
.aq-wet-run-hmi:has(.aq-wet-run-hmi__pt[data-part="divert"]:is(:hover, :focus-visible)) .aq-wet-run-hmi__mk[data-part="divert"],
.aq-wet-run-hmi:has(.aq-wet-run-hmi__pt[data-part="outlet"]:is(:hover, :focus-visible)) .aq-wet-run-hmi__mk[data-part="outlet"],
.aq-wet-run-hmi:has(.aq-wet-run-hmi__pt[data-part="record"]:is(:hover, :focus-visible)) .aq-wet-run-hmi__mk[data-part="record"] { transform: translate(-50%, -50%) scale(1.35); }
.aq-wet-run-hmi__pt:hover .aq-wet-run-hmi__n, .aq-wet-run-hmi__pt:focus-visible .aq-wet-run-hmi__n { background: var(--flow); color: var(--surface); }

@container (max-width: 860px) {
  .aq-wet-run-hmi { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .aq-wet-run-hmi__side { display: contents; }
  .aq-wet-run-hmi__side > .aq-sec-head { order: 0; }
  .aq-wet-run-hmi__screen { order: 1; }
  .aq-wet-run-hmi__list { order: 2; }
  .aq-wet-run-hmi__mimic { padding: var(--space-3); }
  .aq-wet-run-hmi__tag { display: none; }
  .aq-wet-run-hmi__mk { width: var(--space-6); height: var(--space-6); }
  .aq-wet-run-hmi__mode { min-width: 0; flex: 1; }
  .aq-wet-run-hmi__switch { flex: 1; }
  .aq-wet-run-hmi__t { font-size: 16px; line-height: 22px; }
  .aq-wet-run-hmi__d { font-size: 14px; line-height: 22px; }
}
