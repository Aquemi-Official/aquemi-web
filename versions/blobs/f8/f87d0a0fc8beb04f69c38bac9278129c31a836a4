/* ---------- CaseStudy ---------- */
.aq-cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); }
.aq-case { border-top: 1px solid var(--line-strong); padding-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
.aq-case > dl:not(.aq-case__profile) { margin: 0; display: grid; gap: var(--space-2); }
.aq-case dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case > dl:not(.aq-case__profile) dd { margin: 0 0 var(--space-2); }
.aq-cases:has(> :only-child) .aq-case > dl:not(.aq-case__profile),
.aq-cases--sheet .aq-case > dl:not(.aq-case__profile) { grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); column-gap: var(--space-8); row-gap: var(--space-4); }
.aq-cases:has(> :only-child) .aq-case > dl:not(.aq-case__profile) dd,
.aq-cases--sheet .aq-case > dl:not(.aq-case__profile) dd { margin: 0; }

/* Sheet layout: one case per row, so a project profile strip has room. */
.aq-cases--sheet { grid-template-columns: minmax(0, 1fr); gap: var(--space-16); }

/* Status label: says the case is a template or awaiting client approval. */
.aq-case__status { align-self: flex-start; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--caution); background: var(--caution-tint); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); }

/* Project profile: the KeyFacts strip, tightened to sit inside a case. */
.aq-case__profile { border-top-color: var(--line); margin-bottom: var(--space-4); }
.aq-case__profile > div { padding-top: var(--space-4); }

@container (max-width: 860px) {
  .aq-cases:has(> :only-child) .aq-case > dl:not(.aq-case__profile),
  .aq-cases--sheet .aq-case > dl:not(.aq-case__profile) { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
}
