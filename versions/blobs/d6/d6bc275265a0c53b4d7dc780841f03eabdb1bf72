/* ---------- OptionList: configuration options as numbered module tiles on a technical grid ---------- */
/* Columns: at most 4 (4, 7 or 8 options) or 3 (5 or 6 options); tiles never narrower than 240 px, so the grid
   steps down by itself at tablet width. Gap and grid padding are both the same step, so each flow segment exactly spans it. */
.aq-options {
  counter-reset: aq-option;
  list-style: none; margin: 0;
  display: grid; gap: var(--space-6);
  grid-template-columns: repeat(auto-fill, minmax(max(calc(var(--space-24) * 2.5), calc((100% - 3 * var(--space-6)) / 4)), 1fr));
  padding: var(--space-6);
  border: 1px solid var(--line);
  background-color: var(--surface);
  background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: var(--space-6) var(--space-6);
  background-position: -1px -1px;
}
.aq-options:has(> :nth-child(5)):not(:has(> :nth-child(7))) { grid-template-columns: repeat(auto-fill, minmax(max(calc(var(--space-24) * 2.5), calc((100% - 2 * var(--space-6)) / 3)), 1fr)); }

.aq-options__item {
  counter-increment: aq-option;
  position: relative; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  padding: var(--space-4) var(--space-6) var(--space-6);
  background: var(--surface-raised);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-0);
}
/* Flow line: an inlet segment into every tile at the height of its number, spanning the gap or the grid padding */
.aq-options__item::before,
.aq-options__item:last-child::after {
  content: ""; position: absolute;
  top: calc(var(--space-4) + var(--space-2) - 1px);
  width: var(--space-6);
  border-top: 2px solid var(--flow);
}
.aq-options__item::before { left: calc(-1 * var(--space-6) - 1px); }
/* Outlet after the last tile, out to the grid edge */
.aq-options__item:last-child::after { right: calc(-1 * var(--space-6) - 1px); }

/* Tag row: module number and a decorative "available option" mark, above a hairline */
.aq-options__tag {
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
  padding-bottom: var(--space-3); margin-bottom: var(--space-2);
  border-bottom: 1px solid var(--line);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--flow);
}
.aq-options__tag::before { content: counter(aq-option, decimal-leading-zero); }
.aq-options__mark {
  position: relative; flex: none;
  width: calc(var(--space-6) + var(--space-1)); height: var(--space-4);
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
}
.aq-options__mark::after {
  content: ""; position: absolute; top: 2px; bottom: 2px; right: 2px; aspect-ratio: 1;
  background: var(--flow); border-radius: var(--radius-sm);
}
.aq-options__item .aq-h3, .aq-options__item .aq-small { margin: 0; }

@container (max-width: 860px) {
  /* Phones: one stacked column; the flow line turns vertical and drops into each tile beside its number */
  .aq-options { gap: var(--space-4); padding: var(--space-4); }
  .aq-options, .aq-options:has(> :nth-child(5)):not(:has(> :nth-child(7))) { grid-template-columns: minmax(0, 1fr); }
  .aq-options__item { padding: var(--space-4); }
  .aq-options__item::before,
  .aq-options__item:last-child::after {
    left: calc(var(--space-4) + var(--space-2) - 1px); right: auto;
    width: 0; height: var(--space-4);
    border-top: 0; border-left: 2px solid var(--flow);
  }
  .aq-options__item::before { top: calc(-1 * var(--space-4) - 1px); }
  .aq-options__item:last-child::after { top: auto; bottom: calc(-1 * var(--space-4) - 1px); }
}
