/* ---------- BackToTop: a quiet floating button that returns to the top of a long page ---------- */
/* Fixed bottom right. Hidden (and out of the tab order) until the reader is well down the page, then it fades in.
   A control, so radius-sm and a line-strong rule; it floats, so it takes shadow-overlay (the brand book's one shadow). */
.aq-back-to-top {
  position: fixed; right: var(--space-8); bottom: var(--space-8); z-index: 30;
  display: inline-flex; align-items: center; gap: var(--space-2); height: 44px; padding: 0 var(--space-4);
  background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  box-shadow: var(--shadow-overlay); font: 500 14px/20px var(--font-sans); cursor: pointer;
  opacity: 0; visibility: hidden; transform: translateY(var(--space-2));
  transition: opacity 200ms cubic-bezier(0.2, 0, 0, 1), transform 200ms cubic-bezier(0.2, 0, 0, 1), visibility 0s linear 200ms, border-color 200ms, color 200ms;
}
.aq-back-to-top.is-shown { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
.aq-back-to-top:hover { border-color: var(--ink); }
.aq-back-to-top:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-back-to-top__arrow { color: var(--flow); font-family: var(--font-mono); transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-back-to-top:hover .aq-back-to-top__arrow { transform: translateY(calc(-1 * var(--space-1))); }

@media (prefers-reduced-motion: reduce) {
  .aq-back-to-top, .aq-back-to-top__arrow { transition: none; transform: none; }
}

/* Phones: the arrow alone in a 44 px square, inside the 16 px gutter; the label stays for screen readers */
@container (max-width: 860px) {
  .aq-back-to-top { right: var(--space-4); bottom: var(--space-4); width: 44px; padding: 0; justify-content: center; }
  .aq-back-to-top__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
}
