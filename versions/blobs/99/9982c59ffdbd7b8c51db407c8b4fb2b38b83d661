}

/* ---------- NavBar and phone menu ---------- */
/* Like the tab strip of a drawing set: ruled cells, a mono index number on every section, a corner-marked frame round the one action. */
.aq-nav {
  position: relative; display: flex; align-items: center; gap: var(--space-6);
  height: 72px; padding: 0 var(--space-8);
  background: var(--surface); border-bottom: 1px solid var(--line);
}
.aq-nav__home { display: flex; align-items: center; align-self: stretch; padding-right: var(--space-6); border-right: 1px solid var(--line); }
.aq-nav__logo { width: 112px; height: auto; }
.aq-nav__logo--lockup { width: 152px; }

.aq-nav__links { display: flex; align-self: stretch; margin: 0; padding: 0; list-style: none; flex: 1; min-width: 0; }
.aq-nav__links li { display: flex; }
.aq-nav__links li + li { border-left: 1px solid var(--line); }
.aq-nav__links a {
  position: relative; display: flex; flex-direction: column; justify-content: center; gap: var(--space-1);
  padding: 0 var(--space-4); color: var(--ink-muted); text-decoration: none; font: 500 14px/20px var(--font-sans); white-space: nowrap;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__num { font: 500 11px/12px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-subtle); font-variant-numeric: tabular-nums; }
.aq-nav__label { display: block; }
.aq-nav__links a:hover { color: var(--ink); }
.aq-nav__links a[aria-current="page"] { color: var(--ink); background: var(--surface-sunken); }
.aq-nav__links a[aria-current="page"] .aq-nav__num { color: var(--flow); }
.aq-nav__links a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; border-bottom: 2px solid var(--flow); }
.aq-nav__links a:focus-visible { outline-offset: -2px; }

/* Corner-marked frame: four L-shaped registration marks drawn in currentColor round the button */
.aq-nav__frame {
  display: inline-flex; padding: var(--space-1); color: var(--line-strong);
  background:
    linear-gradient(currentColor, currentColor) left top / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) left top / 1px var(--space-2),
    linear-gradient(currentColor, currentColor) right top / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) right top / 1px var(--space-2),
    linear-gradient(currentColor, currentColor) left bottom / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) left bottom / 1px var(--space-2),
    linear-gradient(currentColor, currentColor) right bottom / var(--space-2) 1px,
    linear-gradient(currentColor, currentColor) right bottom / 1px var(--space-2);
  background-repeat: no-repeat;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__frame:hover, .aq-nav__frame:focus-within { color: var(--flow); }
.aq-nav__toggle { display: none; }

/* Phone menu: numbered sections, a rule, the page's section jump, then the proposal button */
.aq-menu { display: none; }
.aq-menu__list { display: grid; margin: 0; padding: 0; list-style: none; }
.aq-menu__list a {
  display: flex; align-items: baseline; gap: var(--space-3);
  padding: var(--space-3) var(--space-2); color: var(--ink); text-decoration: none;
  font: 400 20px/28px var(--font-sans); border-bottom: 1px solid var(--line);
}
.aq-menu__list .aq-nav__num { font-size: 12px; line-height: 16px; min-width: var(--space-6); }
.aq-menu__list--jump a { padding-block: var(--space-2); font: 400 16px/24px var(--font-sans); color: var(--ink-muted); }
.aq-menu__list a[aria-current] { color: var(--ink); background: var(--surface-sunken); box-shadow: inset 2px 0 0 var(--flow); }
.aq-menu__list a[aria-current] .aq-nav__num { color: var(--flow); }
.aq-menu__list a[aria-current]::after { content: "→"; content: "→" / ""; margin-left: auto; color: var(--flow); }
.aq-menu__list a:focus-visible { outline-offset: -2px; }
.aq-menu__jump { display: grid; }
.aq-menu__label {
  padding: var(--space-4) var(--space-2) var(--space-2); border-top: 1px solid var(--line-strong);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-menu__cta { display: flex; }
.aq-menu__cta .aq-btn { flex: 1; justify-content: center; }

@media (prefers-reduced-motion: reduce) {
  .aq-nav__links a, .aq-nav__frame { transition: none; }
}

/* Mid widths: tighten the cells before the phone layout takes over */
@container (max-width: 1080px) {
  .aq-nav { gap: var(--space-4); padding: 0 var(--space-6); }
  .aq-nav__home { padding-right: var(--space-4); }
  .aq-nav .aq-nav__logo--lockup { width: 140px; }
  .aq-nav__links a { padding: 0 var(--space-3); }
  .aq-nav__frame .aq-btn { padding: 0 var(--space-4); }
}

@container (max-width: 860px) {
  .aq-nav { padding: 0 var(--space-4); gap: var(--space-4); }
  .aq-nav__home { padding-right: 0; border-right: 0; }
  .aq-nav__links, .aq-nav > .aq-nav__frame { display: none; }
  .aq-nav__spacer { flex: 1; }
  .aq-nav__toggle { display: inline-flex; }
  .aq-nav .aq-nav__logo--lockup { width: 112px; }
  .aq-menu {
    display: grid; gap: var(--space-4); padding: var(--space-2) var(--space-4) var(--space-6);
    background: var(--surface); border-bottom: 1px solid var(--line);
  }
}

/* ---------- SectionNav ---------- */
/* Like the revision bar of a drawing set: label cell, numbered jump links (the one being read is boxed), page progress cell. */
.aq-section-nav { position: sticky; top: 0; z-index: 5; background: var(--surface); border-bottom: 1px solid var(--line); }
.aq-section-nav .aq-in { display: flex; align-items: stretch; min-height: 56px; }
.aq-section-nav__label {
  display: flex; align-items: center; gap: var(--space-1); flex: none;
  padding-right: var(--space-4); border-right: 1px solid var(--line);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); white-space: nowrap;
}
.aq-section-nav__links {
  display: flex; align-items: center; gap: var(--space-1); flex: 1; min-width: 0;
  margin: 0; padding: 0 var(--space-3); list-style: none;
  overflow-x: auto; scrollbar-width: none; white-space: nowrap;
}
.aq-section-nav__links::-webkit-scrollbar { display: none; }
.aq-section-nav__links li { flex: none; }
.aq-section-nav__links a {
  display: inline-flex; align-items: baseline; gap: var(--space-2);
  padding: var(--space-1) var(--space-3); border: 1px solid transparent;
  font: 500 14px/20px var(--font-sans); color: var(--ink-muted); text-decoration: none;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-section-nav__num { font: 500 11px/12px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-subtle); font-variant-numeric: tabular-nums; }
.aq-section-nav__links a:hover { color: var(--ink); border-color: var(--line); }
.aq-section-nav__links a[aria-current="true"] { color: var(--ink); background: var(--surface-sunken); border-color: var(--flow); }
.aq-section-nav__links a[aria-current="true"] .aq-section-nav__num { color: var(--flow); }
.aq-section-nav__links a:focus-visible { outline-offset: 0; }

/* Page progress: ten segments and a percentage, updated on scroll */
.aq-section-nav__progress {
  display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: var(--space-1); flex: none;
  padding-left: var(--space-4); border-left: 1px solid var(--line);
  font: 500 11px/12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-section-nav__readout { display: flex; align-items: center; gap: var(--space-2); }
.aq-section-nav__meter { display: inline-flex; gap: calc(var(--space-1) / 2); padding: calc(var(--space-1) / 2); border: 1px solid var(--line-strong); }
.aq-section-nav__seg { display: block; width: calc(var(--space-1) + var(--space-1) / 2); height: var(--space-2); background: var(--line); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-section-nav__seg.is-on { background: var(--flow); }
.aq-section-nav__pct { min-width: 4ch; text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; }

/* Jumped-to sections clear the sticky bar (56 px desktop, 52 px phones) with room above the heading */
.aq-page:has(.aq-section-nav) section[id] { scroll-margin-top: var(--space-16); }

@media (prefers-reduced-motion: reduce) {
  .aq-section-nav__links a, .aq-section-nav__seg { transition: none; }
}

@container (max-width: 860px) {
  .aq-section-nav .aq-in { min-height: 52px; padding-inline: 0; }
  .aq-section-nav__label, .aq-section-nav__progress-label, .aq-section-nav__meter { display: none; }
  .aq-section-nav__links { padding: 0 var(--space-2); }
  /* Tap targets at least 44 px tall */
  .aq-section-nav__links a { align-items: center; min-height: 44px; padding-inline: var(--space-3); }
  .aq-section-nav__progress { padding-inline: var(--space-3) var(--space-4); }
}

/* ---------- Band ---------- */
/* Ground modifiers: change the section ground for one section. Used on their own by StandardsGrid and DocList (sunken)
   and Closing (navy), and together with .aq-band for the statement band. */
.aq-band--sunken { background: var(--surface-sunken); }
.aq-band--limestone { background: var(--limestone); color: var(--on-limestone); }
.aq-band--limestone .aq-lead, .aq-band--limestone .aq-small { color: var(--on-limestone-muted); }
.aq-band--navy { background: var(--navy); color: var(--on-navy); position: relative; overflow: hidden; }
.aq-band--navy .aq-lead, .aq-band--navy .aq-small { color: var(--on-navy-muted); }
.aq-band--navy .aq-btn--primary { background: var(--limestone); color: var(--navy); }
.aq-band--navy .aq-btn--primary:hover { background: var(--on-navy); }
.aq-band--navy .aq-arc__outer { stroke: var(--on-navy-muted); opacity: 0.5; }
.aq-band--navy .aq-arc__inner { stroke: var(--limestone); }

/* ---------- Statement band: one sentence set very large in a framed panel ---------- */
/* The frame has a plain strip along its top and bottom edge (a hairline with a short run of ruler ticks), the
   statement in Geist Light, a supporting line, and a decorative pipework drawing at the right that fades out towards
   the text. All lines are drawn in currentColor, so the same rules work on every band ground and in both themes. */
.aq-band__frame {
  position: relative; isolation: isolate;
  padding: calc(var(--space-8) + var(--space-12)) var(--space-12);
  border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  border-radius: var(--radius-0);
}
/* Frame strips: top and bottom, each a hairline space-8 in from the edge with ruler ticks at the start */
.aq-band__frame::before, .aq-band__frame::after {
  content: ""; position: absolute; left: 0; right: 0; height: var(--space-8); pointer-events: none;
  background-image: repeating-linear-gradient(90deg, color-mix(in srgb, currentColor 45%, transparent) 0 1px, transparent 1px var(--space-2));
  background-repeat: no-repeat;
  background-size: var(--space-24) var(--space-2);
}
.aq-band__frame::before {
  top: 0; border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  background-position: var(--space-4) bottom;
}
.aq-band__frame::after {
  bottom: 0; border-top: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  background-position: right var(--space-4) top;
}

.aq-band__text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-6); max-width: 75%; }
.aq-band__h {
  margin: 0; max-width: 20ch;
  font: 300 clamp(44px, 6.4cqi, 80px)/1.08 var(--font-sans); letter-spacing: -0.035em;
  color: inherit; text-wrap: balance; overflow-wrap: break-word;
}
.aq-band__lead { margin: 0; }

/* Mark: corner brackets around one word or phrase named by the content (optional `mark` field) */
.aq-band__mark {
  padding: 0 0.12em; margin: 0 -0.04em;
  -webkit-box-decoration-break: clone; box-decoration-break: clone;
  background-image:
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor),
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor),
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor),
    linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-size: 0.22em 2px, 2px 0.22em, 0.22em 2px, 2px 0.22em, 0.22em 2px, 2px 0.22em, 0.22em 2px, 2px 0.22em;
  background-position: left top, left top, right top, right top, left bottom, left bottom, right bottom, right bottom;
}

/* Pipework drawing: decoration only (aria-hidden), fades out towards the text */
.aq-band__motif {
  position: absolute; z-index: 0; right: var(--space-12);
  top: calc(var(--space-8) + 1px);
  width: 34%; height: calc(100% - 2 * var(--space-8) - 2px);
  fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke;
  opacity: 0.4; pointer-events: none;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 60%);
  mask-image: linear-gradient(90deg, transparent, black 60%);
}
.aq-band__motif * { vector-effect: non-scaling-stroke; }
.aq-band__motif path, .aq-band__motif rect { stroke: currentColor; }
.aq-band__motif-fine { opacity: 0.6; }

@container (max-width: 860px) {
  .aq-band__frame { padding: calc(var(--space-6) + var(--space-8)) var(--space-4); }
  .aq-band__frame::before, .aq-band__frame::after { height: var(--space-6); background-size: var(--space-16) var(--space-2); }
  .aq-band__frame::before { background-position: var(--space-3) bottom; }
  .aq-band__frame::after { background-position: right var(--space-3) top; }
  .aq-band__text { max-width: none; gap: var(--space-4); }
  .aq-band__h { font-size: clamp(30px, 9.5cqi, 44px); line-height: 1.1; letter-spacing: -0.025em; }
  .aq-band__lead { font-size: 16px; line-height: 24px; }
  /* The drawing drops to the lower right corner, lighter, so it never sits under the statement at full strength */
  .aq-band__motif {
    top: auto; bottom: calc(var(--space-6) + 1px); right: var(--space-3);
    width: 45%; height: 55%; opacity: 0.22;
    -webkit-mask-image: linear-gradient(180deg, transparent, black 70%);
    mask-image: linear-gradient(180deg, transparent, black 70%);
  }
}

/* ---------- CaseStudy: fact boxes beside one large measured-outcome figure ---------- */
/* One framed case per project, stacked. Desktop: Client, Problem and System delivered as boxes in the left column,
   the outcome box spanning their height on the right with the figure set large in mono. */
.aq-cases { counter-reset: aq-case; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
.aq-case {
  counter-increment: aq-case;
  display: flex; flex-direction: column; gap: var(--space-4);
  min-width: 0; padding: var(--space-6);
  border: 1px solid var(--line-strong);
  background: var(--surface);
}

/* Header: "Case 01 /" in mono, then the title, above a hairline */
.aq-case__title { margin: 0; padding-bottom: var(--space-4); border-bottom: 1px solid var(--line); text-wrap: pretty; overflow-wrap: break-word; }
.aq-case__title::before {
  content: "Case " counter(aq-case, decimal-leading-zero) " /";
  display: block; margin-bottom: var(--space-2);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--ink-muted);
}

/* The dl is the grid; each dt/dd pair sits in its own box (a div, which dl allows) */
.aq-case__facts {
  margin: 0;
  display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  grid-auto-rows: auto; gap: var(--space-3);
}
.aq-case__fact, .aq-case__outcome {
  min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  padding: var(--space-4);
  background: var(--surface-raised);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-0);
}
.aq-case__fact { grid-column: 1; }
.aq-case dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case dd { margin: 0; overflow-wrap: break-word; }
.aq-case__fact dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcome: spans the fact rows; the flow top edge is the case's one accent */
.aq-case__outcome {
  grid-column: 2; grid-row: 1 / span 3;
  padding: var(--space-6);
  border-color: var(--flow);
  box-shadow: inset 0 2px 0 var(--flow);
}
.aq-case__facts:not(:has(> .aq-case__fact)) > .aq-case__outcome { grid-column: 1 / -1; grid-row: auto; }
.aq-case__outcome dd { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-6); }
.aq-case__figure { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-2); min-width: 0; padding-top: var(--space-4); }
.aq-case__num {
  min-width: 0; overflow-wrap: anywhere;
  font: 300 clamp(72px, 11cqi, 168px)/0.9 var(--font-mono);
  letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-case__unit { font: 400 28px/32px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
/* A bracketed value inside the figure keeps the placeholder look, scaled to the slot */
.aq-case__num .aq-ph, .aq-case__unit .aq-ph { font-size: 0.4em; vertical-align: middle; }
.aq-case__result { max-width: var(--text-max); font: 400 18px/28px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* No figure supplied yet: a dashed placeholder slot the size of the figure, so the gap is obvious */
.aq-case__figure.is-empty {
  align-items: center; justify-content: center;
  min-height: clamp(96px, 11cqi, 168px);
  margin-top: var(--space-4); padding: var(--space-4);
  border: 1px dashed var(--caution);
  background: var(--caution-tint);
}
.aq-case__figure.is-empty .aq-ph { font-size: 18px; line-height: 24px; text-align: center; }
.is-clean .aq-case__figure.is-empty { border-color: var(--line-strong); background: none; color: var(--ink-subtle); }

/* Outcome spans however many fact boxes there are (three by default; Standard met makes four). Two-column widths only. */
@container (min-width: 861px) {
  .aq-case__facts:has(> .aq-case__fact:nth-child(4)) > .aq-case__outcome { grid-row: 1 / span 4; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(3))) > .aq-case__outcome { grid-row: 1 / span 2; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(2))) > .aq-case__outcome { grid-row: 1; }
}

/* How it was measured: a full-width box under the facts and outcome, quieter than the facts */
.aq-case__method {
  grid-column: 1 / -1; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  padding: var(--space-4);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-0);
}
.aq-case__method dd { font: 400 15px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Status label: says the case is a template or awaiting client approval; sits above the "Case 01 /" header */
.aq-case__status {
  align-self: flex-start;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--caution); background: var(--caution-tint);
  padding: var(--space-1) var(--space-2); border-radius: var(--radius-0);
}

/* Project profile: the KeyFacts strip of headline KPIs, set inside the case frame under the title */
.aq-case__profile { background-color: var(--surface-raised); }

@container (max-width: 860px) {
  /* Phones: one column. The facts and the method are hairline rows (label above text), not boxes; the outcome
     keeps its box as the case's one accent, after the facts, figure scaled to the screen. */
  .aq-cases { gap: var(--space-6); }
  .aq-case { padding: var(--space-4); }
  .aq-case__facts { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .aq-case__fact, .aq-case__outcome { grid-column: 1; grid-row: auto; padding: var(--space-4); }
  .aq-case__fact, .aq-case__method { gap: var(--space-1); padding: var(--space-3) 0; background: none; border: 0; border-top: 1px solid var(--line); }
  .aq-case__fact:first-child { border-top: 0; padding-top: 0; }
  .aq-case__outcome { margin-block: var(--space-3) var(--space-1); }
  .aq-case__method { grid-column: 1; }
  .aq-case__fact dd { font-size: 15px; line-height: 24px; }
  .aq-case__outcome dd { gap: var(--space-4); }
  .aq-case__figure { padding-top: var(--space-2); }
  .aq-case__num { font-size: clamp(56px, 20cqi, 96px); }
  .aq-case__unit { font-size: 20px; line-height: 24px; }
  .aq-case__result { font-size: 16px; line-height: 26px; }
  .aq-case__figure.is-empty { min-height: var(--space-24); margin-top: var(--space-2); }
  .aq-case__figure.is-empty .aq-ph { font-size: 15px; }
}

/* ---------- Project record (.aq-case--record): the case told as an engineering record ----------
   Facts as hairline rows beside the system's equipment drawing with what changed pinned on it, then the measured
   outcomes as large figures with the method beneath, then the order-to-release milestones. Same frame as a case. */
.aq-case__label { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case__brief { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); align-items: start; }
.aq-case__brief.is-bare { grid-template-columns: minmax(0, 1fr); }
.aq-case__entries { margin: 0; display: flex; flex-direction: column; }
.aq-case__entry { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
.aq-case__entry:first-child { border-top: 0; padding-top: 0; }
.aq-case__entry dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }
.aq-case--record .aq-case__method { padding: var(--space-4); }

/* Drawing: the page's equipment mask on a quiet raised panel; numbered flow marks pin what changed */
.aq-case__drawing { margin: 0; display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
.aq-case__art { padding: var(--space-4); background: var(--surface-raised); border: 1px solid var(--line); }
/* The plate is the drawing's own square, so pin positions (% of the drawing) land on the equipment at any width */
.aq-case__plate { position: relative; width: min(100%, 26rem); margin-inline: auto; }
.aq-case__art .aq-illustration { max-width: none; }
.aq-case__mark { flex: none; display: inline-grid; place-items: center; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-pill); background: var(--flow); color: var(--surface); font: 500 12px/1 var(--font-mono); }
.aq-case__pin { position: absolute; transform: translate(-50%, -50%); display: flex; border-radius: var(--radius-pill); box-shadow: 0 0 0 var(--space-1) var(--surface-raised), 0 0 0 calc(var(--space-1) + 1px) var(--flow); }
.aq-case__changes { display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__changes ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__changes li { display: flex; align-items: flex-start; gap: var(--space-3); font: 400 15px/24px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcomes: 3-4 large figures in a row, each with its unit, what it is, and the method beneath */
.aq-case__outcomes { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--line-strong); }
.aq-case__outcomes > .aq-case__result { margin: 0; font-size: 16px; line-height: 26px; }
.aq-case__figures { margin: 0; display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: var(--space-6); }
.aq-case__fig { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding-top: var(--space-4); box-shadow: inset 0 2px 0 var(--flow); }
.aq-case__fig dt { order: 2; }
.aq-case__fig dd { display: contents; }
.aq-case__val { order: 1; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-2); row-gap: var(--space-1); min-width: 0; }
.aq-case__fig .aq-case__num { font: 300 clamp(40px, 4.4cqi, 64px)/1 var(--font-mono); letter-spacing: -0.03em; overflow-wrap: anywhere; }
.aq-case__fig .aq-case__num .aq-ph { font-size: 0.5em; vertical-align: middle; }
.aq-case__fig .aq-case__unit { font: 400 18px/24px var(--font-sans); letter-spacing: 0; color: var(--ink); }
.aq-case__how { order: 3; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; overflow-wrap: break-word; }

/* Timeline: order to release, milestones as stops on one line */
.aq-case__timeline { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--line-strong); }
.aq-case__timeline ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); }
.aq-case__timeline li { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding-top: var(--space-6); text-align: center; min-width: 0; }
.aq-case__timeline li::before { content: ""; position: absolute; top: calc(var(--space-2) - 0.5px); left: 0; right: 0; border-top: 1px solid var(--line-strong); }
.aq-case__timeline li:first-child::before { left: 50%; }
.aq-case__timeline li:last-child::before { right: 50%; }
.aq-case__stop { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: var(--space-4); height: var(--space-4); border-radius: var(--radius-pill); background: var(--surface); border: 2px solid var(--flow); }
.aq-case__timeline li:last-child .aq-case__stop { background: var(--flow); }
.aq-case__mt { font: 500 14px/20px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-case__when { font: 400 13px/20px var(--font-mono); color: var(--ink-muted); font-variant-numeric: tabular-nums; }

@container (max-width: 860px) {
  /* Phones: drawing first, then the facts, outcomes 2 x 2, then a vertical timeline */
  .aq-case__brief { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-case__drawing { order: -1; }
  .aq-case__art { padding: var(--space-2); }
  .aq-case__plate { width: min(100%, 17.5rem); }
  .aq-case__entry { padding: var(--space-3) 0; }
  .aq-case__entry dd { font-size: 15px; line-height: 24px; }
  .aq-case__changes li { font-size: 14px; line-height: 22px; }
  .aq-case__outcomes, .aq-case__timeline { padding-top: var(--space-4); }
  .aq-case__figures { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .aq-case__fig .aq-case__num { font-size: clamp(32px, 11cqi, 44px); }
  .aq-case__fig .aq-case__unit { font-size: 15px; line-height: 20px; }
  .aq-case__how { font-size: 13px; line-height: 20px; }
  .aq-case__timeline ol { grid-template-columns: minmax(0, 1fr); }
  .aq-case__timeline li { flex-direction: row; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: var(--space-3); padding: 0 0 var(--space-2) var(--space-8); text-align: left; }
  .aq-case__timeline li::before { top: var(--space-2); bottom: 0; left: calc(var(--space-2) - 0.5px); right: auto; border-top: 0; border-left: 1px solid var(--line-strong); }
  .aq-case__timeline li:first-child::before { left: calc(var(--space-2) - 0.5px); }
  .aq-case__timeline li:last-child::before { display: none; }
  .aq-case__timeline li:last-child { padding-bottom: 0; }
  .aq-case__stop { top: var(--space-1); left: 0; transform: none; }
}

/* ---------- Closing: the call to action at the end of every page, on the navy band ---------- */
/* A framed panel with corner registration marks: a very large headline, then the lead sentence and one proof readout
   on the left and the primary button bottom right. Sits on .aq-band--navy, which sets the ground, text colours and the
   Limestone primary button; this file only lays it out. Frame lines are on-navy-muted at reduced strength. */
.aq-closing { text-align: start; border-bottom: 1px solid var(--line-strong); }
.aq-closing__frame {
  position: relative;
  display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  column-gap: var(--space-12); row-gap: var(--space-8);
  padding: var(--space-12);
  border: 1px solid color-mix(in srgb, var(--on-navy-muted) 35%, transparent);
}
/* Registration marks at the top-left and bottom-right corners */
.aq-closing__frame::before, .aq-closing__frame::after {
  content: ""; position: absolute; width: var(--space-4); height: var(--space-4); pointer-events: none;
  border: 0 solid var(--on-navy-muted);
}
.aq-closing__frame::before { top: calc(-1 * var(--space-2)); left: calc(-1 * var(--space-2)); border-top-width: 1px; border-left-width: 1px; }
.aq-closing__frame::after { bottom: calc(-1 * var(--space-2)); right: calc(-1 * var(--space-2)); border-bottom-width: 1px; border-right-width: 1px; }

.aq-closing__h {
  grid-column: 1 / -1; max-width: 18ch;
  font: 300 88px/92px var(--font-sans); letter-spacing: -0.035em; color: var(--on-navy);
  overflow-wrap: break-word;
}
.aq-closing__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); min-width: 0; }
.aq-closing .aq-closing__body .aq-lead { color: var(--on-navy-muted); }
.aq-closing__action { display: flex; align-items: flex-end; justify-content: flex-end; min-width: 0; }

/* Proof readout: one confirmed figure from the page, in mono */
.aq-closing__proof {
  display: flex; flex-direction: column; gap: var(--space-1);
  min-width: 0; max-width: 100%;
  padding: var(--space-3) var(--space-4) var(--space-4);
  border: 1px solid color-mix(in srgb, var(--on-navy-muted) 60%, transparent);
  border-radius: var(--radius-0);
}
.aq-closing__tag { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-closing__value {
  font: 300 48px/52px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  color: var(--limestone); overflow-wrap: anywhere;
}
.aq-closing__label { font: 400 14px/22px var(--font-mono); color: var(--on-navy-muted); }

/* Checklist (cta.include): what to send us, as compact numbered rows on faint hairlines */
.aq-closing__include { display: flex; flex-direction: column; gap: var(--space-2); width: 100%; max-width: var(--text-max); }
.aq-closing__include ol { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: var(--space-8); }
.aq-closing__include li {
  break-inside: avoid; display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); align-items: baseline;
  padding-block: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent);
  font: 400 15px/22px var(--font-sans); color: var(--on-navy);
}
.aq-closing__include .aq-index { color: var(--on-navy-muted); line-height: 22px; }

/* Exchange (cta.include + cta.returns): what you send | turnaround arrow | what comes back, each return with a document mark */
.aq-closing__body:has(.aq-closing__swap) { grid-column: 1 / -1; }
.aq-closing__body:has(.aq-closing__swap) + .aq-closing__action { grid-column: 1 / -1; }
.aq-closing__swap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(var(--space-24), auto) minmax(0, 1fr); column-gap: var(--space-8); align-items: start; width: 100%; }
.aq-closing__swap .aq-closing__include { max-width: none; }
.aq-closing__swap .aq-closing__include ol { columns: 1; }
.aq-closing__turn { position: relative; align-self: start; margin-top: var(--space-8); display: flex; flex-direction: column; align-items: center; gap: var(--space-2); margin: 0; min-width: var(--space-16); }
.aq-closing__turn::after { content: ""; width: 100%; border-top: 1px solid var(--limestone); }
.aq-closing__turn span { font: 500 12px/16px var(--font-mono); color: var(--limestone); text-align: center; max-width: 160px; }
.aq-closing__turn::before { content: "\2192"; order: 2; margin-top: -21px; align-self: flex-end; font: 400 18px/18px var(--font-mono); color: var(--limestone); }
.aq-closing__returns li { grid-template-columns: var(--space-8) minmax(0, 1fr); }
.aq-closing__doc { position: relative; width: 14px; height: 18px; border: 1px solid var(--on-navy-muted); border-radius: 1px; align-self: center;
  background: linear-gradient(var(--on-navy-muted), var(--on-navy-muted)) 3px 5px / 7px 1px no-repeat, linear-gradient(var(--on-navy-muted), var(--on-navy-muted)) 3px 9px / 7px 1px no-repeat, linear-gradient(var(--on-navy-muted), var(--on-navy-muted)) 3px 13px / 5px 1px no-repeat; }

@container (max-width: 860px) {
  .aq-closing__swap { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
  .aq-closing__turn { flex-direction: row; justify-content: flex-start; min-width: 0; }
  .aq-closing__turn::after { display: none; }
  .aq-closing__turn::before { content: "\2193"; order: 0; margin: 0; align-self: auto; }
  .aq-closing__turn span { text-align: left; max-width: none; }
  .aq-closing__frame { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); padding: var(--space-6) var(--space-4); }
  .aq-closing__frame::before { top: calc(-1 * var(--space-1)); left: calc(-1 * var(--space-1)); }
  .aq-closing__frame::after { bottom: calc(-1 * var(--space-1)); right: calc(-1 * var(--space-1)); }
  .aq-closing__h { font-size: 40px; line-height: 44px; letter-spacing: -0.025em; }
  .aq-closing__value { font-size: 36px; line-height: 40px; }
  .aq-closing__action { justify-content: flex-start; }
  .aq-closing__include ol { columns: 1; }
  .aq-closing__include li { font-size: 14px; line-height: 20px; }
  .aq-closing__action .aq-btn { max-width: 100%; white-space: normal; height: auto; min-height: 44px; }
}

/* ---------- ContactRoutes: the ways in, each with its next steps and response clock (block contact-routes) ----------
   Desktop: one card per route in equal columns on the navy, in data order (--o). Each card: marker, title, one line,
   numbered steps on a riser, the response clock, then one action at the foot. The route for this page (is-current)
   is framed in flow with a "This page" marker on its top edge. The urgent route (is-urgent, data-theme="light") sits
   on limestone with its phone number set large. Phones: cards stack, urgent first (markup order). */
.aq-contact-routes {
  list-style: none; margin: 0; padding: var(--space-4) 0 0;
  display: grid; grid-template-columns: repeat(var(--routes, 3), minmax(0, 1fr)); gap: var(--space-4); align-items: stretch;
}
.aq-contact-routes__route {
  order: var(--o, 0); position: relative; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-4);
  padding: var(--space-8) var(--space-6) var(--space-6);
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--ink);
}
.aq-contact-routes__route.is-current { background: var(--flow-tint); border-color: var(--flow); box-shadow: inset 0 0 0 1px var(--flow); }
.aq-contact-routes__route.is-urgent { background: var(--limestone); color: var(--on-limestone); border-color: var(--line-strong); }

/* Marker on the card's top edge: "This page", "Urgent" */
.aq-contact-routes__mark {
  position: absolute; top: 0; left: var(--space-6); transform: translateY(-50%); margin: 0;
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: 2px var(--space-2); background: var(--surface); border: 1px solid var(--flow); border-radius: var(--radius-sm);
  font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--flow);
}
.aq-contact-routes__route.is-urgent .aq-contact-routes__mark { background: var(--limestone); border-color: var(--on-limestone); color: var(--on-limestone); }
.aq-contact-routes__dot { width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--fail); }

.aq-contact-routes__t { margin: 0; font: 400 22px/28px var(--font-sans); letter-spacing: -0.01em; color: inherit; overflow-wrap: break-word; text-wrap: balance; }
.aq-contact-routes__d { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-contact-routes__route.is-urgent .aq-contact-routes__d { color: var(--on-limestone-muted); }

/* Phone: the urgent route's number, set large */
.aq-contact-routes__phone {
  margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: var(--space-2); row-gap: var(--space-1);
  padding: var(--space-4) 0; border-block: 1px solid color-mix(in srgb, currentColor 35%, transparent);
}
.aq-contact-routes__phone .aq-contact-routes__icon { width: 16px; height: 16px; }
.aq-contact-routes__num {
  grid-column: 1 / -1; font: 500 28px/34px var(--font-sans); letter-spacing: -0.01em; color: inherit; text-decoration: none; overflow-wrap: anywhere;
}
a.aq-contact-routes__num:hover { text-decoration: underline; }

/* Steps: numbered rings on a riser */
.aq-contact-routes__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-contact-routes__steps > li { position: relative; display: grid; grid-template-columns: var(--space-6) minmax(0, 1fr); column-gap: var(--space-3); align-items: start; }
.aq-contact-routes__steps > li:not(:last-child)::after {
  content: ""; position: absolute; left: calc(var(--space-6) / 2); top: var(--space-6); bottom: calc(-1 * var(--space-3));
  border-left: 1px solid var(--flow);
}
.aq-contact-routes__route.is-urgent .aq-contact-routes__steps > li:not(:last-child)::after { border-left-color: var(--line-strong); }
.aq-contact-routes__n {
  display: grid; place-items: center; width: var(--space-6); height: var(--space-6); box-sizing: border-box;
  border: 1px solid var(--flow); border-radius: var(--radius-pill);
  font: 500 11px/1 var(--font-mono); color: var(--flow);
}
.aq-contact-routes__route.is-urgent .aq-contact-routes__n { border-color: var(--on-limestone); color: var(--on-limestone); }
.aq-contact-routes__s { padding-top: 1px; font: 400 15px/22px var(--font-sans); color: inherit; overflow-wrap: break-word; text-wrap: pretty; }

/* Response clock */
.aq-contact-routes__clock {
  margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: var(--space-2); row-gap: var(--space-1);
  padding-top: var(--space-4); border-top: 1px solid var(--line);
}
.aq-contact-routes__icon { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; color: var(--ink-muted); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__icon { color: var(--on-limestone-muted); }
.aq-contact-routes__k { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__k { color: var(--on-limestone-muted); }
.aq-contact-routes__route.is-urgent .aq-contact-routes__clock { border-top-color: color-mix(in srgb, currentColor 35%, transparent); }
.aq-contact-routes__v { grid-column: 1 / -1; font: 500 15px/22px var(--font-sans); color: inherit; overflow-wrap: break-word; }

/* Action at the foot of every card */
.aq-contact-routes__action { margin-top: auto; padding-top: var(--space-2); }
.aq-contact-routes__action .aq-btn { width: 100%; height: auto; min-height: 44px; padding-block: var(--space-2); justify-content: center; text-align: center; white-space: normal; }
.aq-contact-routes__route.is-urgent .aq-btn--secondary { color: var(--on-limestone); border-color: var(--on-limestone); }

@container (max-width: 860px) {
  .aq-contact-routes { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); padding-top: var(--space-2); }
  .aq-contact-routes__route { order: 0; gap: var(--space-3); padding: var(--space-6) var(--space-4) var(--space-4); }
  /* the mono labels ("Call", "Response") stay for screen readers; the icon carries them on a phone */
  .aq-contact-routes__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-contact-routes__phone, .aq-contact-routes__clock { align-items: start; }
  .aq-contact-routes__phone .aq-contact-routes__num, .aq-contact-routes__v { grid-column: 2; }
  .aq-contact-routes__phone .aq-contact-routes__icon { margin-top: 7px; }
  .aq-contact-routes__clock .aq-contact-routes__icon { margin-top: 3px; }
  .aq-contact-routes__mark { left: var(--space-4); }
  .aq-contact-routes__t { font-size: 20px; line-height: 26px; }
  .aq-contact-routes__d { font-size: 14px; line-height: 20px; }
  .aq-contact-routes__num { font-size: 24px; line-height: 30px; }
  .aq-contact-routes__phone { padding-block: var(--space-3); }
  .aq-contact-routes__steps { gap: var(--space-2); }
  .aq-contact-routes__steps > li:not(:last-child)::after { bottom: calc(-1 * var(--space-2)); }
  .aq-contact-routes__s { font-size: 14px; line-height: 20px; }
  .aq-contact-routes__clock { padding-top: var(--space-3); }
  .aq-contact-routes__v { font-size: 14px; line-height: 20px; }
}

/* ---------- DocList: the turnover binder ---------- */
/* Desktop: a binder frame (surface-sunken, line-strong edge, a second sheet drawn offset behind it) holding folder cards
   on a 6-column grid, three to a row. Each card is a folder: a tab on its top edge (index and document code) and the
   name below. Key documents (.is-key) fill their tab with flow on a flow-tint card. Wide cards (span 3) are chosen by
   the renderer: .aq-docs__w when the list is open, .aq-docs__wf while it is folded, so no row ends short. */
.aq-docs {
  display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: var(--space-4); row-gap: var(--space-6);
  margin: 0 var(--space-2) 0 0; padding: var(--space-8) var(--space-6) var(--space-6); list-style: none;
  background: var(--surface-sunken); border: 1px solid var(--line-strong);
  box-shadow: var(--space-2) calc(-1 * var(--space-2)) 0 -1px var(--surface), var(--space-2) calc(-1 * var(--space-2)) 0 0 var(--line-strong);
}
.aq-docs > li { grid-column: span 2; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
.aq-docs > li.aq-docs__w { grid-column: span 3; }
.aq-fold:not(.is-open) .aq-docs > li { grid-column: span 2; }
.aq-fold:not(.is-open) .aq-docs > li.aq-docs__wf { grid-column: span 3; }

/* Folder tab: index and code, sitting on the card's top edge (overlaps its border by 1px) */
.aq-docs__tab {
  position: relative; z-index: 1; display: inline-flex; align-items: baseline; gap: var(--space-3); margin-bottom: -1px; max-width: 100%;
  padding: var(--space-1) var(--space-4) var(--space-1) var(--space-3);
  background: var(--surface-raised); border: 1px solid var(--line-strong); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}
.aq-docs__tab .aq-index { line-height: 20px; }
.aq-docs__code { font: 500 14px/20px var(--font-mono); letter-spacing: 0.02em; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* Card: the folder body, with one sheet showing behind it */
.aq-docs__card {
  flex: 1; align-self: stretch; display: block; min-width: 0; padding: var(--space-4) var(--space-4) var(--space-6);
  background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: 0 var(--radius-sm) var(--radius-sm) var(--radius-sm);
  box-shadow: var(--space-1) var(--space-1) 0 -1px var(--surface-sunken), var(--space-1) var(--space-1) 0 0 var(--line);
}
.aq-docs__name { display: block; min-width: 0; font: 400 15px/22px var(--font-sans); color: var(--ink); text-wrap: pretty; }
.aq-docs__d { display: block; margin-top: var(--space-1); font-size: 14px; color: var(--ink-muted); }
/* Key documents: the ones that decide the review */
.aq-docs > li.is-key .aq-docs__tab { background: var(--flow); border-color: var(--flow); }
.aq-docs > li.is-key .aq-docs__tab .aq-index, .aq-docs > li.is-key .aq-docs__code { color: var(--surface); }
.aq-docs > li.is-key .aq-docs__card { background: var(--flow-tint); border-color: var(--flow); }
.aq-docs > li.is-key .aq-docs__name { font-weight: 500; }

/* Phone: no frame, a compact numbered list, "01  FS  Functional specification", index and codes in aligned columns.
   Key documents keep their code in flow and the name in medium weight. */
@container (max-width: 860px) {
  .aq-docs { grid-template-columns: var(--space-8) auto minmax(0, 1fr); gap: 0; margin: 0; padding: 0; background: none; border: 0; border-bottom: 1px solid var(--line); box-shadow: none; }
  .aq-docs > li, .aq-docs > li.aq-docs__w, .aq-fold:not(.is-open) .aq-docs > li, .aq-fold:not(.is-open) .aq-docs > li.aq-docs__wf { grid-column: 1 / -1; }
  .aq-docs > li { display: grid; grid-template-columns: subgrid; column-gap: var(--space-3); align-items: baseline; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .aq-docs__tab, .aq-docs__card { display: contents; }
  .aq-docs__tab .aq-index { line-height: 24px; }
  .aq-docs__code { font: 400 14px/22px var(--font-mono); letter-spacing: 0; }
  .aq-docs--plain .aq-docs__name { grid-column: 2 / -1; }
  .aq-docs > li.is-key .aq-docs__tab .aq-index { color: var(--ink-subtle); }
  .aq-docs > li.is-key .aq-docs__code { color: var(--flow); }
}

/* ---------- EvidenceMap: requirement -> how we meet it -> the document that proves it (table block as "evidence") ----------
   Desktop: three columns per row; the proof column opens with a short leader line from the text, then document tags
   (mono, 1px frame) and a quiet page link. Phones: requirement, how, then tags and link. */
.aq-evidence { min-width: 0; }
.aq-evidence__head, .aq-evidence__row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr); column-gap: var(--space-8); }
.aq-evidence__head { padding-bottom: var(--space-2); border-bottom: 1px solid var(--line-strong); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-evidence__rows { list-style: none; margin: 0; padding: 0; }
.aq-evidence__row { align-items: start; padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
.aq-evidence__t { margin: 0; font: 500 16px/24px var(--font-sans); color: var(--ink); overflow-wrap: break-word; text-wrap: pretty; }
.aq-evidence__how { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
.aq-evidence__proof { position: relative; margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); padding-left: var(--space-6); }
.aq-evidence__proof::before { content: ""; position: absolute; left: 0; top: 12px; width: var(--space-4); border-top: 1px solid var(--flow); }
.aq-evidence__proof::after { content: ""; position: absolute; left: calc(var(--space-4) - 2px); top: 10px; width: 5px; height: 5px; border-radius: var(--radius-pill); background: var(--flow); }
.aq-evidence__doc {
  position: relative; display: inline-block; padding: 1px var(--space-3) 1px var(--space-2);
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  font: 400 12px/20px var(--font-mono); color: var(--ink); overflow-wrap: anywhere;
}
.aq-evidence__k { flex-basis: 100%; font: 500 11px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-evidence__k ~ .aq-evidence__k { margin-top: var(--space-1); }
.aq-evidence__go { flex-basis: 100%; font: 500 14px/22px var(--font-sans); }
.aq-evidence__go a { text-decoration: none; }
.aq-evidence__go a::after { content: "\a0\2192"; }
.aq-evidence__go a:hover { text-decoration: underline; }

@container (max-width: 860px) {
  .aq-evidence__head { display: none; }
  .aq-evidence__row { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
  .aq-evidence__row:first-child { border-top: 1px solid var(--line); }
}

/* ---------- Explainer: one idea as a figure plus 3-4 numbered callouts (prose block as "explainer") ----------
   Desktop: the figure in a line-strong frame on the left, the numbered callouts on the right. Phones: figure first,
   callouts under it. Figures: "levels" (bars against a dashed limit, drawn from tokens) or "art" (the page's equipment
   drawing with the callouts' numbers pinned on it). Numbers on a figure are aria-hidden; the text says it all. */
.aq-explainer { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-12); align-items: start; }
.aq-explainer__fig { position: relative; margin: 0; padding: var(--space-6); border: 1px solid var(--line-strong); }
.aq-explainer__points { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
.aq-explainer__points > li { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-1); padding-block: var(--space-4); border-top: 1px solid var(--line); }
.aq-explainer__n { grid-row: 1 / span 2; font: 400 28px/32px var(--font-mono); letter-spacing: -0.01em; color: var(--flow); }
.aq-explainer__t { margin: 0; font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); text-wrap: pretty; }
.aq-explainer__d { grid-column: 2; margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
.aq-explainer:has(.aq-explainer__fig--art) { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
.aq-explainer--bare { grid-template-columns: minmax(0, 1fr); }
.aq-explainer--bare .aq-explainer__points { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); }

/* Number marker, on a bar or pinned on a drawing */
.aq-explainer__mark { display: inline-grid; place-items: center; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-pill); background: var(--flow); color: var(--surface); font: 500 12px/1 var(--font-mono); }
.aq-explainer__fig--art { padding: 0; }
.aq-explainer__pin { position: absolute; transform: translate(-50%, -50%); display: flex; box-shadow: 0 0 0 var(--space-1) var(--surface); border-radius: var(--radius-pill); }

/* Levels: tubes filled to a value, the limit a dashed fail-coloured rule across them */
.aq-levels { display: flex; flex-direction: column; gap: var(--space-6); }
.aq-levels__plot { position: relative; display: grid; grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr)); column-gap: var(--space-6); height: calc(var(--space-32) * 2); border-bottom: 1px solid var(--line-strong); }
.aq-levels__col { display: flex; justify-content: center; height: 100%; }
.aq-levels__tube { position: relative; width: var(--space-16); height: 100%; border: 1px solid var(--line-strong); border-top: 0; border-bottom: 0; }
.aq-levels__fill { position: absolute; left: 0; right: 0; bottom: 0; height: var(--h, 0%); background: var(--flow-tint); border-top: 2px solid var(--flow); }
.aq-levels__fill.is-at, .aq-levels__fill.is-above { border-top-color: var(--fail); }
.aq-levels__fill > .aq-explainer__mark { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); }
.aq-levels__v { position: absolute; left: 100%; top: 0; padding: var(--space-1) 0 0 var(--space-2); white-space: nowrap; font: 500 12px/16px var(--font-mono); color: var(--ink); }
.aq-levels__limit { position: absolute; left: 0; right: 0; bottom: var(--at, 70%); border-top: 1px dashed var(--fail); }
.aq-levels__limit > span { position: absolute; right: 0; bottom: var(--space-1); padding-inline: var(--space-2); background: var(--surface); font: 500 12px/16px var(--font-mono); color: var(--ink-muted); }
.aq-levels__keys { display: grid; grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr)); column-gap: var(--space-6); }
.aq-levels__key { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; text-align: center; }
.aq-levels__label { font: 500 15px/22px var(--font-sans); color: var(--ink); }
.aq-levels__note { font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }

@container (max-width: 860px) {
  .aq-explainer, .aq-explainer:has(.aq-explainer__fig--art), .aq-explainer--bare .aq-explainer__points { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .aq-explainer__fig { padding: var(--space-4); }
  .aq-explainer__fig--art { padding: 0; }
  .aq-explainer__points > li { grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-3); }
  .aq-explainer__n { font-size: 20px; line-height: 24px; }
  .aq-explainer__t { font-size: 16px; line-height: 24px; }
  .aq-explainer__d { font-size: 14px; line-height: 22px; }
  .aq-levels { gap: var(--space-4); }
  .aq-levels__plot { height: calc(var(--space-32) * 1.5); column-gap: var(--space-4); }
  .aq-levels__tube { width: var(--space-12); }
  .aq-levels__keys { column-gap: var(--space-4); }
  .aq-levels__label { font-size: 14px; line-height: 20px; }
  .aq-levels__note { font-size: 13px; line-height: 20px; }
}

/* ---------- FAQ: hairline accordion rows ---------- */
/* One row per question: the shared index (.aq-index), the question, and a +/− sign at the right. The answer opens under
   the question column. No cards, no grid paper. Native <details>, so it works without JavaScript; a shared name keeps
   one answer open. Collapsed rows are about 56 px on phones. */
.aq-faq { border-bottom: 1px solid var(--line); }
.aq-faq > details { border-top: 1px solid var(--line); }
.aq-faq summary {
  display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) var(--space-6);
  column-gap: var(--space-4); align-items: baseline;
  padding-block: var(--space-4);
  cursor: pointer; list-style: none;
  font: 500 17px/24px var(--font-sans); color: var(--ink);
}
.aq-faq summary::-webkit-details-marker { display: none; }
.aq-faq summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-faq__q { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-faq summary:hover .aq-faq__q { color: var(--flow); }
.aq-faq__sign { justify-self: end; font: 400 18px/24px var(--font-mono); color: var(--ink-subtle); }
.aq-faq__sign::before { content: "+"; }
.aq-faq details[open] .aq-faq__sign::before { content: "\2212"; }
.aq-faq details[open] .aq-faq__sign { color: var(--flow); }

/* Answer: under the question column */
.aq-faq__a {
  padding: 0 calc(var(--space-6) + var(--space-4)) var(--space-6) calc(var(--space-12) + var(--space-4));
  animation: aq-faq-in 400ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-faq__a p { margin: 0; max-width: var(--text-max); font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }
.aq-faq__a p + p { margin-top: var(--space-2); }
@keyframes aq-faq-in { from { opacity: 0; transform: translateY(var(--space-2)); } to { opacity: 1; transform: none; } }
@keyframes aq-faq-fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .aq-faq__a { animation-name: aq-faq-fade; } }

@container (max-width: 860px) {
  .aq-faq summary { grid-template-columns: var(--space-8) minmax(0, 1fr) var(--space-4); column-gap: var(--space-3); font-size: 16px; line-height: 24px; }
  .aq-faq__a { padding: 0 0 var(--space-4) calc(var(--space-8) + var(--space-3)); }
}

/* ---------- FaultList: failure modes that open to cause and design control (table block as "failures") ----------
   Hairline accordion rows like FAQ: index | failure | +/−. Open, the remaining columns sit side by side under the
   failure column, each with its column name as a mono label; the last column (what we design in) carries a flow rule.
   A small fail-coloured tick marks each failure index. Phones: the open columns stack. */
.aq-faults { border-bottom: 1px solid var(--line); }
.aq-faults > details { border-top: 1px solid var(--line); }
.aq-faults summary {
  display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) var(--space-6); column-gap: var(--space-4); align-items: baseline;
  padding-block: var(--space-4); cursor: pointer; list-style: none;
  font: 500 17px/24px var(--font-sans); color: var(--ink);
}
.aq-faults summary::-webkit-details-marker { display: none; }
.aq-faults summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-faults summary .aq-index { position: relative; padding-left: var(--space-3); }
.aq-faults summary .aq-index::before { content: ""; position: absolute; left: 0; top: 50%; width: 5px; height: 5px; margin-top: -3px; background: var(--fail); border-radius: var(--radius-pill); }
.aq-faults__t { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-faults summary:hover .aq-faults__t { color: var(--flow); }
.aq-faults__sign { justify-self: end; font: 400 18px/24px var(--font-mono); color: var(--ink-subtle); }
.aq-faults__sign::before { content: "+"; }
.aq-faults details[open] .aq-faults__sign::before { content: "\2212"; }
.aq-faults details[open] .aq-faults__sign { color: var(--flow); }
.aq-faults__body {
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--space-8);
  padding: 0 calc(var(--space-6) + var(--space-4)) var(--space-6) calc(var(--space-12) + var(--space-4));
}
.aq-faults__body > div { min-width: 0; padding-top: var(--space-3); border-top: 1px solid var(--line); }
.aq-faults__body > div:last-child { border-top-color: var(--flow); }
.aq-faults__k { margin: 0 0 var(--space-1); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-faults__body > div:last-child .aq-faults__k { color: var(--flow); }
.aq-faults__v { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink); text-wrap: pretty; overflow-wrap: break-word; }

@container (max-width: 860px) {
  .aq-faults summary { grid-template-columns: var(--space-8) minmax(0, 1fr) var(--space-6); column-gap: var(--space-3); }
  .aq-faults__body { grid-auto-flow: row; row-gap: var(--space-4); padding: 0 0 var(--space-6) calc(var(--space-8) + var(--space-3)); }
}

/* ---------- GradeLanes: minimum water grade by process step (table block as "grades") ----------
   Rows of the shared list grammar (index | step) with three lanes at the right, Potable, PW and WFI, drawn as vertical
   pipes the full height of the list. A filled flow tap marks the minimum grade, an open tap an alternative. */
.aq-grades { min-width: 0; }
.aq-grades__head, .aq-grades__row { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) calc(var(--space-16) * 3); column-gap: var(--space-6); }
.aq-grades__head { padding-bottom: var(--space-2); border-bottom: 1px solid var(--line-strong); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-grades__head > span:first-child { grid-column: 2; }
.aq-grades__lanes { grid-column: 3; display: grid; grid-template-columns: repeat(3, var(--space-16)); }
.aq-grades__head .aq-grades__lanes > span { text-align: center; color: var(--flow); }
.aq-grades__rows { list-style: none; margin: 0; padding: 0; }
.aq-grades__row { align-items: stretch; border-bottom: 1px solid var(--line); }
.aq-grades__row > .aq-index { padding-block: var(--space-4); }
.aq-grades__step { min-width: 0; padding-block: var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); }
.aq-grades__t { margin: 0; font: 500 16px/24px var(--font-sans); color: var(--ink); overflow-wrap: break-word; text-wrap: pretty; }
.aq-grades__d { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-grades__g { margin: 0; font: 400 13px/20px var(--font-mono); color: var(--flow); }
.aq-grades__lane { position: relative; display: grid; place-items: center; }
.aq-grades__lane::before { content: ""; position: absolute; top: -1px; bottom: -1px; left: 50%; border-left: 1px solid var(--line-strong); }
.aq-grades__tap { position: relative; width: 13px; height: 13px; border-radius: var(--radius-pill); }
.aq-grades__tap.is-min { background: var(--flow); box-shadow: 0 0 0 3px var(--surface); }
.aq-grades__tap.is-alt { background: var(--surface); border: 1px solid var(--flow); box-shadow: 0 0 0 3px var(--surface); }

@container (max-width: 860px) {
  .aq-grades__lanes { grid-template-columns: repeat(3, var(--space-8)); }
  .aq-grades__head, .aq-grades__row { grid-template-columns: var(--space-8) minmax(0, 1fr) calc(var(--space-8) * 3); column-gap: var(--space-3); }
  .aq-grades__head .aq-grades__lanes > span { font-size: 9px; letter-spacing: 0; }
  .aq-grades__head > span:first-child { visibility: hidden; }
}

/* ---------- Hero ---------- */
.aq-hero { position: relative; overflow: hidden; padding-block: var(--space-24) var(--space-16); }
.aq-hero--home { padding-block: var(--space-32) var(--space-24); }
.aq-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-12); align-items: stretch; }
.aq-hero__grid--figure { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; }
.aq-hero__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: center; margin-top: var(--space-2); }
.aq-hero .aq-tags { margin-top: var(--space-2); }
.aq-photo { position: relative; z-index: 1; aspect-ratio: 4 / 3; min-height: 100%; max-width: 100%; background-color: var(--surface-sunken); background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: var(--space-8) var(--space-8); background-position: -1px -1px; border: 1px solid var(--line); display: flex; align-items: flex-end; padding: var(--space-4); font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
.aq-arc { position: absolute; right: -1px; bottom: -1px; width: min(38%, 420px); height: auto; pointer-events: none; }
.aq-arc__outer { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
.aq-arc__inner { fill: none; stroke: var(--flow); stroke-width: 1.5; }

/* Figure: equipment drawing on a fading blueprint grid, with callouts carrying the page's key facts.
   The box is 5:4 (viewBox 125 x 100 for the leaders); the drawing is a centred square 84 % of its height. */
.aq-hero__figure { position: relative; z-index: 1; margin: 0; aspect-ratio: 5 / 4; }
.aq-hero__figure::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: var(--space-8) var(--space-8); background-position: center; -webkit-mask: radial-gradient(closest-side, var(--ink) 55%, transparent); mask: radial-gradient(closest-side, var(--ink) 55%, transparent); pointer-events: none; }
.aq-hero__figure .aq-illustration { position: absolute; inset: 8% 16.4%; width: auto; max-width: none; aspect-ratio: auto; margin: 0; }
.aq-hero__leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.aq-hero__leaders line { stroke: var(--flow); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-hero__leaders circle { fill: var(--flow); }
.aq-hero__callouts { position: absolute; inset: 0; margin: 0; pointer-events: none; }
.aq-hero__callout { position: absolute; width: 30%; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-1); padding-block: var(--space-2); background: var(--surface); border-top: 1px solid var(--flow); pointer-events: auto; }
.aq-hero__callout:nth-child(1) { top: 0; left: 0; }
.aq-hero__callout:nth-child(2) { top: 0; right: 0; }
.aq-hero__callout:nth-child(3) { bottom: 0; left: 0; }
.aq-hero__callout:nth-child(4) { bottom: 0; right: 0; }
.aq-hero__callout:nth-child(n+3) { border-top: 0; border-bottom: 1px solid var(--flow); }
.aq-hero__callout dd { margin: 0; font: 300 clamp(16px, 1.7cqi, 22px)/1.2 var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: anywhere; }
.aq-hero__callout dt { font: 500 11px/15px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }

/* Index (hub and company pages): the other pages of this section, numbered, joined by one routed line.
   A 1 px line-strong rule runs down the left from a node to an arrowhead; each item has a dot on the rule and a
   short leader ending in an arrowhead at its number. Number row centre: space-3 padding + 24 px (half of 48 px). */
.aq-hero__grid--index { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; }
.aq-hero__index { position: relative; z-index: 1; min-width: 0; }
.aq-hero__index-label { margin: 0 0 var(--space-2) var(--space-8); font: 500 11px/15px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-hero__index ol { counter-reset: aq-hero-index; position: relative; margin: 0; padding: 0 0 var(--space-6) var(--space-8); list-style: none; }
.aq-hero__index ol::before { content: ""; position: absolute; top: 0; bottom: 6px; left: 0; border-left: 1px solid var(--line-strong); }
.aq-hero__index ol::after { content: ""; position: absolute; bottom: 0; left: -4px; width: 0; height: 0; border-top: 6px solid var(--line-strong); border-inline: 4.5px solid transparent; }
.aq-hero__index li { counter-increment: aq-hero-index; position: relative; }
.aq-hero__index li::before { content: ""; position: absolute; top: calc(var(--space-3) + 24px - 3px); left: calc(-1 * var(--space-8) - 3px); width: 7px; height: 7px; border-radius: var(--radius-pill); background: var(--line-strong); transition: background-color 120ms; }
.aq-hero__index li::after { content: ""; position: absolute; top: calc(var(--space-3) + 24px); left: calc(-1 * var(--space-8)); width: calc(var(--space-6) - 6px); border-top: 1px solid var(--line-strong); }
