/* Head: logo, a vertical rule, one line of description */
.aq-footer__head {
  grid-column: 1 / -1; display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-4) var(--space-6);
  padding: var(--space-8) var(--space-8) var(--space-6);
