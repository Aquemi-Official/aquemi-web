  .aq-notes-register__table tbody tr { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-2); padding-block: var(--space-3); }
  .aq-notes-register__table tbody tr:first-child { border-top: 1px solid var(--line-strong); }
