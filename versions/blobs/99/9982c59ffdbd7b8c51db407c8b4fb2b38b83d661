.aq-footer a:focus-visible, .aq-footer__colhead:focus-visible { outline: 2px solid var(--limestone); outline-offset: 2px; }
.aq-footer .aq-small { color: var(--on-navy-muted); }

/* Title block: bottom right, label/value cells */
.aq-footer__block {
  grid-column: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 60%, transparent);
  border-left: 1px solid color-mix(in srgb, var(--on-navy-muted) 60%, transparent);
