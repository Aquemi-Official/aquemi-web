  display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-4); margin: 0;
  background: transparent; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); cursor: pointer;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap;
}
