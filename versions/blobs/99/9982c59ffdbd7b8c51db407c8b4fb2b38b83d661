@media (prefers-reduced-motion: reduce) { .aq-linkgrid .aq-rows__art, .aq-linkgrid .aq-rows__t { transition: none; } }

/* ---------- NotesRegister: technical notes as a drawing register (block "register") ----------
   Desktop: topic chips across the top; the featured note in a framed panel on the left, the register (date, no.,
   topic, title, standard) on the right, framed like a revision table. Phones: chips scroll sideways, the panel sits
   above, rows become two lines (title; topic · standard · status). Works on the navy and on a light sheet. */
.aq-notes-register {
  display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
  grid-template-areas: "filter filter" "count count" "feature reg"; column-gap: var(--space-8); align-items: start;
}
