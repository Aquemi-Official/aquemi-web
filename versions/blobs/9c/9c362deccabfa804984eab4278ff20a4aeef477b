/* ---------- VisitPlan: a service visit walked around the plant (look "visit-plan") ----------
   A limestone band (data-theme="light" on the section, so the sheet stays paper in both themes). The drawing sheet
   (IsoKit on limestone) carries the plant, the dashed walk on the floor and the numbered stops (pin, ring, number in
   mono; the sign-off stop a tick). Under the sheet, the cards: one column per stop on hairlines, numbered like the
   stops. A lit card (hover or focus) turns its stop and its parts flow. Phones: no big sheet; the walk runs down the
   left, each card a row with its stage drawn small. */
.aq-visit-plan-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; max-width: 18ch; }
.aq-visit-plan { --vp-ink: var(--on-limestone); }
.aq-visit-plan__sheet { border: 1px solid color-mix(in srgb, var(--on-limestone-muted) 40%, transparent); }
.aq-visit-plan__svg { display: block; width: 100%; height: auto; }
.aq-visit-plan__walk { fill: none; stroke: var(--navy); stroke-width: 1.5; stroke-dasharray: 5 5; stroke-linecap: round; }
.aq-visit-plan__pin { fill: none; stroke: var(--navy); stroke-width: 1; }
.aq-visit-plan__mark circle { fill: var(--limestone); stroke: var(--navy); stroke-width: 1.5; transition: fill 200ms ease, stroke 200ms ease; }
.aq-visit-plan__mark text { font: 500 11px/1 var(--font-mono); fill: var(--navy); text-anchor: middle; }
.aq-visit-plan__mark.is-end circle { fill: var(--navy); }
.aq-visit-plan__tick { fill: none; stroke: var(--limestone); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.aq-visit-plan__mark.is-on circle { fill: var(--flow); stroke: var(--flow); }
.aq-visit-plan__mark.is-on text { fill: var(--surface); }
.aq-visit-plan__mark.is-on .aq-visit-plan__pin { stroke: var(--flow); }
/* cards */
.aq-visit-plan__stops { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 7), minmax(0, 1fr)); border-bottom: 1px solid color-mix(in srgb, var(--on-limestone-muted) 40%, transparent); }
.aq-visit-plan__stop { min-width: 0; border-left: 1px solid color-mix(in srgb, var(--on-limestone-muted) 30%, transparent); }
.aq-visit-plan__stop:first-child { border-left: 0; }
.aq-visit-plan__body { display: flex; flex-direction: column; gap: var(--space-2); height: 100%; padding: var(--space-4) var(--space-3) var(--space-6); color: var(--on-limestone); text-decoration: none; outline-offset: -2px; transition: background-color 200ms ease; }
.aq-visit-plan__body:focus-visible { outline: 2px solid var(--focus); }
.aq-visit-plan__stop.is-on .aq-visit-plan__body, .aq-visit-plan__body:hover { background: color-mix(in srgb, var(--limestone) 80%, var(--surface-raised)); }
.aq-visit-plan__fig { display: flex; align-items: center; gap: var(--space-2); }
.aq-visit-plan__mini { display: none; }
.aq-visit-plan__n { display: inline-grid; place-items: center; width: var(--space-8); height: var(--space-8); border: 1.5px solid var(--navy); border-radius: 50%; font: 500 12px/1 var(--font-mono); color: var(--navy); transition: background-color 200ms ease, color 200ms ease; }
.aq-visit-plan__n svg { width: var(--space-4); height: var(--space-4); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.aq-visit-plan__stop.is-end .aq-visit-plan__n { background: var(--navy); color: var(--limestone); }
.aq-visit-plan__stop.is-on .aq-visit-plan__n { background: var(--flow); border-color: var(--flow); color: var(--surface); }
.aq-visit-plan__cap { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-visit-plan__t { margin: 0; font: 500 16px/22px var(--font-sans); color: var(--on-limestone); text-wrap: balance; }
a.aq-visit-plan__body .aq-visit-plan__t::after { content: " →"; color: var(--flow); }
a.aq-visit-plan__body:hover .aq-visit-plan__t { color: var(--flow); }
.aq-visit-plan__d { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--on-limestone-muted); text-wrap: pretty; }

@container (max-width: 860px) {
  .aq-visit-plan-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
  .aq-visit-plan__sheet { display: none; }
  .aq-visit-plan__stops { display: block; position: relative; border: 0; }
  .aq-visit-plan__stops::before { content: ""; position: absolute; left: calc(var(--space-4) - 1px); top: var(--space-6); bottom: var(--space-6); border-left: 1.5px dashed var(--navy); }
  .aq-visit-plan__stop { border: 0; border-top: 1px solid color-mix(in srgb, var(--on-limestone-muted) 30%, transparent); }
  .aq-visit-plan__body { display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr) auto; column-gap: var(--space-3); row-gap: var(--space-1); padding: var(--space-4) 0; }
  .aq-visit-plan__fig { display: contents; }
  .aq-visit-plan__n { grid-column: 1; grid-row: 1 / span 3; align-self: start; position: relative; background: var(--limestone); }
  .aq-visit-plan__mini { display: block; grid-column: 3; grid-row: 1 / span 3; width: calc(var(--space-16) + var(--space-8)); height: auto; align-self: start; }
  .aq-visit-plan__cap, .aq-visit-plan__t, .aq-visit-plan__d { grid-column: 2; }
}
.aq-visit-plan__walker { fill: var(--flow); stroke: var(--limestone); stroke-width: 2; }
