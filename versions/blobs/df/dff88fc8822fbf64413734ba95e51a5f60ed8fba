/* ---------- SplitSection: heading column left, content right ---------- */
.aq-split-section { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-12); align-items: start; }
.aq-split-section__head { position: sticky; top: var(--space-8); display: flex; flex-direction: column; gap: var(--space-4); }
.aq-split-section__head .aq-h1 { font-size: 32px; line-height: 38px; }
.aq-split-section__head .aq-lead { font-size: 16px; line-height: 26px; }
.aq-split-section__body { min-width: 0; display: flex; flex-direction: column; gap: var(--space-6); }
.aq-split-section__body .aq-prose p:first-child { font: 400 20px/30px var(--font-sans); color: var(--ink); }
.aq-split-section__body .aq-prose p:not(:first-child) { color: var(--ink-muted); }

@container (max-width: 860px) {
  /* Phones: the head stacks above the body with the same head as every other section (aq-h1 30/36, lead 18/28)
     and the same space-8 gap to the content, so split and stacked sections keep one rhythm. */
  .aq-split-section { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
  .aq-split-section__head { position: static; }
  .aq-split-section__head .aq-h1 { font-size: 30px; line-height: 36px; }
  .aq-split-section__head .aq-lead { font-size: 18px; line-height: 28px; }
}
