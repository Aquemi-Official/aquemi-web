/* ---------- DocList ---------- */
.aq-docs { columns: 2 280px; column-gap: var(--space-12); margin: 0; padding: 0; list-style: none; }
.aq-docs li { break-inside: avoid; padding: var(--space-3) 0; border-top: 1px solid var(--line); display: flex; gap: var(--space-3); }
.aq-docs li::before { content: ""; flex: 0 0 10px; height: 12px; margin-top: 6px; border: 1px solid var(--line-strong); border-top-right-radius: 3px; }
