/* ---------- OptionModules: options as framed modules around the base skid (options block, as: "modules") ----------
   Desktop: three columns, modules | base drawing on a plate | modules, each module wired to the plate by a dashed hairline.
   Phones: the plate on top, then one column of modules hanging off a dashed vertical spine. */
.aq-option-modules {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
  column-gap: var(--space-12); align-items: stretch; min-width: 0;
}
.aq-option-modules--bare { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.aq-option-modules__list {
  list-style: none; margin: 0; padding: 0; min-width: 0;
  display: flex; flex-direction: column; justify-content: space-around; gap: var(--space-8);
}
.aq-option-modules__m { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.aq-option-modules__cat { margin: 0; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-option-modules__m--l .aq-option-modules__cat { text-align: right; }

/* The module: a framed box with a mono title bar, the vignette at left and the line beside it. */
.aq-option-modules__box {
  position: relative; display: grid; grid-template-columns: calc(var(--space-24) + var(--space-3)) minmax(0, 1fr); align-items: center;
  justify-items: center;
  border: 1px solid var(--line-strong); background: var(--surface);
}
.aq-option-modules__box--bare { grid-template-columns: minmax(0, 1fr); }
.aq-option-modules__t {
  grid-column: 1 / -1; justify-self: stretch; display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3);
  margin: 0; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line-strong);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink);
}
.aq-option-modules__plus { flex: none; color: var(--flow); }
.aq-option-modules__vig { margin: var(--space-3) 0 var(--space-3) var(--space-3); }
.aq-option-modules__d { justify-self: stretch; margin: 0; padding: var(--space-3); font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }

/* Connector: a dashed hairline from the title bar to the plate edge, ending in a node on the plate. */
.aq-option-modules__wire {
  position: absolute; top: 0; height: var(--space-8); width: var(--space-12); overflow: visible; pointer-events: none;
}
.aq-option-modules__m--l .aq-option-modules__wire { left: 100%; }
.aq-option-modules__m--r .aq-option-modules__wire { right: 100%; }
.aq-option-modules__wire line { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-option-modules__wire circle { fill: var(--flow); }

/* The base: the page's own equipment drawing on a plate, as tall as the module columns. */
.aq-option-modules__base { display: flex; align-items: center; justify-content: center; min-width: 0; }
.aq-option-modules__fig { margin: 0; width: 100%; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
.aq-option-modules__art { width: 100%; max-width: calc(var(--space-32) * 3); aspect-ratio: 1; background-color: var(--on-navy-muted); }
.aq-option-modules__label { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); text-align: center; }
.aq-option-modules__label span + span { color: var(--ink-muted); }

/* Fold: on desktop every module stays on the drawing (the layout needs both columns); the fold works on phones. */
.aq-fold:not(.is-open) .aq-option-modules__m.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-option-modules) > .aq-fold__btn { display: none; }

@container (max-width: 860px) {
  .aq-option-modules, .aq-option-modules--bare { display: flex; flex-direction: column; }
  .aq-option-modules__base { order: -1; padding: var(--space-4) var(--space-4) var(--space-4) var(--space-8); justify-content: flex-start; }
  .aq-option-modules__fig { flex-direction: row; gap: var(--space-4); }
  .aq-option-modules__art { width: var(--space-24); flex: none; }
  .aq-option-modules__label { align-items: flex-start; text-align: left; }

  /* The spine: one dashed line from the plate down past every module. */
  .aq-option-modules__list {
    justify-content: flex-start; gap: var(--space-4);
    margin-left: var(--space-3); padding: var(--space-4) 0 0 var(--space-4); border-left: 1px dashed var(--line-strong);
  }
  /* The second list joins the first without a gap of its own while all its modules are folded away. */
  .aq-option-modules__list--r { padding-top: 0; }
  .aq-fold.is-open .aq-option-modules__list--r, .aq-option-modules__list--r:has(> li:not(.aq-fold-x)) { padding-top: var(--space-4); }
  .aq-option-modules__m--l .aq-option-modules__cat { text-align: left; }
  .aq-option-modules__m--l .aq-option-modules__wire, .aq-option-modules__m--r .aq-option-modules__wire {
    left: auto; right: 100%; width: calc(var(--space-4) + 1px);
  }
  .aq-option-modules__m--l .aq-option-modules__wire { transform: scaleX(-1); }
  .aq-option-modules__box { grid-template-columns: auto minmax(0, 1fr); }
  .aq-option-modules__box--bare { grid-template-columns: minmax(0, 1fr); }
  .aq-option-modules__vig.aq-spot { width: var(--space-16); height: var(--space-16); }
  .aq-option-modules__vig.aq-spot--icon { width: var(--space-12); height: var(--space-12); }
  .aq-option-modules__vig { margin: var(--space-2) 0 var(--space-2) var(--space-3); }
  .aq-option-modules__d { padding: var(--space-2) var(--space-3); font-size: 13px; line-height: 20px; }

  .aq-fold:not(.is-open) .aq-option-modules__m.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-option-modules) > .aq-fold__btn { display: flex; }
}
