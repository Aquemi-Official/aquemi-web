/* ---------- SitePlates: sites as figure plates, two to a row (look site-plates) ----------
   Each plate: an isometric drawing of what stands there on a limestone panel (IsoKit, aq-iso--limestone) beside the
   site's index and place, its kind set large and light, and what happens here, the address and the contact lines.
   Plates sit on hairlines; phones stack the drawing above the words. */
.aq-site-plates { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-8); }
.aq-site-plates__plate {
  display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-6); align-items: start; min-width: 0;
  padding-top: var(--space-6); border-top: 1px solid var(--line-strong);
}
.aq-site-plates__fig { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; padding: var(--space-4); background: var(--limestone); overflow: hidden; }
/* a faint ground grid on the panel, the drawing set on it */
.aq-site-plates__fig::before { content: ""; position: absolute; inset: var(--space-2); border: 1px solid color-mix(in srgb, var(--on-limestone-muted) 25%, transparent); }
.aq-site-plates__svg { position: relative; width: 100%; height: 100%; max-height: calc(var(--space-32) + var(--space-16)); }
.aq-site-plates__text { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
.aq-site-plates__at { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); font: 500 12px/18px var(--font-mono); letter-spacing: 0.04em; color: var(--ink-muted); }
.aq-site-plates__i { font-variant-numeric: tabular-nums; color: var(--flow); letter-spacing: 0.08em; }
.aq-site-plates__t { margin: 0; font: 300 32px/38px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
.aq-site-plates__t a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 5px; text-decoration-color: var(--flow); }
.aq-site-plates__t a:hover { color: var(--flow); }
.aq-site-plates__dl { margin: var(--space-2) 0 0; display: flex; flex-direction: column; }
.aq-site-plates__dl > div { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-1); padding-block: var(--space-3); border-top: 1px solid var(--line); }
.aq-site-plates__dl dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-site-plates__dl dd { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); font: 400 15px/22px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-site-plates-sec .aq-fold__btn { margin-top: var(--space-6); }

@media (prefers-reduced-motion: no-preference) {
  .aq-site-plates__svg { transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-site-plates__plate:hover .aq-site-plates__svg, .aq-site-plates__plate:focus-within .aq-site-plates__svg { transform: translateY(calc(-1 * var(--space-1))); }
}

@container (max-width: 860px) {
  .aq-site-plates { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-site-plates__plate { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); padding-top: var(--space-4); }
  .aq-site-plates__fig { aspect-ratio: 16 / 9; }
  .aq-site-plates__t { font-size: 26px; line-height: 32px; }
}
