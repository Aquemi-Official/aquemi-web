/* ---------- PqCalendar: PQ as a year's sampling calendar (look "pq-calendar") ----------
   Section on the limestone band; the figure carries data-theme="light" so its navy and flow stay the light values on
   limestone in both themes. The year strip is an svg of week bars stretched to the width (solid navy and flow for the
   daily phases, a navy hatch for the routine plan), months numbered under it on a twelve-track grid. The zoom is a
   flow-tint wedge from the first weeks down to the sampling grid (7 of 12 columns); the total sits beside it (5 of 12)
   over the routine phase. Phase keys repeat the grid's fills. */
.aq-pq-calendar { --pq-p1: var(--navy); --pq-p2: var(--flow); color: var(--on-limestone); }
.aq-pq-calendar__strip { position: relative; }
.aq-pq-calendar__year { display: block; width: 100%; height: var(--space-12); }
.aq-pq-calendar__wk.is-p1 { fill: var(--pq-p1, var(--navy)); }
.aq-pq-calendar__wk.is-p2 { fill: var(--pq-p2, var(--flow)); }
.aq-pq-calendar__wk.is-rest { stroke: none; }
.aq-pq-calendar__hatch { fill: var(--pq-p1, var(--navy)); opacity: 0.55; }
.aq-pq-calendar__months { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); margin-top: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--on-limestone) 40%, transparent); }
.aq-pq-calendar__months span { padding: var(--space-1) 0 0 var(--space-1); border-left: 1px solid color-mix(in srgb, var(--on-limestone) 40%, transparent); font: 500 12px/16px var(--font-mono); color: var(--on-limestone-muted); }
.aq-pq-calendar__ylab { position: absolute; right: 0; top: calc(100% + var(--space-1)); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); transform: translateY(100%); }
.aq-pq-calendar__zoom { display: block; width: 100%; height: var(--space-16); margin-top: var(--space-2); }
.aq-pq-calendar__zoom .is-wide { display: none; }
.aq-pq-calendar__zw { fill: color-mix(in srgb, var(--surface-raised) 55%, transparent); stroke: none; }
.aq-pq-calendar__zoom .aq-pq-calendar__zl { fill: none; stroke: var(--on-limestone); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 3 4; }
.aq-pq-calendar__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-12); }
.aq-pq-calendar__zoomed { background: color-mix(in srgb, var(--surface-raised) 55%, transparent); padding: var(--space-6); }
.aq-pq-calendar__grid { display: block; width: 100%; height: auto; overflow: visible; }
.aq-pq-calendar__dot.is-p1 { fill: var(--pq-p1, var(--navy)); }
.aq-pq-calendar__dot.is-p2 { fill: var(--pq-p2, var(--flow)); }
.aq-pq-calendar__hl { stroke: var(--on-limestone); stroke-width: 1.5; stroke-dasharray: 4 3; }
.aq-pq-calendar__phases { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(var(--days, 28), minmax(0, 1fr)); column-gap: var(--space-6); }
.aq-pq-calendar__ph { grid-column: span var(--span, 1); min-width: 0; }
.aq-pq-calendar__phases--rest { display: block; margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid color-mix(in srgb, var(--on-limestone) 40%, transparent); }
.aq-pq-calendar__t { margin: 0; display: flex; align-items: center; gap: var(--space-2); font: 500 18px/26px var(--font-sans); color: var(--on-limestone); }
.aq-pq-calendar__key { width: var(--space-4); height: var(--space-4); flex: none; background: var(--pq-p1, var(--navy)); border-radius: 50%; }
.is-p2 > .aq-pq-calendar__t .aq-pq-calendar__key { background: var(--pq-p2, var(--flow)); }
.is-rest > .aq-pq-calendar__t .aq-pq-calendar__key { border-radius: 0; width: var(--space-6); height: var(--space-3); background: color-mix(in srgb, var(--pq-p1, var(--navy)) 55%, transparent); }
.aq-pq-calendar__d { margin: var(--space-1) 0 0; font: 400 15px/23px var(--font-sans); color: var(--on-limestone-muted); }
.aq-pq-calendar__hold { margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font: 400 14px/20px var(--font-sans); color: var(--on-limestone); }
.aq-pq-calendar__hold span { padding: 0 var(--space-2); border: 1.5px solid var(--on-limestone); font: 500 12px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-pq-calendar__total { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-pq-calendar__num { font: 300 120px/1 var(--font-mono); letter-spacing: -0.06em; color: var(--on-limestone); font-variant-numeric: tabular-nums; }
.aq-pq-calendar__unit { font: 400 22px/28px var(--font-sans); color: var(--on-limestone); }
.aq-pq-calendar__eq { font: 500 13px/18px var(--font-mono); letter-spacing: 0.04em; color: var(--on-limestone-muted); }

@container (max-width: 860px) {
  .aq-pq-calendar__year { height: var(--space-8); }
  .aq-pq-calendar__months span { padding-left: var(--space-1); font-size: 12px; }
  .aq-pq-calendar__months span:nth-child(even) { color: transparent; }
  .aq-pq-calendar__ylab { position: static; display: block; transform: none; margin-top: var(--space-1); }
  .aq-pq-calendar__zoom { height: var(--space-8); }
  .aq-pq-calendar__zoom .is-wide { display: inline; }
  .aq-pq-calendar__zoom path:not(.is-wide) { display: none; }
  .aq-pq-calendar__body { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
  .aq-pq-calendar__zoomed { padding: var(--space-3); }
  .aq-pq-calendar__phases { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); }
  .aq-pq-calendar__ph { grid-column: auto; }
  .aq-pq-calendar__num { font-size: 72px; }
  .aq-pq-calendar__t { font-size: 17px; line-height: 24px; }
  .aq-pq-calendar__d { font-size: 14px; line-height: 22px; }
  .aq-pq-calendar__phases--rest { margin-top: var(--space-6); }
}

/* section hook and the right-hand column */
.aq-pq-calendar-sec { position: relative; }
.aq-pq-calendar__aside { min-width: 0; }
