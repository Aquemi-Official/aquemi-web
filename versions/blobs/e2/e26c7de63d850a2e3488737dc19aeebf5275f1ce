/* ---------- CaseStudy ---------- */
.aq-cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); }
.aq-case { border-top: 1px solid var(--line-strong); padding-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
.aq-case dl { margin: 0; display: grid; gap: var(--space-2); }
.aq-case dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case dd { margin: 0 0 var(--space-2); }
.aq-cases:has(> :only-child) .aq-case dl { grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); column-gap: var(--space-8); row-gap: var(--space-4); }
.aq-cases:has(> :only-child) .aq-case dd { margin: 0; }

@container (max-width: 860px) {
  .aq-cases:has(> :only-child) .aq-case dl { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
}
