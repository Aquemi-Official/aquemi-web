/* ---------- VisitRoute: a visit's stops on one dashed route (grid block as "route") ----------
   Desktop: rows of 3 or 4 stops; odd rows run left to right, even rows right to left, joined by U-turns at the ends
   (placement from --c / --r set by the renderer; DOM order is the route order). Each stop: a ring with its number on
   the route, the title and one line under it. Phones: one vertical route down the left, ring | text. */
.aq-visit-route { --m: var(--space-12); list-style: none; margin: 0; padding: 0 var(--space-8); display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); column-gap: var(--space-8); }
.aq-visit-route__stop { position: relative; grid-column: var(--c, auto); grid-row: var(--r, auto); min-width: 0; padding-bottom: var(--space-12); }
.aq-visit-route__stop.is-last { padding-bottom: 0; }
.aq-visit-route__body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-2); }
:where(.aq-page) a.aq-visit-route__body { color: var(--ink); text-decoration: none; }
.aq-visit-route__n { display: inline-grid; place-items: center; width: var(--m, var(--space-12)); height: var(--m, var(--space-12)); margin-bottom: var(--space-2); border: 1px solid var(--flow); border-radius: var(--radius-pill); background: var(--surface); font: 500 14px/1 var(--font-mono); font-variant-numeric: tabular-nums; color: var(--flow); }
.aq-visit-route__n svg { width: var(--space-6); height: var(--space-6); fill: none; stroke: currentColor; stroke-width: 2; }
.aq-visit-route__stop.is-end .aq-visit-route__n { background: var(--flow); color: var(--surface); }
.aq-visit-route__t { margin: 0; font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); text-wrap: pretty; }
.aq-visit-route__d { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
a.aq-visit-route__body .aq-visit-route__t::after { content: "\a0\2192"; color: var(--flow); }
a.aq-visit-route__body:hover .aq-visit-route__t { color: var(--flow); }
a.aq-visit-route__body:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* The route: ::after runs to the next stop in the row (or to the column edge before a U-turn); ::before is the U-turn
   at the row end, or the lead-in from the column edge on a right-to-left row. */
.aq-visit-route__stop::before, .aq-visit-route__stop::after { content: ""; position: absolute; top: calc(var(--m, var(--space-12)) / 2); border: 0 dashed var(--flow); pointer-events: none; }
.aq-visit-route__stop.is-ltr::after { left: calc(var(--m, var(--space-12)) / 2); width: calc(100% + var(--space-8)); border-top-width: 1px; }
.aq-visit-route__stop.is-rtl::after { right: calc(100% - var(--m, var(--space-12)) / 2); width: calc(100% + var(--space-8)); border-top-width: 1px; }
.aq-visit-route__stop.is-ltr.is-turn::after { width: calc(100% - var(--m, var(--space-12)) / 2); }
.aq-visit-route__stop.is-rtl.is-turn::after, .aq-visit-route__stop.is-last::after { display: none; }
.aq-visit-route__stop.is-turn::before { height: 100%; width: var(--space-8); border-width: 1px 0; }
.aq-visit-route__stop.is-ltr.is-turn::before { left: 100%; border-right-width: 1px; border-radius: 0 var(--radius-pill) var(--radius-pill) 0; }
.aq-visit-route__stop.is-rtl.is-turn::before { right: 100%; border-left-width: 1px; border-radius: var(--radius-pill) 0 0 var(--radius-pill); }
.aq-visit-route__stop.is-rtl.is-in::before { left: calc(var(--m, var(--space-12)) / 2); right: 0; border-top-width: 1px; }

@media (prefers-reduced-motion: no-preference) { .aq-visit-route__t { transition: color 120ms; } }

@container (max-width: 860px) {
  .aq-visit-route { --m: var(--space-8); padding: 0; grid-template-columns: minmax(0, 1fr); }
  .aq-visit-route__stop { grid-column: 1; grid-row: auto; padding-bottom: var(--space-6); }
  .aq-visit-route__body { display: grid; grid-template-columns: var(--m, var(--space-12)) minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1); }
  .aq-visit-route__n { grid-row: 1 / span 2; margin: 0; font-size: 12px; }
  .aq-visit-route__n svg { width: var(--space-4); height: var(--space-4); }
  .aq-visit-route__t { font-size: 16px; line-height: 24px; padding-top: var(--space-1); }
  .aq-visit-route__d { grid-column: 2; font-size: 14px; line-height: 22px; }
  .aq-visit-route__stop::before, .aq-visit-route__stop.is-rtl.is-in::before { display: none; }
  .aq-visit-route__stop::after, .aq-visit-route__stop.is-ltr::after, .aq-visit-route__stop.is-rtl::after, .aq-visit-route__stop.is-ltr.is-turn::after, .aq-visit-route__stop.is-rtl.is-turn::after {
    display: block; left: calc(var(--m, var(--space-12)) / 2); right: auto; width: 0; height: 100%; border-width: 0 0 0 1px;
  }
  .aq-visit-route__stop.is-last::after { display: none; }
}
