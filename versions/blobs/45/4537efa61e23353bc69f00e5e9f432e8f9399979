/* ---------- Button ---------- */
.aq-btn {
  display: inline-flex; align-items: center; gap: var(--space-2);
  height: 44px; padding: 0 var(--space-6);
  border: 1px solid transparent; border-radius: var(--radius-sm);
  font: 500 14px/20px var(--font-sans); letter-spacing: 0; white-space: nowrap;
  text-decoration: none; cursor: pointer;
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1), transform 120ms cubic-bezier(0.2, 0, 0, 1);
}
/* Pass 9b motion (Button/motion.js). The transform is one composition so every effect can share it:
   --aq-mx / --aq-my: the primary's magnetic pull (px, numbers); --aq-px / --aq-py: where the press landed (-1..1).
   Press (press-depth): the button sinks a pixel, shrinks to 0.97 and tips up to 3 deg toward the press point, 60 ms
   down and 180 ms back; the arrow pulls back, like a key going down. While the magnet follows the pointer (is-magnet)
   the transform is driven frame by frame, so its transition is dropped. */
.aq-btn { transform: translate(calc(var(--aq-mx, 0) * 1px), calc(var(--aq-my, 0) * 1px)); }
.aq-btn:active:not([disabled]) {
  transform: translate(calc(var(--aq-mx, 0) * 1px), calc(var(--aq-my, 0) * 1px)) perspective(340px)
    rotateX(calc(var(--aq-py, 0) * -3deg)) rotateY(calc(var(--aq-px, 0) * 3deg)) translateY(1px) scale(0.97);
  transition-duration: 60ms;
}
.aq-btn:not(:active) { transition-duration: 200ms, 200ms, 180ms; }
.aq-btn.is-magnet:not(:active) { transition-property: background-color, border-color; }
/* Secondary hover (slide-text): the label rolls up and its copy (a text-shadow one button-height down) rolls in */
.aq-btn--secondary { overflow: hidden; }
.aq-btn__label { display: inline-flex; align-items: center; gap: inherit; }
.aq-btn:active:not([disabled]) .aq-btn__arrow { transform: translateX(1px); }
.aq-btn--primary { background: var(--action); color: var(--on-action); }
.aq-btn--primary:hover { background: var(--action-hover); }
.aq-btn--secondary { background: transparent; color: var(--ink); border-color: var(--line-strong); }
.aq-btn--secondary:hover { border-color: var(--ink); }
.aq-btn--link { height: auto; padding: 0; color: var(--flow); background: none; }
.aq-btn--link:hover { text-decoration: underline; text-underline-offset: 4px; }
.aq-btn[disabled] { background: var(--surface-sunken); color: var(--ink-subtle); border-color: transparent; cursor: not-allowed; }
/* Pending call: a call button whose number is still a [placeholder]. A <span>, not a link: the label as plain text in the
   ground's own colour, no fill or frame, so the draft shows the missing number and nothing pretends to dial */
.aq-btn.aq-btn--pending { padding: 0; background: none; border-color: transparent; color: inherit; cursor: default; }
.aq-btn.aq-btn--pending:active { transform: none; }
.aq-btn__arrow { transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-btn:hover .aq-btn__arrow, .aq-btn:focus-visible .aq-btn__arrow { transform: translateX(4px); }

@media (prefers-reduced-motion: reduce) {
  .aq-btn, .aq-btn__arrow { transition: none; }
  .aq-btn, .aq-btn:active:not([disabled]), .aq-btn:active:not([disabled]) .aq-btn__arrow { transform: none; }
}

/* Narrow containers: long labels wrap inside the button instead of running off the screen */
@container (max-width: 860px) {
  .aq-btn { height: auto; min-height: 44px; max-width: 100%; padding-block: var(--space-3); white-space: normal; text-align: left; }
  .aq-btn--link { min-height: 44px; padding: 0; justify-content: flex-start; }
}
