/* ---------- CompareTable ---------- */
/* A comparison matrix: column heads as eyebrow labels, numbered row labels in a narrow left column, hairline cells.
   Desktop: a real table. Phones: each row is a record, its first cell the title and every other cell a "Label value" line.
   The --list variant (two columns) is a numbered row list at every width. */
.aq-compare-table {
  counter-reset: aq-compare-row;
  color: var(--ink);
  min-width: 0;
}
/* Column label inside each cell, and the column tabs: phones only (the thead names the column on desktop) */
.aq-compare-table__k, .aq-compare-table__tabs { display: none; }

.aq-compare-table__table {
  width: 100%; table-layout: fixed; border-collapse: collapse;
  border-block: 1px solid var(--line);
  font-family: var(--font-sans);
}
.aq-compare-table__table th,
.aq-compare-table__table td {
  text-align: left; vertical-align: top;
  padding: var(--space-4);
  border-bottom: 1px solid var(--line);
  border-left: 1px solid var(--line);
  overflow-wrap: break-word;
}
.aq-compare-table__table tr > :first-child { border-left: 0; width: 22%; }

/* Column heads: eyebrow labels */
.aq-compare-table__table thead th {
  background: var(--surface-sunken);
  border-bottom-color: var(--line-strong);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--ink-muted);
}
/* Row labels: the narrow left column, numbered */
.aq-compare-table__table tbody tr { counter-increment: aq-compare-row; }
.aq-compare-table__table tbody th {
  font: 500 14px/22px var(--font-sans); color: var(--ink);
}
/* Row index: the shared index style (.aq-index), written by CSS so cells stay plain */
.aq-compare-table__table tbody th::before {
  content: counter(aq-compare-row, decimal-leading-zero);
  content: counter(aq-compare-row, decimal-leading-zero) / "";
  display: block; margin-bottom: var(--space-1);
  font: 400 13px/24px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  color: var(--ink-subtle);
}
.aq-compare-table__table tbody td { font: 400 14px/22px var(--font-sans); color: var(--ink); }
.aq-compare-table__table tbody tr:last-child > * { border-bottom: 0; }

/* Routing link: names the destination page, reads "PW generation →" */
.aq-compare-table__table td a {
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--flow); text-decoration: none;
}
.aq-compare-table__table td a::after { content: " →"; content: " →" / ""; }
.aq-compare-table__table td a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
.aq-compare-table__table td a:focus-visible,
.aq-compare-table__tab:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* List variant (two columns): numbered rows, label left, value right; thead becomes a label strip */
.aq-compare-table--list .aq-compare-table__table,
.aq-compare-table--list thead,
.aq-compare-table--list tbody { display: block; }
.aq-compare-table--list tr {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
}
.aq-compare-table--list tr > * { width: auto; }
.aq-compare-table--list tr > :first-child { width: auto; }

/* Tab button (--tabs, phones) */
.aq-compare-table__tab {
  appearance: none; flex: none; width: var(--space-32); margin: 0; cursor: pointer;
  display: flex; align-items: flex-start; min-height: 44px;
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--line); border-radius: var(--radius-0);
  background: var(--surface-sunken);
  font: 500 13px/18px var(--font-sans); text-align: left; color: var(--ink-muted);
  overflow-wrap: break-word;
}
.aq-compare-table__tab[aria-pressed="true"] {
  background: var(--surface-raised); color: var(--ink);
  border-color: var(--line-strong); box-shadow: inset 0 2px 0 var(--flow);
}

@container (max-width: 860px) {
  /* Phones: no frame, no sideways scroll, no tabs. Each row is a record on a hairline: index and title (the row label),
     then one line per other column, "Label  value", the label in small muted type. Link-only columns (__go) end the
     record as a plain link. The column heads stay for screen readers only. */
  .aq-compare-table { padding: 0; border: 0; background: none; }
  .aq-compare-table__table,
  .aq-compare-table__table tbody,
  .aq-compare-table__table tr,
  .aq-compare-table__table th,
  .aq-compare-table__table td { display: block; width: auto; }
  .aq-compare-table__table { background: none; border: 0; border-bottom: 1px solid var(--line); }
  .aq-compare-table__table tr > :first-child { width: auto; }
  .aq-compare-table__table thead {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  .aq-compare-table__table tbody tr { padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .aq-compare-table__table th,
  .aq-compare-table__table td { padding: 0; border: 0; }
  .aq-compare-table__table tbody tr:last-child > * { border: 0; }
  /* Title line: the shared index in the left column, the row label beside it */
  .aq-compare-table__table tbody th { position: relative; padding-left: calc(var(--space-8) + var(--space-3)); font: 500 16px/24px var(--font-sans); color: var(--ink); }
  .aq-compare-table__table tbody th::before { position: absolute; left: 0; top: 0; margin: 0; }
  .aq-compare-table__table tbody td { margin-top: 0; padding-left: calc(var(--space-8) + var(--space-3)); font-size: 14px; line-height: 22px; }
  .aq-compare-table__table tbody td[data-empty] { display: none; }
  .aq-compare-table__k { display: inline; margin-right: var(--space-2); font: 500 13px/22px var(--font-sans); color: var(--ink-muted); }
  .aq-compare-table__k::after { content: ":"; }
  .aq-compare-table__table td.aq-compare-table__go { margin-top: var(--space-1); }

  /* Tabs (four or more value columns): one strip of tabs that scrolls inside itself, never two lines; each row the
     label left (13/20 ink-muted) and the chosen column's value right. */
  .aq-compare-table--tabs .aq-compare-table__tabs { display: flex; gap: var(--space-1); margin-bottom: var(--space-2); overflow-x: auto; scrollbar-width: thin; overscroll-behavior-x: contain; }
  .aq-compare-table--tabs .aq-compare-table__table tbody tr { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); column-gap: var(--space-4); align-items: baseline; }
  .aq-compare-table--tabs .aq-compare-table__table tbody th { padding-left: 0; font: 500 13px/20px var(--font-sans); color: var(--ink-muted); }
  .aq-compare-table--tabs .aq-compare-table__table tbody th::before { display: none; }
  .aq-compare-table--tabs .aq-compare-table__table tbody td { grid-column: 2; margin: 0; padding-left: 0; }
  .aq-compare-table--tabs .aq-compare-table__table tbody td[data-empty] { display: block; }
  .aq-compare-table--tabs[data-col="1"] tbody td:not(:nth-child(2)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="2"] tbody td:not(:nth-child(3)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="3"] tbody td:not(:nth-child(4)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="4"] tbody td:not(:nth-child(5)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="5"] tbody td:not(:nth-child(6)):not(.aq-compare-table__go),
  .aq-compare-table--tabs[data-col="6"] tbody td:not(:nth-child(7)):not(.aq-compare-table__go) { display: none; }

  /* List variant (two columns): label above value */
  .aq-compare-table--list .aq-compare-table__table tbody th { padding-left: 0; font: 500 13px/20px var(--font-sans); color: var(--ink-muted); }
  .aq-compare-table--list .aq-compare-table__table tbody th::before { display: none; }
  .aq-compare-table--list .aq-compare-table__table tbody td { padding-left: 0; }
}
