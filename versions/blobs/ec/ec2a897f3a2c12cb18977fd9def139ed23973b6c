/* ---------- ProcessSteps: a real sequence as a stepped pipe run, numbered by CSS ---------- */
/* Desktop: each step sits one shift to the right of the last. The pipe drops down each step's left edge, bends
   right in the gap (the "└", li::before) and turns down into the next step (the "┐", li::after).
   Shift: --space-24 for up to five steps, --space-16 for six to eight. Pipe is a 5 px double rule in flow,
   the same as WaterPath. Desktop indents use :where so the phone rules override them at class specificity. */
.aq-steps {
  list-style: none; margin: 0;
  counter-reset: aq-step;
  padding: var(--space-8) var(--space-8) 0;
  border: 1px solid var(--line);
  background-color: var(--surface);
  background-image: radial-gradient(circle, var(--line-strong) 1px, transparent 1.5px);
  background-size: var(--space-6) var(--space-6);
  background-position: calc(-1 * var(--space-3)) calc(-1 * var(--space-3));
}
.aq-steps > li {
  counter-increment: aq-step;
  position: relative; min-width: 0;
  padding: 0 0 var(--space-12) var(--space-8);
}
.aq-steps > li:last-child { padding-bottom: var(--space-8); }

/* Stair indents: one shift per step */
.aq-steps > li:where(:nth-child(2)) { margin-left: var(--space-24); }
.aq-steps > li:where(:nth-child(3)) { margin-left: calc(2 * var(--space-24)); }
.aq-steps > li:where(:nth-child(4)) { margin-left: calc(3 * var(--space-24)); }
.aq-steps > li:where(:nth-child(5)) { margin-left: calc(4 * var(--space-24)); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(2)) { margin-left: var(--space-16); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(3)) { margin-left: calc(2 * var(--space-16)); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(4)) { margin-left: calc(3 * var(--space-16)); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(5)) { margin-left: calc(4 * var(--space-16)); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(6)) { margin-left: calc(5 * var(--space-16)); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(7)) { margin-left: calc(6 * var(--space-16)); }
.aq-steps:where(:has(> li:nth-child(6))) > li:where(:nth-child(8)) { margin-left: calc(7 * var(--space-16)); }

/* "└": down the step's left edge, bending right halfway through the gap below it */
.aq-steps > li::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: var(--space-6);
  width: calc(var(--space-24) - var(--space-4));
  border-left: 5px double var(--flow); border-bottom: 5px double var(--flow);
  border-bottom-left-radius: var(--space-4);
  pointer-events: none;
}
.aq-steps:where(:has(> li:nth-child(6))) > li::before { width: calc(var(--space-16) - var(--space-4)); }
/* First step: the pipe enters through the panel's top edge. Last step: it leaves through the bottom edge. */
.aq-steps > li:first-child::before { top: calc(-1 * var(--space-8)); }
.aq-steps > li:last-child::before { bottom: 0; width: 0; border-bottom: 0; border-radius: 0; }

/* "┐": the pipe arriving from the step above turns down into this one */
.aq-steps > li + li::after {
  content: ""; position: absolute;
  left: calc(-1 * var(--space-4)); top: calc(-1 * var(--space-6) - 5px);
  width: calc(var(--space-4) + 5px); height: calc(var(--space-6) + var(--space-4) + 5px);
  border-top: 5px double var(--flow); border-right: 5px double var(--flow);
  border-top-right-radius: var(--space-4);
  pointer-events: none;
}

/* Step name with its number: "01 /" in mono flow, then the name */
.aq-steps__t {
  display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3);
  margin: 0; font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; color: var(--ink);
  text-wrap: balance; overflow-wrap: break-word;
}
.aq-steps__t::before {
  content: counter(aq-step, decimal-leading-zero) " /";
  content: counter(aq-step, decimal-leading-zero) " /" / "";
  font: 300 32px/38px var(--font-mono); letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; color: var(--flow); white-space: nowrap;
}
.aq-steps__d {
  margin: var(--space-2) 0 0; max-width: var(--text-max);
  font: 400 15px/24px var(--font-sans); color: var(--ink-muted);
  text-wrap: pretty; overflow-wrap: break-word;
}

@container (max-width: 860px) {
  /* Phones: one straight riser down the left; a ring on the pipe marks each step */
  .aq-steps { padding: var(--space-6) var(--space-4) 0; }
  .aq-steps > li { margin-left: 0; padding: 0 0 var(--space-8) var(--space-6); }
  .aq-steps > li::before,
  .aq-steps:where(:has(> li:nth-child(6))) > li::before { top: 0; bottom: 0; width: 0; border-bottom: 0; border-radius: 0; }
  .aq-steps > li:first-child::before { top: calc(-1 * var(--space-6)); }
  .aq-steps > li::after,
  .aq-steps > li + li::after {
    content: ""; position: absolute; pointer-events: none; left: -5px; top: var(--space-3);
    width: 15px; height: 15px;
    border: 1.5px solid var(--flow); border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .aq-steps__t { font-size: 18px; line-height: 26px; column-gap: var(--space-2); }
  .aq-steps__t::before { font-size: 24px; line-height: 30px; }
  .aq-steps__d { font-size: 14px; line-height: 22px; }
}
