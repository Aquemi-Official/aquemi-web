<!-- @dsCard group="Forms" height=1860 width=1000 subtitle="A numbered data sheet; the stepped form's first step, with a note that sends supplier audits to their own form" -->
<div class="aq-page"><section class="aq-section"><div class="aq-in aq-stack-l">
  <h2 class="aq-h1">Request a proposal</h2>
  <form class="aq-form" novalidate onsubmit="event.preventDefault()">
    <p class="aq-form__title"><span>Data sheet</span><span>2 sections · 6 required</span></p>
    <fieldset class="aq-form__section">
      <legend class="aq-form__legend"><span class="aq-form__num">1.0</span> System data</legend>
      <div class="aq-form__grid">
        <div class="aq-field"><label class="aq-field__label" for="ef-stage"><span class="aq-form__ref" aria-hidden="true">1.1</span>Project stage</label><select class="aq-field__input" id="ef-stage" name="project-stage" required><option value="">Choose…</option><option>Feasibility or budget estimate</option><option>Basic design or URS in preparation</option><option selected>URS ready, requesting proposals</option><option>Replacing or expanding an existing system</option></select></div>
        <div class="aq-field"><label class="aq-field__label" for="ef-cap"><span class="aq-form__ref" aria-hidden="true">1.2</span>Required capacity</label><div class="aq-field__suffix"><input class="aq-field__input" id="ef-cap" name="required-capacity" inputmode="numeric" value="2,500" required aria-describedby="ef-cap-help"><span class="aq-field__unit">L/h</span></div><p class="aq-field__help" id="ef-cap-help">Peak demand at points of use.</p></div>
        <fieldset class="aq-fieldset aq-field aq-form__full"><legend class="aq-field__label"><span class="aq-form__ref" aria-hidden="true">1.3</span>Systems in scope</legend>
          <div class="aq-checks"><label><input type="checkbox" id="ef-pw" name="systems-in-scope" value="Purified Water (PW) generation" checked> Purified Water (PW) generation</label><label><input type="checkbox" id="ef-loop" name="systems-in-scope" value="Storage and distribution loop" checked> Storage and distribution loop</label><label><input type="checkbox" id="ef-pre" name="systems-in-scope" value="Pretreatment"> Pretreatment</label><label><input type="checkbox" id="ef-mon" name="systems-in-scope" value="Monitoring and controls"> Monitoring and controls</label></div>
        </fieldset>
        <div class="aq-field"><label class="aq-field__label" for="ef-pou"><span class="aq-form__ref" aria-hidden="true">1.4</span>Number of points of use <span class="aq-field__optional">(optional)</span></label><input class="aq-field__input" id="ef-pou" name="number-of-points-of-use" inputmode="numeric" value="14"></div>
        <div class="aq-field"><label class="aq-field__label" for="ef-date"><span class="aq-form__ref" aria-hidden="true">1.5</span>Target date for water on site <span class="aq-field__optional">(optional)</span></label><input class="aq-field__input" id="ef-date" name="target-date-for-water-on-site" placeholder="e.g. March 2027" aria-describedby="ef-date-help"><p class="aq-field__help" id="ef-date-help">Month and year.</p></div>
        <div class="aq-field aq-form__full"><label class="aq-field__label" for="ef-msg"><span class="aq-form__ref" aria-hidden="true">1.6</span>Anything else we should know <span class="aq-field__optional">(optional)</span></label><textarea class="aq-field__input" id="ef-msg" name="anything-else-we-should-know"></textarea></div>
      </div>
    </fieldset>
    <fieldset class="aq-form__section">
      <legend class="aq-form__legend"><span class="aq-form__num">2.0</span> Site and contact</legend>
      <div class="aq-form__grid">
        <div class="aq-field"><label class="aq-field__label" for="ef-name"><span class="aq-form__ref" aria-hidden="true">2.1</span>Full name</label><input class="aq-field__input" id="ef-name" name="full-name" required></div>
        <div class="aq-field"><label class="aq-field__label" for="ef-company"><span class="aq-form__ref" aria-hidden="true">2.2</span>Company</label><input class="aq-field__input" id="ef-company" name="company" placeholder="e.g. Northfield Biologics" required></div>
        <div class="aq-field"><label class="aq-field__label" for="ef-email"><span class="aq-form__ref" aria-hidden="true">2.3</span>Email</label><input class="aq-field__input" id="ef-email" name="email" type="email" autocomplete="email" required></div>
        <div class="aq-field"><label class="aq-field__label" for="ef-site"><span class="aq-form__ref" aria-hidden="true">2.4</span>Site province or state</label><input class="aq-field__input" id="ef-site" name="site-province-or-state" required></div>
      </div>
    </fieldset>
    <div class="aq-form__actions"><button class="aq-btn aq-btn--primary aq-form__submit" type="submit">Request a proposal</button><span class="aq-small" role="status">An engineer replies in writing within <span class="aq-ph">[proposal response time, working days]</span>.</span></div>
  </form>
  <h2 class="aq-h1">Send what you have</h2>
  <form class="aq-form aq-form--steps wform" novalidate onsubmit="event.preventDefault()"><p class="aq-form__title"><span>Data sheet</span><span>3 steps · <span class="wform-req">7 required</span></span></p><ol class="aq-form__progress"><li aria-current="step">Your request</li><li>Details</li><li>Contact</li></ol><fieldset class="aq-form__section aq-form__step" data-step="0"><legend class="aq-form__legend"><span class="aq-form__num">1.0</span> Step 1 of 3: Your request</legend><div class="aq-form__grid"><fieldset class="aq-fieldset aq-field aq-form__full" data-required=""><legend class="aq-field__label"><span class="aq-form__ref" aria-hidden="true">1.1</span>Where are you starting from?</legend><div class="aq-checks"><label><input type="radio" id="wf0_0" name="where-are-you-starting-from" value="I have a URS or a draft"> I have a URS or a draft</label><label><input type="radio" id="wf0_1" name="where-are-you-starting-from" value="I know my product, not my water spec"> I know my product, not my water spec</label><label><input type="radio" id="wf0_2" name="where-are-you-starting-from" value="I have water data, no system yet"> I have water data, no system yet</label><label><input type="radio" id="wf0_3" name="where-are-you-starting-from" value="I have a system already"> I have a system already</label><label><input type="radio" id="wf0_4" name="where-are-you-starting-from" value="I am qualifying suppliers" checked> I am qualifying suppliers</label><label><input type="radio" id="wf0_5" name="where-are-you-starting-from" value="Not sure yet: talk to an engineer"> Not sure yet: talk to an engineer</label></div></fieldset><fieldset class="aq-fieldset aq-field aq-form__full" data-when="I have a URS or a draft" hidden aria-describedby="wf1_help" data-required=""><legend class="aq-field__label"><span class="aq-form__ref" aria-hidden="true">1.2</span>What do you need?</legend><div class="aq-checks"><label><input type="radio" id="wf1_0" name="what-do-you-need" value="URS gap review"> URS gap review</label><label><input type="radio" id="wf1_1" name="what-do-you-need" value="Compliance matrix"> Compliance matrix</label><label><input type="radio" id="wf1_2" name="what-do-you-need" value="Proposal against your URS"> Proposal against your URS</label><label><input type="radio" id="wf1_3" name="what-do-you-need" value="Review of another document"> Review of another document</label></div><p class="aq-field__help" id="wf1_help">A gap review marks each gap; a compliance matrix shows how each line is met.</p></fieldset><div class="aq-form__elsewhere aq-form__full" data-when="I am qualifying suppliers"><p class="aq-form__elsewhere-t">Supplier audits and questionnaire packs have their own request on Quality management.</p><a class="aq-btn aq-btn--link" href="#cmp-quality#audit" data-wp="cmp-quality#audit">Request a supplier audit <span class="aq-btn__arrow">→</span></a></div></div><div class="aq-form__actions"><button class="aq-btn aq-btn--primary" type="button" data-step-go="1">Continue to the details <span class="aq-btn__arrow">→</span></button></div></fieldset><fieldset class="aq-form__section aq-form__step" data-step="1" hidden><legend class="aq-form__legend"><span class="aq-form__num">2.0</span> Step 2 of 3: Details</legend><div class="aq-form__grid"><fieldset class="aq-fieldset aq-field aq-form__full" data-required=""><legend class="aq-field__label"><span class="aq-form__ref" aria-hidden="true">2.1</span>What do you make?</legend><div class="aq-checks"><label><input type="radio" id="wf3_0" name="what-do-you-make" value="Pharmaceutical drug products"> Pharmaceutical drug products</label><label><input type="radio" id="wf3_1" name="what-do-you-make" value="CDMO or contract manufacturing"> CDMO or contract manufacturing</label><label><input type="radio" id="wf3_2" name="what-do-you-make" value="Medical devices"> Medical devices</label><label><input type="radio" id="wf3_3" name="what-do-you-make" value="Natural health products"> Natural health products</label><label><input type="radio" id="wf3_4" name="what-do-you-make" value="Cosmetics or personal care"> Cosmetics or personal care</label><label><input type="radio" id="wf3_5" name="what-do-you-make" value="Hospital reprocessing, laboratory or industrial water"> Hospital reprocessing, laboratory or industrial water</label><label><input type="radio" id="wf3_6" name="what-do-you-make" value="Another industry"> Another industry</label></div></fieldset></div><div class="aq-form__actions"><button class="aq-btn aq-btn--secondary" type="button" data-step-go="0">Back</button><button class="aq-btn aq-btn--primary" type="button" data-step-go="2">Continue to contact details <span class="aq-btn__arrow">→</span></button></div></fieldset><fieldset class="aq-form__section aq-form__step" data-step="2" hidden><legend class="aq-form__legend"><span class="aq-form__num">3.0</span> Step 3 of 3: Contact</legend><div class="aq-form__grid"><div class="aq-field"><label class="aq-field__label" for="wf4"><span class="aq-form__ref" aria-hidden="true">3.1</span>Full name</label><input class="aq-field__input" id="wf4" name="full-name" type="text" required></div><div class="aq-field"><label class="aq-field__label" for="wf5"><span class="aq-form__ref" aria-hidden="true">3.2</span>Work email</label><input class="aq-field__input" id="wf5" name="work-email" type="email" autocomplete="email" required></div><div class="aq-field"><label class="aq-field__label" for="wf6"><span class="aq-form__ref" aria-hidden="true">3.3</span>Company</label><input class="aq-field__input" id="wf6" name="company" type="text" required></div><div class="aq-field"><label class="aq-field__label" for="wf7"><span class="aq-form__ref" aria-hidden="true">3.4</span>Role</label><select class="aq-field__input" id="wf7" name="role" required><option value="">Choose…</option><option>Owner or general management</option><option>Process or project engineering</option><option>Production or operations</option><option>Quality</option><option>Validation</option><option>Facilities or maintenance</option><option>Procurement</option><option>Finance</option><option>Consultant acting for a client</option><option>Other</option></select></div><div class="aq-field"><label class="aq-field__label" for="wf8"><span class="aq-form__ref" aria-hidden="true">3.5</span>Site province, state or country</label><input class="aq-field__input" id="wf8" name="site-province-state-or-country" type="text" required aria-describedby="wf8_help"><p class="aq-field__help" id="wf8_help">Sets pressure-equipment registration and service coverage.</p></div></div><div class="aq-form__actions"><button class="aq-btn aq-btn--secondary" type="button" data-step-go="1">Back</button><button class="aq-btn aq-btn--primary aq-form__submit" type="submit">Send to an engineer</button></div><span class="aq-small wform-msg" role="status"></span></fieldset></form>
</div></section></div>
