<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Page history</title>
<meta name="robots" content="noindex">
<link rel="icon" href="brand/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@300;400;500&display=swap">
<link rel="stylesheet" href="design-system/tokens.css">
<style>
/* Page history viewer. Draft tooling, tokens only. */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body { background: var(--surface-sunken); color: var(--ink); font-family: var(--font-sans); display: flex; flex-direction: column; }
[hidden] { display: none !important; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.vh-bar { background: var(--surface); border-bottom: 1px solid var(--line); padding: var(--space-3) var(--space-4); display: grid; gap: var(--space-3); }
.vh-row { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; }
.vh-title { font: 300 20px/26px var(--font-sans); margin: 0; }
.vh-title a { color: inherit; text-decoration: none; }
.vh-ctl { display: flex; gap: var(--space-2); align-items: center; font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
.vh-ctl select, .vh-btn { font: 400 13px/18px var(--font-mono); color: var(--ink); background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 6px 10px; min-height: 36px; }
.vh-btn { cursor: pointer; }
.vh-btn[aria-pressed="true"] { background: var(--ink); color: var(--surface); border-color: var(--ink); }
.vh-btn:disabled { opacity: 0.4; cursor: default; }
.vh-sp { flex: 1; }
.vh-link { font: 400 12px/18px var(--font-mono); color: var(--flow); }
.vh-tl { display: flex; overflow-x: auto; scrollbar-width: thin; }
.vh-v { flex: 1 0 120px; text-align: left; cursor: pointer; background: none; border: 0; border-top: 3px solid var(--line); padding: var(--space-2) var(--space-3) var(--space-1) 0; color: var(--ink-muted); font: inherit; }
.vh-v b { display: block; font: 400 13px/18px var(--font-sans); color: var(--ink); }
.vh-v small { font: 400 11px/16px var(--font-mono); }
.vh-v:hover { border-top-color: var(--line-strong); }
.vh-v[aria-current="true"] { border-top-color: var(--flow); }
.vh-v[aria-current="true"] b { font-weight: 500; }
.vh-scrub { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-3); align-items: center; }
.vh-scrub input[type=range] { width: 100%; accent-color: var(--flow); }
.vh-ticks { position: relative; height: 6px; margin: -4px 0 0; grid-column: 2; }
.vh-ticks i { position: absolute; top: 0; width: 1px; height: 6px; background: var(--line-strong); }
.vh-ticks i.is-page { background: var(--flow); width: 2px; }
.vh-ticks i.is-cp { height: 6px; background: var(--ink); width: 2px; }
.vh-meta { font: 400 13px/20px var(--font-sans); color: var(--ink-muted); margin: 0; }
.vh-meta code { font: 400 12px/18px var(--font-mono); color: var(--ink); }
.vh-tag { display: inline-block; font: 400 11px/16px var(--font-mono); padding: 0 6px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--ink); margin-right: 4px; }
.vh-tag.is-on { border-color: var(--flow); color: var(--flow); }
.vh-stage { flex: 1; display: flex; gap: var(--space-2); padding: var(--space-2); min-height: 0; justify-content: center; }
.vh-pane { flex: 1; display: flex; flex-direction: column; min-width: 0; max-width: 100%; }
.vh-pane > span { font: 400 11px/16px var(--font-mono); color: var(--ink-muted); padding: 0 0 var(--space-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vh-pane iframe { flex: 1; width: 100%; border: 1px solid var(--line); background: var(--surface); border-radius: var(--radius-sm); }
.is-phone .vh-pane { flex: 0 1 392px; }
.vh-keys { font: 400 11px/16px var(--font-mono); color: var(--ink-muted); }
@media (max-width: 760px) {
 .vh-keys, .vh-cmp { display: none; }
 .vh-stage { padding: 0; }
 .vh-pane iframe { border-radius: 0; border-width: 1px 0 0; }
}
</style>
</head>
<body>
<header class="vh-bar">
 <div class="vh-row">
  <h1 class="vh-title"><a href="index.html">Aquemi</a> · page history</h1>
  <label class="vh-ctl">Page <select id="vpage"></select></label>
  <span class="vh-ctl" role="group" aria-label="Width">
   <button class="vh-btn" id="vdesk" aria-pressed="true">Desktop</button><button class="vh-btn" id="vphone" aria-pressed="false">Phone</button>
  </span>
  <button class="vh-btn vh-cmp" id="vcmp" aria-pressed="false" title="Show this version next to the live site; Shift-click a checkpoint to change the right side">Compare</button>
  <span class="vh-sp"></span>
  <a class="vh-link" id="vopen" href="index.html" target="_blank" rel="noopener">Open this version ↗</a>
 </div>
 <nav class="vh-tl" id="vtl" aria-label="Big checkpoints"></nav>
 <div class="vh-scrub">
  <button class="vh-btn" id="vprev" aria-label="Previous commit">←</button>
  <input type="range" id="vrange" min="0" value="0" aria-label="Every commit on main">
  <button class="vh-btn" id="vnext" aria-label="Next commit">→</button>
  <div class="vh-ticks" id="vticks" aria-hidden="true"></div>
 </div>
 <div class="vh-row">
  <p class="vh-meta" id="vmeta"></p>
  <span class="vh-sp"></span>
  <label class="vh-ctl"><input type="checkbox" id="vonly" checked> Step only through changes to this page</label>
  <span class="vh-keys">← → step</span>
 </div>
</header>
<main class="vh-stage" id="vstage">
 <div class="vh-pane"><span id="vlabA"></span><iframe id="vfa" title="Selected version"></iframe></div>
 <div class="vh-pane" id="vpb" hidden><span id="vlabB"></span><iframe id="vfb" title="Compared version"></iframe></div>
</main>
<script>
(function(){
var $=function(id){return document.getElementById(id)};
// C: every commit oldest first, then the live site as 'now'. S: what is on screen (kept in the hash).
var NOSW=false,C=[],PAGES=[],S={page:'home',v:'now',b:null,w:'desk',only:'1'};
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function idx(id){for(var i=0;i<C.length;i++)if(C[i].c===id)return i;return C.length-1}
function when(d){var t=new Date(d);return t.toLocaleDateString('en-GB',{day:'numeric',month:'short'})+' '+t.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}
// Without a service worker (some embedded or private browsers) old versions come straight from GitHub.
function src(i){return C[i].c==='now'?'index.html':NOSW?'https://raw.githack.com/Aquemi-Official/aquemi-web/'+C[i].h+'/index.html':'versions/at/'+C[i].c+'/index.html'}
function readHash(){location.hash.slice(1).split('&').forEach(function(kv){var p=kv.split('=');if(p[0]&&p[1]!==undefined)S[p[0]]=decodeURIComponent(p[1])});if(!S.b)S.b=null}
function writeHash(){var h='page='+S.page+'&v='+S.v+(S.b?'&b='+S.b:'')+(S.w==='phone'?'&w=phone':'')+(S.only==='0'?'&only=0':'');try{history.replaceState(null,'','#'+h)}catch(x){}}

// What changed for this page at commit i: its copy, the shared design, or nothing.
function change(i,page){if(i===0)return {copy:true,design:true};var a=C[i-1],b=C[i];
 return {copy:(a.pages||{})[page]!==(b.pages||{})[page],design:a.design!==b.design}}
function touches(i){var ch=change(i,S.page);return ch.copy||ch.design}
function cpOf(i){for(var j=i;j>=0;j--)if(C[j].title)return j;return -1}

// The frame's own draft bar is hidden: this bar does its job.
function tidy(f){try{var d=f.contentDocument;if(!d||d.getElementById('vh-tidy'))return;var s=d.createElement('style');s.id='vh-tidy';s.textContent='.draftbar{display:none!important}';(d.head||d.documentElement).appendChild(s)}catch(x){}}
function ratio(f){try{var w=f.contentWindow,d=w.document.documentElement,m=d.scrollHeight-w.innerHeight;return m>0?w.scrollY/m:0}catch(x){return 0}}
function restore(f,r){if(!r)return;var t0=Date.now();(function go(){try{var w=f.contentWindow,d=w.document.documentElement,m=d.scrollHeight-w.innerHeight;if(m>w.innerHeight||Date.now()-t0>2500){w.scrollTo(0,r*m);return}}catch(x){return}setTimeout(go,120)})()}
var syncing=false;
function hook(f,other){try{var w=f.contentWindow;
 w.addEventListener('hashchange',function(){var h=w.location.hash.slice(1);if(h&&h!==S.page&&PAGES.indexOf(h)>=0){S.page=h;$('vpage').value=h;show(false,true)}});
 w.addEventListener('scroll',function(){if(syncing||$('vpb').hidden)return;syncing=true;var r=ratio(f),o=$(other).contentWindow;try{var d=o.document.documentElement;o.scrollTo(0,r*(d.scrollHeight-o.innerHeight))}catch(x){}requestAnimationFrame(function(){syncing=false})},{passive:true});
 w.document.addEventListener('keydown',keys);
}catch(x){}}
function load(f,i,keep){var r=keep?ratio(f):0,u=src(i)+'#'+S.page;
 f.onload=function(){tidy(f);hook(f,f.id==='vfa'?'vfb':'vfa');restore(f,r)};
 if(f.getAttribute('src')!==u)f.setAttribute('src',u)}
function label(i){var c=C[i];return (c.title||c.subject)+' · '+when(c.date)+(c.c==='now'?' · live':' · '+c.c)}

function ticks(){var n=C.length-1;$('vticks').innerHTML=C.map(function(c,i){var cls=c.title?'is-cp':(touches(i)&&change(i,S.page).copy?'is-page':'');return cls?'<i class="'+cls+'" style="left:calc('+(n?i/n*100:0)+'% - 1px)"></i>':''}).join('')}
function show(keep,fromFrame){
 var i=idx(S.v),c=C[i],ch=change(i,S.page),cp=cpOf(i);
 Array.prototype.forEach.call($('vtl').children,function(b){b.setAttribute('aria-current',+b.dataset.i===cp?'true':'false')});
 $('vrange').value=i;
 $('vmeta').innerHTML='<span class="vh-tag'+(ch.copy?' is-on':'')+'">'+(ch.copy?'copy changed':'copy same')+'</span><span class="vh-tag'+(ch.design?' is-on':'')+'">'+(ch.design?'design changed':'design same')+'</span> '+
  (i+1)+' of '+C.length+' · '+esc(when(c.date))+' · '+esc(c.author||'')+' · <code>'+esc(c.c==='now'?'live site':c.c)+'</code> '+esc(c.subject)+(c.note?'<br>'+esc(c.note):'')+(NOSW?'<br>This browser does not allow the history service worker, so old versions load from GitHub through raw.githack.com.':'');
 $('vopen').href=src(i)+'#'+S.page;
 $('vlabA').textContent=label(i);
 $('vpb').hidden=!S.b;$('vcmp').setAttribute('aria-pressed',S.b?'true':'false');
 if(S.b)$('vlabB').textContent=label(idx(S.b));
 $('vstage').classList.toggle('is-phone',S.w==='phone');
 $('vdesk').setAttribute('aria-pressed',S.w!=='phone'?'true':'false');$('vphone').setAttribute('aria-pressed',S.w==='phone'?'true':'false');
 $('vonly').checked=S.only!=='0';
 $('vprev').disabled=next(-1)===i;$('vnext').disabled=next(1)===i;
 ticks();
 if(!fromFrame)load($('vfa'),i,keep);
 if(S.b)load($('vfb'),idx(S.b),keep);
 writeHash();
}
function next(d){var i=idx(S.v),j=i+d;while(j>=0&&j<C.length){if(S.only==='0'||C[j].c==='now'||C[j].title||touches(j))return j;j+=d}return i}
function step(d){var j=next(d);if(j!==idx(S.v)){S.v=C[j].c;show(true)}}
function keys(ev){var t=ev.target.tagName;if(t==='SELECT'||t==='INPUT'||t==='TEXTAREA'||ev.altKey||ev.ctrlKey||ev.metaKey)return;if(ev.key==='ArrowLeft'){step(-1);ev.preventDefault()}else if(ev.key==='ArrowRight'){step(1);ev.preventDefault()}}

function start(){
 Promise.all([fetch('versions/index.json').then(function(r){return r.json()}),fetch('content/pages.json').then(function(r){return r.json()})]).then(function(d){
  C=d[0].commits;var last=C[C.length-1];
  C.push({c:'now',date:new Date().toISOString(),author:'',subject:'The site as it is now',title:null,design:last.design,pages:last.pages});
  var pages=d[1].pages||d[1],L=d[0].labels||{},live={};
  pages.forEach(function(p){live[p.id]=1;L[p.id]=p.section+' · '+p.nav_label});
  // the live site may be ahead of the last stored commit
  C[C.length-1].pages={};pages.forEach(function(p){C[C.length-1].pages[p.id]=(last.pages||{})[p.id]});
  // every page that ever existed: live ones first, then retired ones (they open in the versions that had them)
  PAGES=pages.map(function(p){return p.id});var gone=Object.keys(L).filter(function(id){return !live[id]});
  $('vpage').innerHTML=PAGES.map(function(id){return '<option value="'+esc(id)+'">'+esc(L[id])+'</option>'}).join('')+
   (gone.length?'<optgroup label="Retired pages">'+gone.map(function(id){return '<option value="'+esc(id)+'">'+esc(L[id])+'</option>'}).join('')+'</optgroup>':'');
  PAGES=PAGES.concat(gone);
  $('vtl').innerHTML=C.map(function(c,i){return c.title?'<button class="vh-v" data-i="'+i+'" title="'+esc(c.note)+'"><small>'+esc(when(c.date))+' · '+esc(c.c)+'</small><b>'+esc(c.title)+'</b></button>':''}).join('')+
   '<button class="vh-v" data-i="'+(C.length-1)+'" title="The site as it is now"><small>live</small><b>Now</b></button>';
  $('vrange').max=C.length-1;
  readHash();if(PAGES.indexOf(S.page)<0)S.page=PAGES[0];S.v=C[idx(S.v)].c;if(S.b)S.b=C[idx(S.b)].c;
  $('vpage').value=S.page;
  $('vtl').onclick=function(ev){var b=ev.target.closest('.vh-v');if(!b)return;var c=C[+b.dataset.i].c;if(ev.shiftKey&&S.b)S.b=c;else S.v=c;show(true)};
  $('vrange').oninput=function(){S.v=C[+this.value].c;show(true)};
  $('vprev').onclick=function(){step(-1)};$('vnext').onclick=function(){step(1)};
  $('vonly').onchange=function(){S.only=this.checked?'1':'0';show(true)};
  $('vpage').onchange=function(){S.page=this.value;show(false)};
  $('vcmp').onclick=function(){S.b=S.b?null:(S.v==='now'?C[cpOf(C.length-2)].c:'now');show(true)};
  $('vdesk').onclick=function(){S.w='desk';show(true)};$('vphone').onclick=function(){S.w='phone';show(true)};
  document.addEventListener('keydown',keys);
  show(false);
 }).catch(function(err){$('vmeta').textContent='The history could not load: '+err.message});
}
// Old versions are served by a service worker; it must be active before the first frame loads.
// (serviceWorker.ready never settles here: this page is outside the worker's scope, so wait on the worker itself.)
function active(reg){return new Promise(function(ok,no){var w=reg.active||reg.waiting||reg.installing;if(!w)return no(new Error('no worker'));if(w.state==='activated')return ok();
 w.addEventListener('statechange',function(){if(w.state==='activated')ok();else if(w.state==='redundant')no(new Error('redundant'))});setTimeout(function(){no(new Error('timeout'))},8000)})}
if('serviceWorker' in navigator){navigator.serviceWorker.register('versions/sw.js').then(active).then(start,function(){NOSW=true;start()})}
else{NOSW=true;start()}
})();
</script>
</body>
</html>
