/* ---------- MembraneAtlas: feed conditions as a numbered table, each row headed by a navy numeral tile ---------- */
/* Four columns: the navy tile (huge light slash numeral over a soft micrograph), then condition, effect and design.
   Column names sit over a heavy rule; hairlines between rows. */
.aq-membrane-atlas-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; max-width: 24ch; }
.aq-membrane-atlas { --ma-tile: calc(var(--space-32) + var(--space-12)); }
.aq-membrane-atlas__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-membrane-atlas__tr { display: grid; grid-template-columns: var(--ma-tile, var(--space-32)) repeat(3, minmax(0, 1fr)); }
.aq-membrane-atlas__thead .aq-membrane-atlas__tr { border-bottom: 2px solid var(--navy); }
.aq-membrane-atlas__th { padding: 0 var(--space-6) var(--space-3); font: 400 16px/22px var(--font-sans); color: var(--ink-muted); }
.aq-membrane-atlas__plate { border-bottom: 1px solid var(--line-strong); }
.aq-membrane-atlas__td { padding: var(--space-4) var(--space-6) var(--space-6); border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.aq-membrane-atlas__k { display: none; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-membrane-atlas__t { font: 300 24px/30px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-membrane-atlas__c { font: 400 16px/24px var(--font-sans); color: var(--ink-muted); }
.aq-membrane-atlas__td--ours .aq-membrane-atlas__c { color: var(--ink); }

/* The tile: navy square, the numeral top-left, the micrograph soft behind it at the lower right */
.aq-membrane-atlas__tile { position: relative; overflow: hidden; background: var(--navy); color: var(--on-navy); min-height: calc(var(--ma-tile, var(--space-32)) * 0.8); }
.aq-membrane-atlas__n { position: absolute; left: var(--space-4); top: var(--space-3); z-index: 1; font: 300 72px/1 var(--font-sans); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; color: var(--on-navy); }
.aq-membrane-atlas__sl { color: var(--on-navy-muted); margin-left: 0.02em; }
.aq-membrane-atlas__scope { position: absolute; right: calc(-1 * var(--space-8)); bottom: calc(-1 * var(--space-8)); width: calc(var(--ma-tile, var(--space-32)) * 0.95); aspect-ratio: 1; }
.aq-membrane-atlas__scope > .aq-membrane-atlas__svg { opacity: 0.55; filter: blur(1.4px); }
.aq-membrane-atlas__plate:hover .aq-membrane-atlas__sl, .aq-membrane-atlas__plate:focus-within .aq-membrane-atlas__sl { color: var(--limestone); }

/* The micrograph, drawn in navy-ground inks */
.aq-membrane-atlas__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-membrane-atlas__svg * { vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.aq-membrane-atlas__field { fill: color-mix(in srgb, var(--navy) 85%, var(--on-navy)); }
.aq-membrane-atlas__rim { fill: none; stroke: var(--on-navy); stroke-width: 1.5; }
.aq-membrane-atlas__tick, .aq-membrane-atlas__cross { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; }
.aq-membrane-atlas__tex { fill: none; stroke: var(--on-navy-muted); stroke-width: 0.75; opacity: 0.38; }
.aq-membrane-atlas__hole { fill: var(--on-navy); stroke: var(--on-navy); stroke-width: 1; }
.aq-membrane-atlas__crack { fill: none; stroke: var(--on-navy); stroke-width: 1; }
.aq-membrane-atlas__split { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 3 3; }
.aq-membrane-atlas__perm { fill: none; stroke: var(--limestone); stroke-width: 1.5; }
.aq-membrane-atlas__dot { fill: var(--limestone); }
.aq-membrane-atlas__rod { fill: color-mix(in srgb, var(--navy) 85%, var(--on-navy)); stroke: var(--on-navy); stroke-width: 1; }
.aq-membrane-atlas__cake { fill: none; stroke: var(--on-navy-muted); stroke-width: 0.9; }
.aq-membrane-atlas__cake--fill { fill: var(--on-navy-muted); }
.aq-membrane-atlas__xtal { fill: color-mix(in srgb, var(--navy) 70%, var(--on-navy)); stroke: var(--on-navy); stroke-width: 1; }
.aq-membrane-atlas__glass { fill: color-mix(in srgb, var(--navy) 70%, var(--on-navy)); stroke: var(--on-navy); stroke-width: 1; }
.aq-membrane-atlas__glint { fill: none; stroke: var(--on-navy-muted); stroke-width: 0.75; }
.aq-membrane-atlas__rust { fill: var(--on-navy-muted); }
.aq-membrane-atlas__eps { fill: color-mix(in srgb, var(--navy) 70%, var(--on-navy)); stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 2 2; }


/* The scope's lens (added by motion.js): a sharp copy of the micrograph shows through a ring that follows the pointer */
.aq-membrane-atlas__lens { position: absolute; inset: 0; pointer-events: none; clip-path: inset(50%); transition: clip-path 150ms cubic-bezier(0.2, 0, 0, 1); }
.aq-membrane-atlas__lens.is-on { clip-path: inset(0); }
.aq-membrane-atlas__lens > .aq-membrane-atlas__svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.aq-membrane-atlas__ring { position: absolute; left: 0; top: 0; width: var(--space-24); height: var(--space-24); margin: calc(-1 * var(--space-12)) 0 0 calc(-1 * var(--space-12)); border: 1px solid var(--limestone); border-radius: var(--radius-pill); pointer-events: none; }

/* Desktop shows every row; the fold is for phones */
.aq-fold:not(.is-open) .aq-membrane-atlas__plate.aq-fold-x { display: grid; }
.aq-fold:has(> .aq-membrane-atlas) > .aq-fold__btn { display: none; }

@container (max-width: 1100px) {
  .aq-membrane-atlas { --ma-tile: calc(var(--space-24) + var(--space-8)); }
  .aq-membrane-atlas__n { font-size: 56px; }
  .aq-membrane-atlas__td { padding: var(--space-4); }
  .aq-membrane-atlas__t { font-size: 20px; line-height: 26px; }
  .aq-membrane-atlas__c { font-size: 14px; line-height: 22px; }
}
/* Phones: the tile becomes a band over its row (numeral left, micrograph right), the cells stack under their names */
@container (max-width: 860px) {
  .aq-membrane-atlas-sec .aq-sec-head .aq-h1 { font-size: 36px; line-height: 42px; }
  .aq-membrane-atlas__thead { display: none; }
  .aq-membrane-atlas__tr { grid-template-columns: minmax(0, 1fr); }
  .aq-membrane-atlas__plate { padding-bottom: var(--space-4); }
  .aq-membrane-atlas__tile { min-height: var(--space-24); }
  .aq-membrane-atlas__n { font-size: 56px; top: var(--space-4); }
  .aq-membrane-atlas__scope { width: var(--space-32); right: calc(-1 * var(--space-4)); bottom: auto; top: calc(-1 * var(--space-4)); }
  .aq-membrane-atlas__td { border-left: 0; padding: var(--space-3) 0 0; gap: var(--space-1); }
  .aq-membrane-atlas__k { display: block; }
  .aq-fold:not(.is-open) .aq-membrane-atlas__plate.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-membrane-atlas) > .aq-fold__btn { display: flex; }
}
