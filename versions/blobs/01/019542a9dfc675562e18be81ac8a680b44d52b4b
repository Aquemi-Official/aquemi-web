<!-- @dsCard group="Forms" height=300 subtitle="Default, with unit, and error" -->
<div class="aq-root" style="padding:24px;display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
  <div class="aq-field">
    <label class="aq-field__label" for="tf-company">Company</label>
    <input class="aq-field__input" id="tf-company" placeholder="e.g. Northfield Biologics">
  </div>
  <div class="aq-field">
    <label class="aq-field__label" for="tf-cap">Required capacity</label>
    <div class="aq-field__suffix">
      <input class="aq-field__input" id="tf-cap" value="2,500" inputmode="numeric">
      <span class="aq-field__unit">L/h</span>
    </div>
    <p class="aq-field__help">Peak demand at points of use.</p>
  </div>
  <div class="aq-field is-error">
    <label class="aq-field__label" for="tf-temp">Loop temperature</label>
    <div class="aq-field__suffix">
      <input class="aq-field__input" id="tf-temp" value="140" aria-invalid="true" aria-describedby="tf-temp-help">
      <span class="aq-field__unit">°C</span>
    </div>
    <p class="aq-field__help" id="tf-temp-help">Enter a temperature between 4 and 95 °C.</p>
  </div>
</div>
