/* ---------- ProcessSteps: a real sequence as rows of the shared list grammar ---------- */
/* Layout from .aq-rows (base.css): index | step name | what happens. The index already carries the order, so a plain
   list has no pipe, spine or stair: hairlines between steps are the only structure. */
.aq-steps { min-width: 0; }

/* Hold points (.aq-steps--hold, items with hold): the steps become one routed line, a line-strong pipe through the index
   column from each index to the next, with a closed valve (flow) under the index of every hold step. The hold step
   carries a stamped card under its text, joined to its valve by a dashed flow branch: "Hold point" stamp, who signs, and a signature line. */
.aq-steps--hold > li { position: relative; }
.aq-steps--hold > li:not(:last-child)::before {
  content: ""; position: absolute; left: var(--space-2); width: 1px; z-index: 0;
  top: calc(var(--space-4) + 24px + var(--space-1)); bottom: calc(var(--space-1) - var(--space-4));
  background: var(--line-strong);
}
.aq-fold:not(.is-open) .aq-steps--hold > li:has(+ .aq-fold-x)::before { display: none; }
.aq-steps__gate { grid-column: 1 / 3; grid-row: 2; align-self: center; position: relative; z-index: 1; display: flex; align-items: center; margin: var(--space-3) calc(-1 * var(--space-6)) 0 0; line-height: 0; }
/* Branch: from the valve to the hold card, so the hold reads as a stop on the line */
.aq-steps__gate::after { content: ""; flex: 1; border-top: 1px dashed var(--flow); }
.aq-steps__valve { display: block; width: var(--space-4); height: var(--space-4); overflow: visible; }
.aq-steps__valve path:first-child { fill: var(--flow); stroke: var(--flow); stroke-width: 1.5; stroke-linejoin: round; }
.aq-steps__valve path + path { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-steps__hold {
  grid-column: 3; grid-row: 2; display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-4); row-gap: var(--space-3);
  max-width: var(--text-max); margin-top: var(--space-3); padding: var(--space-3) var(--space-4) var(--space-4);
  background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
}
.aq-steps__stamp {
  padding: 0 var(--space-2); border: 3px double var(--flow); border-radius: var(--radius-sm); transform: rotate(-2deg);
  font: 600 12px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--flow); white-space: nowrap;
}
.aq-steps__who { font: 500 14px/20px var(--font-sans); color: var(--ink); }
.aq-steps__sign { flex-basis: 100%; display: flex; align-items: baseline; gap: var(--space-2); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-steps__sign::after { content: ""; flex: 1; max-width: calc(var(--space-16) * 4); border-bottom: 1px solid var(--line-strong); }

@container (max-width: 860px) {
  .aq-steps--hold > li:not(:last-child)::before { top: calc(var(--space-3) + 24px + var(--space-1)); bottom: calc(var(--space-1) - var(--space-3)); }
  .aq-steps__gate { grid-column: 1; grid-row: 3; margin-right: calc(-1 * var(--space-3)); }
  .aq-steps__hold { grid-column: 2; grid-row: 3; margin-top: var(--space-2); padding: var(--space-3); column-gap: var(--space-3); }
}
